{# Zwei-Faktor-Anmeldung (docs/feature-admin-2fa.md) — Profilkarte, gesteuert von /js/profile-2fa.js #}
<div class="card tf-card" id="tf-card" data-enabled="{{ '1' if user.totp_enabled else '0' }}" data-username="{{ user.username }}" data-setup="{{ '1' if setup2fa else '0' }}">
  <div class="card-head">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
    <span class="card-title">{{ t('two_fa.title') }}</span>
    <span class="tf-status" id="tf-status"></span>
  </div>
  <div class="card-body tf-body">
    <div class="tf-banner tf-banner-amber" id="tf-required-banner" hidden>{{ t('two_fa.required_banner') }}</div>
    <div class="tf-hint">{{ t('two_fa.card_hint') }}</div>
    <div id="tf-message" style="display:none"></div>

    <div class="tf-panel" id="tf-panel-off">
      <button type="button" class="btn btn-primary" id="tf-btn-setup">{{ t('two_fa.setup') }}</button>
    </div>

    <div class="tf-panel" id="tf-panel-setup" hidden>
      <div class="tf-step">{{ t('two_fa.setup_step_scan') }}</div>
      <div class="tf-qr" id="tf-qr"></div>
      <div class="tf-secret-row">
        <span class="tf-label">{{ t('two_fa.secret_label') }}</span>
        <code class="tf-secret" id="tf-secret"></code>
        <button type="button" class="btn btn-ghost tf-btn-sm" id="tf-btn-copy-secret">{{ t('two_fa.copy') }}</button>
      </div>
      <div class="tf-step">{{ t('two_fa.setup_step_code') }}</div>
      <div class="tf-inline">
        <input type="text" class="tf-code-input" id="tf-confirm-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="123456">
        <button type="button" class="btn btn-primary" id="tf-btn-confirm">{{ t('two_fa.confirm') }}</button>
        <button type="button" class="btn btn-ghost" id="tf-btn-cancel-setup">{{ t('two_fa.cancel') }}</button>
      </div>
    </div>

    <div class="tf-panel" id="tf-panel-codes" hidden>
      <div class="tf-label">{{ t('two_fa.recovery_title') }}</div>
      <div class="tf-hint">{{ t('two_fa.recovery_hint') }}</div>
      <ol class="tf-codes" id="tf-codes"></ol>
      <div class="tf-inline">
        <button type="button" class="btn btn-ghost" id="tf-btn-copy-codes">{{ t('two_fa.copy') }}</button>
        <button type="button" class="btn btn-ghost" id="tf-btn-download-codes">{{ t('two_fa.download') }}</button>
        <button type="button" class="btn btn-primary" id="tf-btn-codes-done">{{ t('two_fa.done') }}</button>
      </div>
    </div>

    <div class="tf-panel" id="tf-panel-on" hidden>
      <div class="tf-hint tf-mono" id="tf-remaining"></div>
      <div class="tf-inline">
        <button type="button" class="btn btn-ghost" id="tf-btn-regenerate">{{ t('two_fa.regenerate') }}</button>
        <button type="button" class="btn btn-danger" id="tf-btn-disable">{{ t('two_fa.disable') }}</button>
      </div>
      <div class="tf-subform" id="tf-form-regenerate" hidden>
        <div class="tf-hint">{{ t('two_fa.regenerate_hint') }}</div>
        <div class="tf-inline">
          <input type="password" id="tf-regen-password" autocomplete="current-password" placeholder="{{ t('two_fa.password_label') }}">
          <button type="button" class="btn btn-primary" id="tf-btn-regenerate-confirm">{{ t('two_fa.regenerate') }}</button>
          <button type="button" class="btn btn-ghost" data-tf-cancel="tf-form-regenerate">{{ t('two_fa.cancel') }}</button>
        </div>
      </div>
      <div class="tf-subform" id="tf-form-disable" hidden>
        <div class="tf-hint">{{ t('two_fa.disable_hint') }}</div>
        <div class="tf-inline">
          <input type="password" id="tf-disable-password" autocomplete="current-password" placeholder="{{ t('two_fa.password_label') }}">
          <input type="text" class="tf-code-input" id="tf-disable-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="123456">
          <button type="button" class="btn btn-danger" id="tf-btn-disable-confirm">{{ t('two_fa.disable') }}</button>
          <button type="button" class="btn btn-ghost" data-tf-cancel="tf-form-disable">{{ t('two_fa.cancel') }}</button>
        </div>
      </div>
      <div class="tf-hint" id="tf-required-locked" hidden>{{ t('two_fa.required_locked') }}</div>
    </div>
  </div>
  <script type="application/json" id="tf-i18n">{
    "status_on": {{ t('two_fa.status_on') | dump | safe }},
    "status_off": {{ t('two_fa.status_off') | dump | safe }},
    "status_since": {{ t('two_fa.status_since') | dump | safe }},
    "recovery_remaining": {{ t('two_fa.recovery_remaining') | dump | safe }},
    "copied": {{ t('two_fa.copied') | dump | safe }},
    "copy": {{ t('two_fa.copy') | dump | safe }},
    "enabled_success": {{ t('two_fa.enabled_success') | dump | safe }},
    "disabled_success": {{ t('two_fa.disabled_success') | dump | safe }},
    "error_code_required": {{ t('two_fa.error_code_required') | dump | safe }},
    "download_filename": {{ t('two_fa.download_filename') | dump | safe }},
    "download_header": {{ t('two_fa.download_header') | dump | safe }},
    "error": {{ t('common.error') | dump | safe }}
  }</script>
</div>
