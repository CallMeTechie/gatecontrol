{% extends theme + "/layout.njk" %}

{#
  Domains & Routen (docs/feature-domain-zones.md): header with summary line,
  toolbar (search · type · status · risk · gateway; state in the URL hash),
  zone cards built by zones-page.js. Dialogs: "Host bearbeiten" / "Neuer Host"
  (host-dialogs.js), "Domain-Einstellungen" (domain-modal.js), entry editor
  (route-edit.njk + entry-editor.js).
#}

{% block content %}
{#
  Header: summary line (domains · hosts · entries · disabled — the former
  KPI strip), "Domain hinzufügen" (secondary) and "Neuer Host" (primary).
#}
<div class="page-header zn-page-header rt-page-head">
  <div class="rt-page-titles">
    <div class="page-eyebrow">{{ t('zones.eyebrow') }}</div>
    <h1 class="page-title">{{ t('zones.title') }}</h1>
    <p class="page-sub" id="zn-summary">{{ t('zones.summary_loading') }}</p>
  </div>
  <div class="page-actions rt-page-actions">
    <button type="button" class="btn btn-secondary rt-btn" id="zn-add-domain">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
      <span>{{ t('zones.add_domain') }}</span>
    </button>
    <button type="button" class="btn btn-primary rt-btn" id="zn-new-host">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" width="16" height="16" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      <span>{{ t('host.new') }}</span>
    </button>
  </div>
</div>

{# Toolbar: search · type · status · risk check (release B §9) · gateway.
   Filter state lives in the URL hash (zones-view.js filtersToHash). #}
<div class="toolbar zn-toolbar rt-toolbar" role="search">
  <div class="rt-search search-box zn-search">
    <label for="zn-search" class="rt-sr">{{ t('zones.search_label') }}</label>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" width="16" height="16"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input type="search" id="zn-search" placeholder="{{ t('zones.search_ph') }}" autocomplete="off">
  </div>
  <div class="rt-seg" id="zn-type" role="group" aria-label="{{ t('zones.filter_type') }}">
    <button type="button" class="rt-seg-btn" data-type="" aria-pressed="true">{{ t('zones.filter_all') }}</button>
    <button type="button" class="rt-seg-btn" data-type="http" aria-pressed="false">{{ t('zones.filter_https') }}</button>
    <button type="button" class="rt-seg-btn" data-type="l4" aria-pressed="false">{{ t('zones.filter_l4') }}</button>
  </div>
  <label class="rt-selectbox">
    <span>{{ t('zones.filter_status') }}</span>
    <select id="zn-status">
      <option value="">{{ t('zones.filter_status_all') }}</option>
      <option value="problem">{{ t('zones.filter_problems') }}</option>
      <option value="disabled">{{ t('zones.filter_disabled') }}</option>
      <option value="external">{{ t('zones.filter_external') }}</option>
      <option value="internal">{{ t('zones.filter_internal') }}</option>
    </select>
  </label>
  <label class="rt-selectbox sh-risk-select">
    <span>{{ t('zones.filter.risk_label') }}</span>
    <select id="zn-risk">
      <option value="">–</option>
      <option value="nowaf">{{ t('zones.filter.public_nowaf') }}</option>
      <option value="unprotected">{{ t('zones.filter.public_unprotected') }}</option>
      <option value="nohsts">{{ t('zones.filter.https_nohsts') }}</option>
    </select>
  </label>
  <label class="rt-selectbox" hidden>
    <span>{{ t('zones.gateway_label') }}</span>
    <select id="zn-gateway-filter" class="zn-gw-select">
      <option value="">{{ t('zones.gateway_filter_all') }}</option>
    </select>
  </label>
  <button type="button" class="rt-icon-btn" id="zn-collapse-all" aria-label="{{ t('zones.collapse_all') }}" title="{{ t('zones.collapse_all') }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
  </button>
</div>

<div class="zn-zones rt-zones" id="zn-zones" data-l4-blocked="{{ (l4BlockedPorts or []) | join(',') }}">
  <div class="zn-empty rt-empty-page">{{ t('common.loading') }}</div>
</div>

{# Bulk selection bar (zones-page.js; POST /api/v1/routes/bulk). Hidden until
   an entry is selected; sticks to the bottom of the viewport. #}
<div class="sh-bulkbar" id="zn-bulkbar" role="region" aria-label="{{ t('bulk.actions_label') }}" hidden>
  <span class="sh-bulk-count" id="zn-bulk-count" aria-live="polite"></span>
  <div class="sh-bulk-actions" id="zn-bulk-actions"></div>
</div>

{# The dialogs ("Host bearbeiten", "Neuer Host", "Domain-Einstellungen") are
   built by host-dialogs.js / domain-modal.js; the entry editor below stacks
   above them (z-index), small confirm dialogs above both. #}
{% include theme + "/partials/modals/route-edit.njk" %}
{% include theme + "/partials/modals/confirm.njk" %}

