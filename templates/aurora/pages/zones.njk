{% extends theme + "/layout.njk" %}

{#
  Domains & Routen — zone view, Aurora variant (docs/feature-domain-zones.md).
  Same element IDs as default/pro so zones-page.js / domain-modal.js need no
  theme branch; Aurora adds the KPI strip (#zn-kpis, filled by zones-page.js).
#}

{% block content %}
<div class="page-header zn-page-header">
  <div>
    <div class="page-eyebrow">{{ t('zones.eyebrow') }}</div>
    <h1 class="page-title">{{ t('zones.title') }}</h1>
    <p class="page-sub" id="zn-summary">{{ t('zones.summary_loading') }}</p>
  </div>
  <div class="page-actions">
    <a href="/routes/legacy" class="zn-legacy-link" id="zn-legacy-link" title="{{ t('zones.legacy_hint') }}">{{ t('zones.legacy_link') }}</a>
    <button type="button" class="btn btn-primary" id="zn-add-domain">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>{{ t('zones.add_domain') }}</span>
    </button>
  </div>
</div>

{# KPI strip: static container, filled by zones-page.js from the unfiltered data #}
<div class="aurora-routes-kpis zn-kpis" id="zn-kpis"></div>

<div class="toolbar zn-toolbar" role="search">
  <div class="search-box zn-search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" id="zn-search" placeholder="{{ t('zones.search_ph') }}" aria-label="{{ t('zones.search_label') }}" autocomplete="off">
  </div>
  <div class="filter-chips zn-chips" id="zn-chips" role="group" aria-label="{{ t('zones.filters_label') }}">
    <button type="button" class="filter-chip on" data-dim="all" aria-pressed="true">{{ t('zones.filter_all') }} · <span id="zn-chip-all-count">0</span></button>
    <button type="button" class="filter-chip" data-dim="type" data-value="http" aria-pressed="false">{{ t('zones.filter_https') }}</button>
    <button type="button" class="filter-chip" data-dim="type" data-value="l4" aria-pressed="false">{{ t('zones.filter_l4') }}</button>
    <span class="chip-sep" aria-hidden="true"></span>
    <button type="button" class="filter-chip" data-dim="access" data-value="external" aria-pressed="false">{{ t('zones.filter_external') }}</button>
    <button type="button" class="filter-chip" data-dim="access" data-value="internal" aria-pressed="false">{{ t('zones.filter_internal') }}</button>
    <button type="button" class="filter-chip" data-dim="state" data-value="disabled" aria-pressed="false">{{ t('zones.filter_disabled') }}</button>
    <button type="button" class="filter-chip" data-dim="state" data-value="problem" aria-pressed="false">{{ t('zones.filter_problems') }}</button>
  </div>
  <select class="sort-select zn-gw-select" id="zn-gateway-filter" aria-label="{{ t('zones.gateway_filter_label') }}">
    <option value="">{{ t('zones.gateway_filter_all') }}</option>
  </select>
  <button type="button" class="btn btn-ghost zn-btn-sm" id="zn-collapse-all">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
    <span class="zn-collapse-lbl">{{ t('zones.collapse_all') }}</span>
  </button>
</div>

<div class="zn-zones" id="zn-zones">
  <div class="zn-empty">{{ t('common.loading') }}</div>
</div>

{# Domain modal shell. Placed BEFORE the editor/confirm partials so the entry
   editor (opened from a host card) stacks above it. #}
<div class="modal-overlay" id="zn-domain-modal" style="display:none">
  <div class="modal zn-dm" role="dialog" aria-modal="true" aria-labelledby="zn-dm-title">
    <div class="modal-head zn-dm-head">
      <span class="modal-title" id="zn-dm-title">{{ t('zones.modal_title') }}</span>
      <span class="zn-dm-domain" id="zn-dm-domain"></span>
      <span class="zn-dm-tags" id="zn-dm-tags"></span>
      <span class="zn-dm-counts" id="zn-dm-counts"></span>
      <button type="button" class="modal-close zn-dm-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button>
    </div>
    <div class="modal-body zn-dm-body" id="zn-dm-body"></div>
    <div class="modal-foot zn-dm-foot">
      <span class="zn-dm-sync" id="zn-dm-sync"></span>
      <span class="zn-spacer"></span>
      <button type="button" class="btn btn-secondary" data-close-modal>{{ t('common.close') }}</button>
    </div>
  </div>
</div>

{% include theme + "/partials/modals/route-edit.njk" %}
{% include theme + "/partials/modals/confirm.njk" %}

