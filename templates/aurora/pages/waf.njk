{% extends theme + "/layout.njk" %}

{#
  Web Application Firewall (docs/feature-waf.md, "Oberfläche"), Aurora
  variant. Same ids as default/pro so waf.js needs no theme branch; Aurora
  keeps its KPI strip, the filter toolbar above the card, the .card.span12 +
  .data-table layout and the primary refresh button in .page-actions (like
  certificates.njk). Without the waf license only the locked notice renders.
#}

{% block content %}
<div class="page-header">
  <div>
    <div class="page-eyebrow">{{ t('nav.routing') }}</div>
    <div class="page-title">{{ t('nav.waf') }}</div>
    <div class="page-sub" id="wf-summary">{{ t('waf.page_sub') }}</div>
  </div>
  {% if license.features.waf %}
  <div class="page-actions">
    <button class="btn btn-primary" id="btn-waf-refresh" type="button">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
      <span>{{ t('common.refresh') }}</span>
    </button>
  </div>
  {% endif %}
</div>

{% if license.features.waf %}
{# KPI strip: static tiles, values filled by waf.js #}
<div class="aurora-routes-kpis wf-tiles" id="wf-tiles">
  <div class="aurora-routes-kpi wf-tile" id="wf-tile-events" data-action="all" role="button" tabindex="0"><b id="wf-tile-events-val">–</b><span>{{ t('waf.tile_events') }}</span></div>
  <div class="aurora-routes-kpi wf-tile" id="wf-tile-blocked" data-action="blocked" role="button" tabindex="0"><b id="wf-tile-blocked-val">–</b><span>{{ t('waf.tile_blocked') }}</span></div>
  <div class="aurora-routes-kpi wf-tile" id="wf-tile-routes" data-target="wf-routes-card" role="button" tabindex="0"><b id="wf-tile-routes-val">–</b><span>{{ t('waf.tile_routes') }}</span></div>
</div>

<div class="alert alert-warning wf-banner" id="wf-engine-banner" role="alert" hidden>
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="wf-ic" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
  <span>{{ t('waf.engine_missing') }}</span>
</div>

<div class="toolbar wf-toolbar">
  <div class="wf-filters" id="wf-filters" role="group" aria-label="{{ t('waf.filters_label') }}">
    <label class="wf-filter wf-filter-host"><span class="wf-f-label">{{ t('waf.filter_host') }}</span>
      <select class="form-select wf-host-select" id="wf-host"><option value="">{{ t('waf.filter_host_all') }}</option></select>
    </label>
    <div class="wf-filter"><span class="wf-f-label" id="wf-action-label">{{ t('waf.filter_action') }}</span>
      <div class="filter-chips wf-chips" id="wf-action-chips" role="group" aria-labelledby="wf-action-label">
        <button type="button" class="filter-chip on" data-action="all" aria-pressed="true">{{ t('waf.filter_all') }}</button>
        <button type="button" class="filter-chip" data-action="blocked" aria-pressed="false">{{ t('waf.filter_blocked') }}</button>
        <button type="button" class="filter-chip" data-action="detected" aria-pressed="false">{{ t('waf.filter_detected') }}</button>
      </div>
    </div>
    <div class="wf-filter"><span class="wf-f-label" id="wf-range-label">{{ t('waf.filter_range') }}</span>
      <div class="filter-chips wf-chips" id="wf-range-chips" role="group" aria-labelledby="wf-range-label">
        <button type="button" class="filter-chip on" data-range="24h" aria-pressed="true">{{ t('waf.range_24h') }}</button>
        <button type="button" class="filter-chip" data-range="7d" aria-pressed="false">{{ t('waf.range_7d') }}</button>
        <button type="button" class="filter-chip" data-range="30d" aria-pressed="false">{{ t('waf.range_30d') }}</button>
      </div>
    </div>
  </div>
</div>

<div class="card span12 wf-card" id="wf-events-card">
  <div class="card-head wf-card-head">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    <span class="card-title">{{ t('waf.events_title') }}</span>
    <button type="button" class="btn btn-ghost wf-new-events" id="wf-new-events" hidden>{{ t('waf.new_events') }}</button>
  </div>
  <div class="wf-table-wrap">
    <table class="data-table wf-table" id="wf-table">
      <thead>
        <tr>
          <th>{{ t('waf.col_time') }}</th>
          <th>{{ t('waf.col_host') }}</th>
          <th>{{ t('waf.col_action') }}</th>
          <th>{{ t('waf.col_rule') }}</th>
          <th>{{ t('waf.col_message') }}</th>
          <th>{{ t('waf.col_client') }}</th>
          <th>{{ t('waf.col_request') }}</th>
          <th>{{ t('waf.col_actions') }}</th>
        </tr>
      </thead>
      <tbody id="wf-events-list">
        <tr class="wf-empty"><td colspan="8">{{ t('common.loading') }}</td></tr>
      </tbody>
    </table>
  </div>
  <div class="wf-pager" id="wf-pager">
    <span class="wf-page-info" id="wf-page-info"></span>
    <button type="button" class="btn btn-ghost wf-more" id="wf-more" hidden>{{ t('waf.load_more') }}</button>
  </div>
</div>

<div class="card span12 wf-card wf-routes-card" id="wf-routes-card">
  <div class="card-head wf-card-head">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
    <span class="card-title">{{ t('waf.routes_title') }}</span>
  </div>
  <div class="wf-table-wrap">
    <table class="data-table wf-table wf-routes-table" id="wf-routes-table">
      <thead>
        <tr>
          <th>{{ t('waf.col_host') }}</th>
          <th>{{ t('waf.col_mode') }}</th>
          <th>{{ t('waf.col_paranoia') }}</th>
          <th>{{ t('waf.col_events_24h') }}</th>
          <th>{{ t('waf.col_blocked_24h') }}</th>
          <th>{{ t('waf.col_actions') }}</th>
        </tr>
      </thead>
      <tbody id="wf-routes-list">
        <tr class="wf-empty"><td colspan="6">{{ t('common.loading') }}</td></tr>
      </tbody>
    </table>
  </div>
</div>

{% include "partials/waf-i18n.njk" %}
{% else %}
<div class="card span12 wf-locked" id="wf-locked">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="wf-ic" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
  <div>
    <div class="wf-locked-title">{{ t('waf.locked_title') }}</div>
    <div class="wf-locked-text">{{ t('waf.locked') }}</div>
  </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
{% if license.features.waf %}
<script src="/js/waf-ui.js?v={{ appVersion }}"></script>
<script src="/js/waf.js?v={{ appVersion }}"></script>
{% endif %}
{% endblock %}
