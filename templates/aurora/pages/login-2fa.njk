<!DOCTYPE html>
<html lang="{{ language }}" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#f2f0eb">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title>{{ t('two_fa.login_title') }} — {{ appName }}</title>
  <script nonce="{{ cspNonce }}">
(function(){try{var s=localStorage.getItem('gc-theme-mode');var t=s||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();
</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/pro.css?v={{ appVersion }}">
  <link rel="stylesheet" href="/css/aurora.css?v={{ appVersion }}">
</head>
<body class="au-page">
  <main class="au-wrap">
    <div class="au-brand">
      <span class="mark"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m8.5 12 2.5 2.5L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="nm">{{ appName }}</span>
    </div>

    <div class="card au-card">
      <div class="page-eyebrow">{{ t('auth.login') }}</div>
      <h1 class="au-title">{{ t('two_fa.login_title') }}</h1>
      <p class="au-sub tf-intro">{% if useRecovery %}{{ t('two_fa.recovery_intro') }}{% else %}{{ t('two_fa.login_intro') }}{% endif %}</p>

      {% if flash.error %}
      <div class="login-error" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>{{ flash.error }}</span>
      </div>
      {% endif %}

      <form method="POST" action="/login/2fa" id="tf-login-form">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if useRecovery %}
        <div class="form-group">
          <label class="form-label" for="recovery_code">{{ t('two_fa.recovery_code_label') }}</label>
          <input type="text" id="recovery_code" name="recovery_code" class="form-input tf-mono" autocomplete="off" autocapitalize="characters" spellcheck="false" autofocus required maxlength="16" placeholder="XXXXX-XXXXX">
        </div>
        {% else %}
        <div class="form-group">
          <label class="form-label" for="code">{{ t('two_fa.code_label') }}</label>
          <input type="text" id="code" name="code" class="form-input tf-mono tf-code" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" autofocus required maxlength="6" placeholder="123456">
        </div>
        {% endif %}
        <button type="submit" class="btn btn-primary au-submit">{{ t('two_fa.submit') }}</button>
      </form>
      <div class="au-links tf-links">
        {% if useRecovery %}<a href="/login/2fa">{{ t('two_fa.use_code') }}</a>{% else %}<a href="/login/2fa?recovery=1">{{ t('two_fa.use_recovery') }}</a>{% endif %}
        <a href="/login">{{ t('two_fa.back_to_login') }}</a>
      </div>
      <div class="au-meta tf-remaining" id="tf-remaining" data-seconds="{{ remainingSeconds }}">{{ remainingText }}</div>
    </div>
  </main>
  <script nonce="{{ cspNonce }}">
    (function () {
      var el = document.getElementById('tf-remaining');
      if (!el) return;
      var left = parseInt(el.getAttribute('data-seconds'), 10) || 0;
      var tpl = {{ t('two_fa.time_remaining') | dump | safe }};
      var expired = {{ t('two_fa.error_expired') | dump | safe }};
      function tick() {
        if (left <= 0) { el.textContent = expired; return; }
        el.textContent = tpl.replace('{' + '{minutes}}', String(Math.max(1, Math.ceil(left / 60))));
        left -= 1; setTimeout(tick, 1000);
      }
      tick();
    })();
  </script>
</body>
</html>
