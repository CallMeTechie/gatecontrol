<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ t('two_fa.login_title') }} — {{ appName }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v={{ appVersion }}">
  <style nonce="{{ cspNonce }}">
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: auto;
    }
    .login-box {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
      padding: 40px 36px;
      width: 100%;
      max-width: 380px;
    }
    .login-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 32px;
    }
    .login-field {
      margin-bottom: 16px;
    }
    .login-field label {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 600;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 6px;
    }
    .login-field input {
      width: 100%;
      padding: 10px 14px;
    }
    .login-submit {
      width: 100%;
      margin-top: 8px;
      padding: 11px 16px;
      justify-content: center;
    }
    .login-error {
      background: var(--red-lt);
      border: 1px solid var(--red-bd);
      color: var(--red);
      font-size: 12px;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      margin-bottom: 16px;
    }
    .tf-intro { font-size: 13px; color: var(--text-2, var(--text-secondary)); margin: 0 0 16px; line-height: 1.5; }
    .tf-mono { font-family: var(--font-mono); letter-spacing: 0.08em; }
    .tf-code { font-size: 20px; text-align: center; letter-spacing: 0.35em; }
    .tf-links { display: flex; flex-direction: column; gap: 6px; margin-top: 16px; font-size: 12px; }
    .tf-links a { color: var(--accent); text-decoration: none; }
    .tf-links a:hover { text-decoration: underline; }
    .tf-remaining { margin-top: 12px; font-size: 11px; color: var(--text-3, var(--text-muted)); font-family: var(--font-mono); }
  </style>
</head>
<body>
  <div class="login-box">
    <div class="login-logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/>
        </svg>
      </div>
      <div>
        <div class="logo-wordmark">{{ appName }}</div>
      </div>
    </div>

    {% if flash.error %}
    <div class="login-error">{{ flash.error }}</div>
    {% endif %}

    <p class="tf-intro">{% if useRecovery %}{{ t('two_fa.recovery_intro') }}{% else %}{{ t('two_fa.login_intro') }}{% endif %}</p>
    <form method="POST" action="/login/2fa" id="tf-login-form">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {% if useRecovery %}
      <div class="login-field">
        <label for="recovery_code">{{ t('two_fa.recovery_code_label') }}</label>
        <input type="text" id="recovery_code" name="recovery_code" class="tf-mono" autocomplete="off" autocapitalize="characters" spellcheck="false" autofocus required maxlength="16" placeholder="XXXXX-XXXXX">
      </div>
      {% else %}
      <div class="login-field">
        <label for="code">{{ t('two_fa.code_label') }}</label>
        <input type="text" id="code" name="code" class="tf-mono tf-code" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" autofocus required maxlength="6" placeholder="123456">
      </div>
      {% endif %}
      <button type="submit" class="btn btn-primary login-submit">{{ t('two_fa.submit') }}</button>
    </form>
    <div class="tf-links">
      {% if useRecovery %}<a href="/login/2fa">{{ t('two_fa.use_code') }}</a>{% else %}<a href="/login/2fa?recovery=1">{{ t('two_fa.use_recovery') }}</a>{% endif %}
      <a href="/login">{{ t('two_fa.back_to_login') }}</a>
    </div>
    <div class="tf-remaining" id="tf-remaining" data-seconds="{{ remainingSeconds }}">{{ t('two_fa.time_remaining').replace('{{minutes}}', remainingMinutes) }}</div>
  </div>
  <script nonce="{{ cspNonce }}">
    (function () {
      var el = document.getElementById('tf-remaining');
      if (!el) return;
      var left = parseInt(el.getAttribute('data-seconds'), 10) || 0;
      var tpl = {{ t('two_fa.time_remaining') | dump | safe }};
      var expired = {{ t('two_fa.error_expired') | dump | safe }};
      function tick() {
        if (left <= 0) { el.textContent = expired; return; }
        el.textContent = tpl.replace('{{minutes}}', String(Math.max(1, Math.ceil(left / 60))));
        left -= 1; setTimeout(tick, 1000);
      }
      tick();
    })();
  </script>
</body>
</html>
