{% extends theme + "/layout.njk" %}

{#- The plugin area under Einstellungen › Plugins (docs/plugins.md "Plugin
    area", mockup "Plugins – UI & UX Konzept"): Meine Plugins, Katalog (one
    page per plugin too), Updates, Lizenzen, Sicherheit & Upload, Speicher, Protokoll
    and one installed plugin (manage/<id>). One page for all views: the side
    navigation is static (the catalogue swaps it for its filters, the pages of
    one plugin have none), the view is built by public/js/plugins-page.js from
    the admin APIs. Styles: the pgx- block in public/css/app.css. -#}

{%- set B = pgBase or '/settings/plugins' %}
{%- set I = {
  installed: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  catalog: 'M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2',
  updates: 'M20 12a8 8 0 1 1-2.3-5.6M20 4v5h-5',
  licenses: 'M8 19a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM11 12l9-9M16 7l3 3',
  security: 'M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z',
  storage: 'M4 5h16v6H4zM4 13h16v6H4zM8 8h.01M8 16h.01',
  log: 'M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01'
} %}
{%- set navPlugins = [['installed', B, 'plugins.area.mine'], ['catalog', B + '/catalog', 'plugins.area.catalog'], ['updates', B + '/updates', 'plugins.area.updates'], ['licenses', B + '/licenses', 'plugins.area.licenses']] %}
{%- set navAdmin = [['security', B + '/security', 'plugins.area.security'], ['storage', B + '/storage', 'plugins.area.storage'], ['log', B + '/log', 'plugins.area.log']] %}
{%- set current = 'catalog' if pgView == 'catalogItem' else ('installed' if pgView == 'manage' else pgView) %}
{%- set full = pgView in ['manage', 'catalogItem'] %}

{% block content %}
<div class="pgx" id="pgx" data-view="{{ pgView }}" data-target="{{ pgTarget }}" data-catalog="{{ '1' if pgCatalog else '0' }}" data-base="{{ B }}">
  {#- phone: Meine · Katalog · Updates (the other pages: links at the end of the view) -#}
  {%- if not full %}
  <nav class="pgx-tb" aria-label="{{ t('plugins.area.nav') }}">
    {%- for it in navPlugins %}{% if it[0] != 'licenses' and (it[0] != 'catalog' or pgCatalog) %}
    <a href="{{ it[1] }}" data-mtab="{{ it[0] }}"{% if it[0] == current %} aria-current="page"{% endif %}>{{ t('plugins.area.m_' + it[0]) }}<em class="pgx-tb-n" id="pgx-mcount-{{ it[0] }}" hidden></em></a>
    {%- endif %}{% endfor %}
  </nav>
  {%- endif %}
  <div class="pgx-wrap{{ ' pgx-wrap-full' if full }}">
    {%- if not full %}
    <nav class="pgx-side" id="pgx-side" aria-label="{{ t('plugins.area.nav') }}">
      <a class="pgx-sl pgx-sl-back" href="/settings"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>{{ t('nav.settings') }}</a>
      <span class="pgx-lbl">{{ t('plugins.area.grp_plugins') }}</span>
      {%- for it in navPlugins %}{% if it[0] != 'catalog' or pgCatalog %}
      <a class="pgx-sl" href="{{ it[1] }}" data-tab="{{ it[0] }}"{% if it[0] == current %} aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ I[it[0]] }}"/></svg>{{ t(it[2]) }}<span class="pgx-cnt" id="pgx-count-{{ it[0] }}" hidden></span>
      </a>
      {%- endif %}{% endfor %}
      <span class="pgx-lbl">{{ t('plugins.area.grp_admin') }}</span>
      {%- for it in navAdmin %}
      <a class="pgx-sl" href="{{ it[1] }}" data-tab="{{ it[0] }}"{% if it[0] == current %} aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ I[it[0]] }}"/></svg>{{ t(it[2]) }}
      </a>
      {%- endfor %}
    </nav>
    {%- endif %}
    <div class="pgx-main" id="pgx-main" aria-busy="true">
      {#- Former built-in integrations whose data waits for the plugin
          (docs/plugins.md "Built-in data import"). -#}
      {%- for mv in builtinMoved or [] %}
      <div class="pgx-banner" data-tone="warn" role="note" data-builtin-moved="{{ mv.pluginId }}">
        <span class="pgx-grow">{{ t('plugins.moved.' + mv.dataset) }}</span>
        <a href="{{ mv.url }}" class="pgx-btn pgx-btn-sm" target="_blank" rel="noopener noreferrer">{{ t('plugins.moved.download') }}</a>
        {%- if mv.catalog %}<a href="{{ B }}/catalog/{{ mv.pluginId }}" class="pgx-btn pgx-btn-sm pgx-btn-pri">{{ t('plugins.moved.install_now') }}</a>{% endif %}
      </div>
      {%- endfor %}
      <p class="st-err-block" id="pgx-err" role="alert" hidden></p>
      <div class="pgx-view" id="pgx-view"><p class="pgx-loading" id="pgx-loading">{{ t('plugins.area.loading') }}</p></div>
      {%- if not full %}
      <nav class="pgx-mmore" aria-label="{{ t('plugins.area.grp_admin') }}">
        {%- for it in [['licenses', B + '/licenses', 'plugins.area.licenses']].concat(navAdmin) %}{% if it[0] != current %}
        <a href="{{ it[1] }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ I[it[0]] }}"/></svg><span>{{ t(it[2]) }}</span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
        {%- endif %}{% endfor %}
      </nav>
      {%- endif %}
    </div>
  </div>
  <input type="file" id="pgx-file" class="st-sr" accept=".gcplugin,application/octet-stream" tabindex="-1" aria-hidden="true">
</div>

{#- plugins.* and common.* strings (src/routes/plugins.js AREA_I18N_PREFIXES) -#}
<script type="application/json" id="pgx-i18n" data-prefixes="plugins. common." nonce="{{ cspNonce }}">{{ pgI18n | default('{}') | safe }}</script>
{% endblock %}

{% block scripts %}
<script src="/js/qr-scan.js?v={{ appVersion }}"></script>
<script src="/js/plugin-bridge.js?v={{ appVersion }}"></script>
<script src="/js/principal-picker.js?v={{ appVersion }}"></script>
<script src="/js/plugins-ui.js?v={{ appVersion }}"></script>
<script src="/js/plugins-page.js?v={{ appVersion }}"></script>
{% endblock %}
