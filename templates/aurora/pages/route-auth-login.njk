<!DOCTYPE html>
<html lang="{{ language }}" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ t('route_auth.verify_access') }} — {{ domain }}</title>
  <script nonce="{{ cspNonce }}">
(function(){try{var s=localStorage.getItem('gc-theme-mode');var t=s||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();
</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  {# Served under /route-auth/static/ so Caddy can intercept it on proxied domains. #}
  <link rel="stylesheet" href="/route-auth/static/css/app.css?v={{ appVersion }}">
  {% if branding and branding.color %}
  <style nonce="{{ cspNonce }}">
    .au-page .btn-primary { background: {{ branding.color }}; box-shadow: none; }
    .au-brand .mark { background: {{ branding.color }}; }
  </style>
  {% endif %}
  {% if branding and branding.bg_image %}
  <style nonce="{{ cspNonce }}">body { background: url('/route-auth/static/branding/{{ branding.bg_image }}') center/cover no-repeat fixed; }</style>
  {% elif branding and branding.bg %}
  <style nonce="{{ cspNonce }}">body { background: {{ branding.bg }}; }</style>
  {% endif %}
</head>
<body class="au-page">
  <main class="au-wrap">
    {% if branding and branding.logo %}
    <div class="au-brand au-brand-logo">
      <img src="/route-auth/static/branding/{{ branding.logo }}" alt="Logo">
      {% if branding.title %}<span class="nm">{{ branding.title }}</span>{% endif %}
    </div>
    {% elif not branding or branding.title %}
    <div class="au-brand">
      <span class="mark"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m8.5 12 2.5 2.5L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="nm">{{ branding.title if branding and branding.title else 'GateControl' }}</span>
    </div>
    {% endif %}
    {% if branding and branding.text %}
    <p class="au-brand-text">{{ branding.text }}</p>
    {% endif %}

    <div class="card au-card">

      {# Error card (non-JS / server-side errors) #}
      {% if error %}
      <div class="login-error" role="alert">{{ errorMessage }}</div>
      {% endif %}

      {# ── STEP 2: Email Code ─────────────────────────────── #}
      {% if is2faStep2 and twoFactorMethod == 'email_code' %}

        <div class="au-domain">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{{ domain }}</span>
        </div>

        <div class="page-eyebrow">{{ t('route_auth.access_to') }}</div>
        <h1 class="au-title">{{ t('route_auth.step_2_email_code') }}</h1>

        <div class="au-steps" aria-hidden="true"><span class="au-step done"></span><span class="au-step-line"></span><span class="au-step active"></span></div>

        <div class="au-info">{{ t('route_auth.code_sent_to') }} <strong>{{ maskedEmail }}</strong></div>

        <div class="form-error" id="form-error"></div>

        <form id="verify-form" method="POST" action="/route-auth/verify-code">
          <input type="hidden" name="_csrf" value="{{ routeCsrfToken }}">
          <input type="hidden" name="route" value="{{ domain }}">
          <input type="hidden" name="redirect" value="{{ redirect }}">

          <div class="au-code" id="code-inputs">
            <input type="number" maxlength="1" inputmode="numeric" autocomplete="one-time-code" autofocus>
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
          </div>
          <input type="hidden" name="code" id="code-value">

          <button type="submit" class="btn btn-primary au-submit" id="verify-btn">{{ t('route_auth.verify') }}</button>
        </form>

        <div class="au-links au-links-center">
          <button type="button" class="au-link" id="resend-btn">{{ t('route_auth.resend_code') }}</button>
          <span class="au-link-sep" aria-hidden="true"></span>
          <a href="/route-auth/login?route={{ domain }}&redirect={{ redirect | urlencode }}" class="au-link">{{ t('route_auth.back') }}</a>
        </div>

      {# ── STEP 2: TOTP ───────────────────────────────────── #}
      {% elif is2faStep2 and twoFactorMethod == 'totp' %}

        <div class="au-domain">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{{ domain }}</span>
        </div>

        <div class="page-eyebrow">{{ t('route_auth.access_to') }}</div>
        <h1 class="au-title">{{ t('route_auth.step_2_authenticator') }}</h1>

        <div class="au-steps" aria-hidden="true"><span class="au-step done"></span><span class="au-step-line"></span><span class="au-step active"></span></div>

        <div class="au-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>

        <div class="au-info">{{ t('route_auth.enter_authenticator_code') }}</div>

        <div class="form-error" id="form-error"></div>

        <form id="verify-form" method="POST" action="/route-auth/verify-code">
          <input type="hidden" name="_csrf" value="{{ routeCsrfToken }}">
          <input type="hidden" name="route" value="{{ domain }}">
          <input type="hidden" name="redirect" value="{{ redirect }}">

          <div class="au-code" id="code-inputs">
            <input type="number" maxlength="1" inputmode="numeric" autocomplete="one-time-code" autofocus>
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
          </div>
          <input type="hidden" name="code" id="code-value">

          <button type="submit" class="btn btn-primary au-submit" id="verify-btn">{{ t('route_auth.verify') }}</button>
        </form>

        <div class="au-links au-links-center">
          <a href="/route-auth/login?route={{ domain }}&redirect={{ redirect | urlencode }}" class="au-link">{{ t('route_auth.back') }}</a>
        </div>

      {# ── email_password + 2FA: Step 1 ───────────────────── #}
      {% elif twoFactorEnabled and not is2faStep2 %}

        <div class="au-domain">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{{ domain }}</span>
        </div>

        <div class="page-eyebrow">{{ t('route_auth.access_to') }}</div>
        <h1 class="au-title">{{ t('route_auth.step_1_sign_in') }}</h1>

        <div class="au-steps" aria-hidden="true"><span class="au-step active"></span><span class="au-step-line"></span><span class="au-step"></span></div>

        <div class="form-error" id="form-error"></div>

        <form id="login-form" method="POST" action="/route-auth/login">
          <input type="hidden" name="_csrf" value="{{ routeCsrfToken }}">
          <input type="hidden" name="route" value="{{ domain }}">
          <input type="hidden" name="redirect" value="{{ redirect }}">

          <div class="form-group">
            <label class="form-label" for="email">{{ t('route_auth.email') }}</label>
            <input class="form-input" type="email" id="email" name="email" autocomplete="email" autofocus required>
          </div>
          <div class="form-group">
            <label class="form-label" for="password">{{ t('route_auth.password') }}</label>
            <input class="form-input" type="password" id="password" name="password" autocomplete="current-password" required>
          </div>

          <button type="submit" class="btn btn-primary au-submit" id="login-btn">{{ t('route_auth.continue') }}</button>
        </form>

      {# ── email_password (no 2FA) ────────────────────────── #}
      {% elif authType == 'email_password' %}

        <div class="au-domain">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{{ domain }}</span>
        </div>

        <div class="page-eyebrow">{{ t('route_auth.access_to') }}</div>
        <h1 class="au-title">{{ t('route_auth.verify_access') }}</h1>

        <div class="form-error" id="form-error"></div>

        <form id="login-form" method="POST" action="/route-auth/login">
          <input type="hidden" name="_csrf" value="{{ routeCsrfToken }}">
          <input type="hidden" name="route" value="{{ domain }}">
          <input type="hidden" name="redirect" value="{{ redirect }}">

          <div class="form-group">
            <label class="form-label" for="email">{{ t('route_auth.email') }}</label>
            <input class="form-input" type="email" id="email" name="email" autocomplete="email" autofocus required>
          </div>
          <div class="form-group">
            <label class="form-label" for="password">{{ t('route_auth.password') }}</label>
            <input class="form-input" type="password" id="password" name="password" autocomplete="current-password" required>
          </div>

          <button type="submit" class="btn btn-primary au-submit" id="login-btn">{{ t('route_auth.sign_in') }}</button>
        </form>

      {# ── email_code ────────────────────────────────────── #}
      {% elif authType == 'email_code' %}

        <div class="au-domain">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{{ domain }}</span>
        </div>

        <div class="page-eyebrow">{{ t('route_auth.access_to') }}</div>
        <h1 class="au-title">{{ t('route_auth.verify_access') }}</h1>

        <div class="form-error" id="form-error"></div>

        {# Email section — visible initially #}
        <div id="email-section">
          <form id="send-code-form" method="POST" action="/route-auth/send-code">
            <input type="hidden" name="_csrf" value="{{ routeCsrfToken }}">
            <input type="hidden" name="route" value="{{ domain }}">
            <input type="hidden" name="redirect" value="{{ redirect }}">

            <div class="form-group">
              <label class="form-label" for="email">{{ t('route_auth.email') }}</label>
              <input class="form-input" type="email" id="email" name="email" autocomplete="email" autofocus required>
            </div>

            <button type="submit" class="btn btn-primary au-submit" id="send-code-btn">{{ t('route_auth.send_code') }}</button>
          </form>
        </div>

        {# Code section — hidden until code sent #}
        <div id="code-section" style="display:none;">
          <div class="au-info" id="code-info-text"></div>

          <form id="verify-form" method="POST" action="/route-auth/verify-code">
            <input type="hidden" name="_csrf" value="{{ routeCsrfToken }}">
            <input type="hidden" name="route" value="{{ domain }}">
            <input type="hidden" name="redirect" value="{{ redirect }}">

            <div class="au-code" id="code-inputs">
              <input type="number" maxlength="1" inputmode="numeric" autocomplete="one-time-code">
              <input type="number" maxlength="1" inputmode="numeric">
              <input type="number" maxlength="1" inputmode="numeric">
              <input type="number" maxlength="1" inputmode="numeric">
              <input type="number" maxlength="1" inputmode="numeric">
              <input type="number" maxlength="1" inputmode="numeric">
            </div>
            <input type="hidden" name="code" id="code-value">

            <button type="submit" class="btn btn-primary au-submit" id="verify-btn">{{ t('route_auth.verify') }}</button>
          </form>

          <div class="au-links au-links-center">
            <button type="button" class="au-link" id="resend-btn">{{ t('route_auth.resend_code') }}</button>
          </div>
        </div>

      {# ── totp ──────────────────────────────────────────── #}
      {% elif authType == 'totp' %}

        <div class="au-domain">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{{ domain }}</span>
        </div>

        <div class="page-eyebrow">{{ t('route_auth.access_to') }}</div>
        <h1 class="au-title">{{ t('route_auth.verify_access') }}</h1>

        <div class="au-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>

        <div class="au-info">{{ t('route_auth.enter_authenticator_code') }}</div>

        <div class="form-error" id="form-error"></div>

        <form id="verify-form" method="POST" action="/route-auth/verify-code">
          <input type="hidden" name="_csrf" value="{{ routeCsrfToken }}">
          <input type="hidden" name="route" value="{{ domain }}">
          <input type="hidden" name="redirect" value="{{ redirect }}">

          <div class="au-code" id="code-inputs">
            <input type="number" maxlength="1" inputmode="numeric" autocomplete="one-time-code" autofocus>
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
            <input type="number" maxlength="1" inputmode="numeric">
          </div>
          <input type="hidden" name="code" id="code-value">

          <button type="submit" class="btn btn-primary au-submit" id="verify-btn">{{ t('route_auth.verify') }}</button>
        </form>

      {# ── share ─────────────────────────────────────────── #}
      {% elif authType == 'share' %}

        <div class="ra-share-invitation">
          <div class="au-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <h1 class="au-title">{{ t('route_auth.share_invite_title') }}</h1>
          <p class="au-sub">{{ t('route_auth.share_invite_body') if not shareInvalid else t('route_auth.share_invalid_body') }}</p>
        </div>

      {% endif %}

    </div>

    <div class="au-foot">{{ t('route_auth.protected_by') }}</div>
  </main>

  <script src="/route-auth/static/js/route-auth-login.js" nonce="{{ cspNonce }}"></script>
</body>
</html>
