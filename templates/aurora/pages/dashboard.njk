{% extends theme + "/layout.njk" %}

{#
  Dashboard (redesign 2026-10): health tiles, "Braucht Aufmerksamkeit",
  traffic chart, peers / gateways / server, live activity, security (24 h).
  Everything below the header is filled by dashboard.js from the admin API
  (one coordinated refresh loop + SSE); the markup only carries the frame,
  the headings and the hooks. Styles: app.css §2, "Dashboard redesign (db-)".
#}

{% macro statusIcon() %}<span class="db-status-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12h10"/></svg></span>{% endmacro %}

{% block content %}
<div class="db-page" id="db-page"
     data-lang="{{ language }}"
     data-fleet="{{ '1' if license.features.gateway_fleet else '0' }}">

{% if license.unlicensed %}
<div class="db-banner db-banner-accent" role="note">
  <span class="db-banner-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2 20 3M17 6l3 3M14 9l2 2"/></svg></span>
  <span class="db-banner-text">{{ t('license.unlicensed_banner') }}</span>
  <a href="https://callmetechie.de/products/gatecontrol/pricing" target="_blank" rel="noopener" class="db-btn db-btn-primary">{{ t('license.get_free_license') }}</a>
</div>
{% endif %}

{#- Former built-in integrations (Smart Home, Klimaanlage, Fahrzeuge) are
    plugins now: their data waits for the plugin (docs/plugins.md
    "Built-in data import"). -#}
{% for mv in builtinMoved or [] %}
<div class="db-banner db-banner-accent" role="note" data-builtin-moved="{{ mv.pluginId }}">
  <span class="db-banner-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg></span>
  <span class="db-banner-text">{{ t('plugins.moved.' + mv.dataset) }}</span>
  <a href="{{ mv.url }}" target="_blank" rel="noopener noreferrer" class="db-btn">{{ t('plugins.moved.download') }}</a>
  {% if mv.catalog %}<a href="/settings?install={{ mv.pluginId }}#plugins" class="db-btn db-btn-primary">{{ t('plugins.moved.install_now') }}</a>
  {% else %}<a href="/settings#plugins" class="db-btn db-btn-primary">{{ t('plugins.moved.install') }}</a>{% endif %}
</div>
{% endfor %}

{% if needs_repair_gateways and needs_repair_gateways.length > 0 %}
<div class="db-banner db-banner-warn" role="alert" id="db-repair">
  <span class="db-banner-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 7v6M12 17v.5"/></svg></span>
  <div class="db-banner-text">
    <strong>{{ t('gateway_needs_repair_title') }}</strong>
    <span class="db-banner-sub">{{ t('gateway_needs_repair_msg') }}</span>
    <ul class="db-banner-list">
      {% for gw in needs_repair_gateways %}
      <li><code>{{ gw.name }}</code> — <a href="/peers">{{ t('download_new_env') }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %}

{# "Was ist neu": a slim strip, only while the running version is unseen
   (GET /system/whats-new); the changelog arrives as tokens, rendered with
   textContent only (ops-ui.js). #}
<section class="db-news" id="whats-new" hidden aria-labelledby="whats-new-badge"
         data-title="{{ t('whatsnew.title') }}" data-title-all="{{ t('whatsnew.title_all') }}">
  <div class="db-news-row">
    <span class="db-news-badge" id="whats-new-badge"></span>
    <span class="db-news-text" id="whats-new-text"></span>
    <button type="button" class="db-link-btn" id="whats-new-all" aria-expanded="false" aria-controls="whats-new-body">{{ t('whatsnew.all') }}</button>
    <button type="button" class="db-btn db-btn-sm" id="whats-new-dismiss">{{ t('whatsnew.dismiss') }}</button>
  </div>
  <div class="db-news-body op-wn-body" id="whats-new-body" hidden tabindex="0" aria-label="{{ t('whatsnew.all') }}"></div>
</section>

<header class="db-head">
  <div class="db-head-main">
    <div class="db-live" id="db-live" data-state="loading">
      <span class="db-live-dot" aria-hidden="true"></span><span id="db-live-text">{{ t('dashboard.live_loading') }}</span>
    </div>
    <h1 class="db-title" id="db-headline">{{ t('dashboard.title') }}</h1>
    <p class="db-sub" id="db-subline"></p>
  </div>
  <div class="db-head-actions">
    <a href="/routes?action=new-host" class="db-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18"/></svg>
      {{ t('dashboard.new_host') }}
    </a>
    <a href="/peers?action=add" class="db-btn db-btn-primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      {{ t('dashboard.add_peer') }}
    </a>
  </div>
</header>

{# Five health tiles; state (OK / Achtung / Störung) always as icon + text. #}
<div class="db-tiles" id="db-tiles">
  {% for tile in [
    { id: 'tunnel', href: '/peers', label: 'dashboard.tile_tunnel' },
    { id: 'gateways', href: '/gateways', label: 'dashboard.tile_gateways' },
    { id: 'routes', href: '/routes', label: 'dashboard.tile_routes' },
    { id: 'certs', href: '/certificates', label: 'dashboard.tile_certs' },
    { id: 'check', href: '/security', label: 'dashboard.tile_check' }
  ] %}
  <a class="db-tile" id="db-tile-{{ tile.id }}" href="{{ tile.href }}" data-state="loading">
    <span class="db-tile-top">
      {{ statusIcon() }}
      <span class="db-tile-label">{{ t(tile.label) }}</span>
    </span>
    <span class="db-tile-main">
      <span class="db-tile-value">—</span>
      <span class="db-badge db-tile-badge"></span>
    </span>
    <span class="db-tile-sub">{{ t('dashboard.live_loading') }}</span>
  </a>
  {% endfor %}
</div>

<div class="db-row db-row-main" id="db-row-main">

  {# Braucht Aufmerksamkeit (docs/feature-next-package.md S3 §1): GET
     /dashboard/problems. Hidden while there is nothing to report — the
     traffic card then takes the full width. #}
  <section class="db-card db-problems" id="dash-problems" hidden aria-labelledby="dash-problems-title">
    <div class="db-card-head db-card-head-rule">
      <h2 class="db-card-title" id="dash-problems-title">{{ t('dashboard.problems_title') }}</h2>
      <span class="db-count" id="dash-problems-count" hidden></span>
    </div>
    <ul class="db-plist" id="dash-problems-list"></ul>
    <p class="db-note" id="dash-problems-hint" hidden></p>
    <div class="db-od" id="dash-problems-ondemand" hidden>
      <h3 class="db-od-title">{{ t('problems.on_demand_title') }}</h3>
      <ul class="db-od-list" id="dash-problems-ondemand-list"></ul>
    </div>
  </section>

  <section class="db-card db-traffic" id="db-traffic" aria-labelledby="db-traffic-title">
    <div class="db-traffic-head">
      <div class="db-traffic-sum">
        <h2 class="db-card-title" id="db-traffic-title">{{ t('dashboard.traffic_title') }}</h2>
        <div class="db-hero">
          <span class="db-hero-value" id="db-traffic-total">—</span>
          <span class="db-hero-label" id="db-traffic-period"></span>
        </div>
        <div class="db-split">
          <span class="db-split-item"><span class="db-key db-key-s1" aria-hidden="true"></span>{{ t('dashboard.download') }} <strong class="db-mono" id="db-traffic-down">—</strong></span>
          <span class="db-split-item"><span class="db-key db-key-s2" aria-hidden="true"></span>{{ t('dashboard.upload') }} <strong class="db-mono" id="db-traffic-up">—</strong></span>
          <span class="db-split-rate" id="db-traffic-rate"></span>
        </div>
      </div>
      <div class="db-traffic-ctl">
        <div class="db-seg" role="group" aria-label="{{ t('dashboard.period') }}" id="db-range">
          <button type="button" class="db-seg-btn" data-range="1h" aria-pressed="false">{{ t('dashboard.range_1h') }}</button>
          <button type="button" class="db-seg-btn" data-range="24h" aria-pressed="true">{{ t('dashboard.range_24h') }}</button>
          <button type="button" class="db-seg-btn" data-range="7d" aria-pressed="false">{{ t('dashboard.range_7d') }}</button>
          <button type="button" class="db-seg-btn" data-range="30d" aria-pressed="false">{{ t('dashboard.range_30d') }}</button>
        </div>
        <button type="button" class="db-ghost-btn" id="db-table-toggle" aria-pressed="false" aria-controls="db-chart db-table">{{ t('dashboard.as_table') }}</button>
      </div>
    </div>
    <div class="db-chart" id="db-chart" aria-busy="true"></div>
    <div class="db-table-wrap" id="db-table" hidden tabindex="0" aria-labelledby="db-traffic-title">
      <table class="db-table">
        <caption class="db-sr" id="db-table-caption"></caption>
        <thead><tr>
          <th scope="col">{{ t('dashboard.table_time') }}</th>
          <th scope="col" class="db-num">{{ t('dashboard.download') }}</th>
          <th scope="col" class="db-num">{{ t('dashboard.upload') }}</th>
        </tr></thead>
        <tbody id="db-table-body"></tbody>
      </table>
    </div>
    <p class="db-empty" id="db-chart-empty" hidden>{{ t('dashboard.chart_empty') }}</p>
    <div class="db-legend" id="db-legend" aria-hidden="true">
      <span class="db-legend-item"><span class="db-key db-key-s1"></span>{{ t('dashboard.download') }}</span>
      <span class="db-legend-item"><span class="db-key db-key-s2"></span>{{ t('dashboard.upload') }}</span>
    </div>
  </section>
</div>

<div class="db-grid3">

  <section class="db-card" id="db-peers" aria-labelledby="db-peers-title">
    <div class="db-card-head">
      <h2 class="db-card-title" id="db-peers-title">{{ t('dashboard.peers_title') }}</h2>
      <span class="db-card-meta">{{ t('dashboard.peers_today') }}</span>
      <a class="db-card-link" href="/peers" id="db-peers-all">{{ t('dashboard.peers_all') }}</a>
    </div>
    <div class="db-counts">
      <div class="db-countbox"><div class="db-count-value" id="db-peers-online">—</div><div class="db-count-label">{{ t('dashboard.peers_connected') }}</div></div>
      <div class="db-countbox"><div class="db-count-value" id="db-peers-offline">—</div><div class="db-count-label">{{ t('dashboard.peers_offline') }}</div></div>
      <div class="db-countbox"><div class="db-count-value" id="db-peers-outdated">—</div><div class="db-count-label">{{ t('dashboard.peers_outdated') }}</div></div>
    </div>
    <ul class="db-bars" id="db-top-peers"></ul>
    <p class="db-empty db-empty-sm" id="db-top-peers-empty" hidden>{{ t('dashboard.peers_no_traffic') }}</p>
  </section>

  <section class="db-card" id="db-gateways" aria-labelledby="db-gateways-title">
    <div class="db-card-head">
      <h2 class="db-card-title" id="db-gateways-title">{{ t('dashboard.gateways_title') }}</h2>
      <a class="db-card-link" href="/gateways">{{ t('dashboard.gateways_manage') }}</a>
    </div>
    <ul class="db-gwlist" id="db-gw-list"></ul>
    <p class="db-empty db-empty-sm" id="db-gw-empty" hidden>{{ t('dashboard.gateways_none') }}</p>
  </section>

  <section class="db-card" id="db-server" aria-labelledby="db-server-title">
    <div class="db-card-head">
      <h2 class="db-card-title" id="db-server-title">{{ t('dashboard.server_title') }}</h2>
      <span class="db-card-meta" id="db-uptime"></span>
    </div>
    <div class="db-meters" id="db-meters">
      {% for m in [{ id: 'cpu', label: 'dashboard.meter_cpu' }, { id: 'ram', label: 'dashboard.meter_ram' }, { id: 'disk', label: 'dashboard.meter_disk' }] %}
      <div class="db-meter" id="db-meter-{{ m.id }}" data-level="ok">
        <div class="db-meter-head">
          <span class="db-meter-label" id="db-meter-{{ m.id }}-label">{{ t(m.label) }}</span>
          <span class="db-meter-detail"></span>
          <span class="db-meter-value">—</span>
        </div>
        <div class="db-meter-track" role="meter" aria-labelledby="db-meter-{{ m.id }}-label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="db-meter-fill"></div></div>
      </div>
      {% endfor %}
    </div>
    <div class="db-au" id="auto-update" tabindex="-1" data-state="loading">
      {{ statusIcon() }}
      <div class="db-au-text">
        <div class="db-au-title" id="db-au-title">v{{ appVersion }}</div>
        <div class="db-au-sub" id="db-au-sub"></div>
        <ul class="db-au-notes" id="db-au-notes"></ul>
      </div>
      <div class="db-au-actions" id="db-au-actions"></div>
    </div>
  </section>
</div>

<div class="db-row db-row-bottom">

  <section class="db-card db-activity" id="db-activity" aria-labelledby="db-activity-title">
    <div class="db-card-head db-card-head-rule db-activity-head">
      <h2 class="db-card-title" id="db-activity-title">{{ t('dashboard.activity_title') }}</h2>
      <span class="db-live-chip" id="db-activity-live"><span class="db-live-dot" aria-hidden="true"></span>{{ t('dashboard.live') }}</span>
      <div class="db-chips" role="group" aria-label="{{ t('dashboard.activity_filter') }}" id="db-activity-filter">
        <button type="button" class="db-chip" data-cat="all" aria-pressed="true">{{ t('dashboard.cat_all') }}</button>
        <button type="button" class="db-chip" data-cat="login" aria-pressed="false">{{ t('dashboard.cat_login') }}</button>
        <button type="button" class="db-chip" data-cat="peer" aria-pressed="false">{{ t('dashboard.cat_peer') }}</button>
        <button type="button" class="db-chip" data-cat="route" aria-pressed="false">{{ t('dashboard.cat_route') }}</button>
        <button type="button" class="db-chip" data-cat="security" aria-pressed="false">{{ t('dashboard.cat_security') }}</button>
      </div>
    </div>
    <ol class="db-feed" id="activity-feed"></ol>
    <p class="db-empty db-empty-sm" id="activity-empty" hidden>{{ t('dashboard.activity_empty') }}</p>
    <a class="db-card-foot-link" href="/logs">{{ t('dashboard.activity_all') }}</a>
  </section>

  <section class="db-card db-security" id="db-security" aria-labelledby="db-security-title">
    <div class="db-card-head">
      <h2 class="db-card-title" id="db-security-title">{{ t('dashboard.security_title') }}</h2>
      <span class="db-card-meta">{{ t('dashboard.security_window') }}</span>
    </div>
    <div class="db-subtiles" id="db-sec-tiles">
      <div class="db-subtile" id="db-sec-waf" hidden>
        <div class="db-subtile-label">{{ t('dashboard.sec_waf') }}</div>
        <div class="db-subtile-main">
          <span class="db-subtile-value" id="db-sec-waf-value">—</span>
          <svg class="db-spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="db-spark-line" id="db-sec-waf-spark" d=""/>
            <path class="db-spark-last" id="db-sec-waf-spark-last" d=""/>
          </svg>
        </div>
        <div class="db-subtile-sub" id="db-sec-waf-sub"></div>
      </div>
      <div class="db-subtile" id="db-sec-logins" hidden>
        <div class="db-subtile-label">{{ t('dashboard.sec_logins') }}</div>
        <div class="db-subtile-value" id="db-sec-logins-value">—</div>
        <div class="db-subtile-sub" id="db-sec-logins-sub"></div>
      </div>
      <div class="db-subtile" id="db-sec-bots" hidden>
        <div class="db-subtile-label">{{ t('dashboard.sec_bots') }}</div>
        <div class="db-subtile-value" id="db-sec-bots-value">—</div>
        <div class="db-subtile-sub" id="db-sec-bots-sub"></div>
      </div>
      <div class="db-subtile" id="db-sec-pihole" hidden>
        <div class="db-subtile-label">{{ t('dashboard.sec_pihole') }}</div>
        <div class="db-subtile-value" id="db-sec-pihole-value">—</div>
        <div class="db-subtile-sub" id="db-sec-pihole-sub"></div>
      </div>
    </div>
    <a class="db-checkrow" id="db-sec-check" href="/security" data-state="loading" hidden>
      {{ statusIcon() }}
      <span class="db-checkrow-text">
        <span class="db-checkrow-title" id="db-sec-check-title"></span>
        <span class="db-checkrow-sub" id="db-sec-check-sub"></span>
      </span>
      <span class="db-checkrow-go">{{ t('dashboard.sec_check_open') }}</span>
    </a>
  </section>
</div>

</div>

<!-- Auto-update setup modal -->
<div class="modal-overlay" id="au-setup-modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-head">
      <span class="modal-title" id="au-setup-title"></span>
      <button class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button>
    </div>
    <div class="modal-body" id="au-setup-body"></div>
  </div>
</div>

{# All dashboard.* and problems.* strings (src/routes/index.js, stringsWithPrefix). #}
<script type="application/json" id="db-i18n" data-prefixes="dashboard. problems." nonce="{{ cspNonce }}">{{ dashI18n | default('{}') | safe }}</script>
{% endblock %}

{% block scripts %}
<script src="/js/ops-ui.js?v={{ appVersion }}"></script>
<script src="/js/dashboard-ui.js?v={{ appVersion }}"></script>
<script src="/js/dashboard.js?v={{ appVersion }}"></script>
{% endblock %}
