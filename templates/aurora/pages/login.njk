<!DOCTYPE html>
<html lang="{{ language }}" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#f2f0eb">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title>{{ t('auth.login') }} — {{ appName }}</title>
  <script nonce="{{ cspNonce }}">
(function(){try{var s=localStorage.getItem('gc-theme-mode');var t=s||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();
</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v={{ appVersion }}">
</head>
<body class="au-page">
  <main class="au-wrap">
    <div class="au-brand">
      <span class="mark"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m8.5 12 2.5 2.5L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="nm">{{ appName }}</span>
    </div>

    <div class="card au-card">
      <h1 class="au-title">{{ t('auth.login') }}</h1>
      <p class="au-sub">{{ t('auth.sign_in_subtitle') }}</p>

      {% if flash.error %}
      <div class="login-error" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>{{ flash.error }}</span>
      </div>
      {% endif %}

      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if returnTo %}<input type="hidden" name="returnTo" value="{{ returnTo }}">{% endif %}
        <div class="form-group">
          <label class="form-label" for="username">{{ t('auth.username') }}</label>
          <input class="form-input" type="text" id="username" name="username" autocomplete="username" autofocus required maxlength="64">
        </div>
        <div class="form-group">
          <label class="form-label" for="password">{{ t('auth.password') }}</label>
          <div class="au-pw">
            <input class="form-input" type="password" id="password" name="password" autocomplete="current-password" required maxlength="128">
            <button type="button" class="au-pw-toggle" id="au-pw-toggle" aria-label="{{ t('auth.show_password') }}" title="{{ t('auth.show_password') }}" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary au-submit">{{ t('auth.submit') }}</button>
      </form>

      {% if passkeyOrigin %}
      {# Passkey login (docs/feature-admin-passkeys.md) — shown by /js/login-passkey.js #}
      <div class="au-passkey" id="pk-login" data-origin="{{ passkeyOrigin }}" hidden>
        <div class="au-divider"><span>{{ t('passkey.login_or') }}</span></div>
        <button type="button" class="btn btn-ghost au-submit au-passkey-btn" id="pk-login-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="9" r="4"/><path d="M2 21c0-3.3 2.7-6 6-6 1.4 0 2.6.4 3.6 1.2"/><circle cx="17.5" cy="12.5" r="2.5"/><path d="M17.5 15v6l1.5-1.5M17.5 18.5l1.5-1"/></svg>
          <span>{{ t('passkey.login_button') }}</span>
        </button>
        <p class="au-passkey-msg" id="pk-login-msg" role="status" hidden></p>
        <script type="application/json" id="pk-login-i18n">{
          "failed": {{ t('passkey.error_login_failed') | dump | safe }},
          "cancelled": {{ t('passkey.login_cancelled') | dump | safe }},
          "unsupported": {{ t('passkey.error_browser_unsupported') | dump | safe }},
          "wrong_origin": {{ t('passkey.error_wrong_origin') | dump | safe }}
        }</script>
      </div>
      {% endif %}
    </div>

    <div class="au-foot">{{ appName }} v{{ appVersion }}</div>
  </main>

  {% if passkeyOrigin %}
  <script src="/js/webauthn.js?v={{ appVersion }}"></script>
  <script src="/js/login-passkey.js?v={{ appVersion }}"></script>
  {% endif %}
  <script nonce="{{ cspNonce }}">
    (function () {
      var btn = document.getElementById('au-pw-toggle');
      var pw = document.getElementById('password');
      if (!btn || !pw) return;
      btn.addEventListener('click', function () {
        var show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
        pw.focus();
      });
    })();
  </script>
</body>
</html>
