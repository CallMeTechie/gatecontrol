      <div id="us-inv-result" hidden>
        <label class="us-field"><span class="us-label">{{ t('us.inv.link') }}</span>
          <span class="us-pwrow"><input type="text" class="form-input us-mono" id="us-inv-link" readonly><button type="button" class="btn btn-sm btn-primary" data-copy="#us-inv-link">{{ t('common.copy') }}</button></span>
        </label>
        <p class="us-hint" id="us-inv-valid"></p>
