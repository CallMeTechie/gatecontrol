      <div class="st-timeline" id="st-au-timeline">
        <div class="st-tl-caption" id="st-au-caption"></div>
        <div class="st-tl-bar" aria-hidden="true"><div class="st-tl-win" id="st-au-win1"></div><div class="st-tl-win" id="st-au-win2" hidden></div><div class="st-tl-now" id="st-au-now"></div></div>
        <div class="st-tl-axis" aria-hidden="true"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
      </div>
    </div>
    {{ switchRow('st-au-mail', 'au-mail', t('st.au.mail'), t('st.au.mail_hint')) }}
    <div class="st-note st-note-warn st-note-row" id="st-au-waiting" hidden><span>{{ t('autoupdate.waiting_window_hint') }}</span><button type="button" class="st-btn st-btn-sm" id="st-au-trigger">{{ t('autoupdate.trigger') }}</button></div>
  </section>
  <section class="st-card" aria-labelledby="st-c-updatesh">
    {% call cardHead('st-c-updatesh', t('st.ush.title')) %}<p class="st-card-desc st-card-desc-side" id="st-ush-state"></p>{% endcall %}
    <div class="st-row">
      <div class="st-row-text"><span class="st-label">{{ t('st.ush.script') }}</span><span class="st-hint">{{ t('st.ush.script_hint') }}</span></div>
      <div class="st-row-ctl">
        <button type="button" class="st-btn" id="st-ush-show" aria-expanded="false" aria-controls="st-ush-cmds">{{ t('updatesh.show') }}</button>
        <a class="st-btn" href="/api/v1/system/update-sh" download>{{ t('st.ush.download') }}</a>
      </div>
    </div>
    <div class="st-cmds" id="st-ush-cmds" hidden>
      <p class="st-hint">{{ t('autoupdate.reinstall_hint') }}</p>
      <pre class="st-pre" id="st-ush-cmd">cd /opt/gatecontrol
curl -fsSLO https://raw.githubusercontent.com/CallMeTechie/gatecontrol/master/update.sh
chmod +x update.sh</pre>
      <div class="st-btnrow"><button type="button" class="st-btn st-btn-sm" id="st-ush-copy">{{ t('st.copy') }}</button></div>
      <p class="st-hint">{{ t('autoupdate.reinstall_cron') }}</p>
    </div>
