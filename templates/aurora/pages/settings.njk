  log: 'M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01',
  server: 'M4 5h16v6H4zM4 13h16v6H4zM8 8h.01M8 16h.01'
} %}
{% set navGroups = [
  { id: 'system', items: [['domains', ''], ['netzwerk', ''], ['daten', '']] },
  { id: 'security', items: [['anmeldung', ''], ['geraete', 'machine_binding'], ['ipsperre', ''], ['routenschutz', '']] },
  { id: 'clients', items: [['gruppen', ''], ['richtlinien', ''], ['splittunnel', 'split_tunnel_preset'], ['clientupdates', '']] },
  { id: 'notify', items: [['email', ''], ['benachrichtigungen', ''], ['webhooks', 'webhooks']] },
  { id: 'observe', items: [['monitoring', '']] },
  { id: 'integrations', items: [['pihole', 'pihole_integration'], ['geoip', ''], ['portal', '']] },
  { id: 'extensions', items: [['plugins', ''], ['ki', '']] },
  { id: 'maintenance', items: [['backup', ''], ['updates', ''], ['lizenz', ''], ['gefahr', '']] }
] %}
{% set piholeOn = has('pihole_integration') %}
{% set cur = stSection or 'start' %}
{%- macro secPath(id) -%}{{ '/settings' if id == 'start' else '/settings/' + id }}{%- endmacro -%}
{%- macro secAttrs(id) %} data-section="{{ id }}" aria-labelledby="st-h-{{ id }}" data-st-keywords="{{ t('st.kw.' + id) }}"{% if id != cur %} hidden{% endif %}{%- endmacro -%}

{% block content %}
{% include "partials/tls-i18n.njk" %}

<div class="pgx stx" id="st-page" data-section="{{ cur }}" data-user-2fa="{{ '1' if user.totp_enabled else '0' }}" data-base-url="{{ baseUrl }}"
  data-features='{"webhooks":{{ "true" if has("webhooks") else "false" }},"email_alerts":{{ "true" if has("email_alerts") else "false" }},"scheduled_backups":{{ "true" if has("scheduled_backups") else "false" }},"machine_binding":{{ "true" if has("machine_binding") else "false" }},"split_tunnel_preset":{{ "true" if has("split_tunnel_preset") else "false" }},"custom_dns":{{ "true" if has("custom_dns") else "false" }},"prometheus_metrics":{{ "true" if has("prometheus_metrics") else "false" }},"waf":{{ "true" if has("waf") else "false" }}}'>
  <div class="pgx-wrap stx-wrap">

    {#- The settings menu, like the plugin area's side navigation: search on top,
        "Übersicht" with the number of open points, groups, one link per
        section. On phones it is the list of areas of the start page. -#}
    <nav class="pgx-side stx-side" id="st-nav" aria-label="{{ t('st.nav_label') }}">
      <label class="stx-search">
        {{ ic(IC.search, 16) }}
        <input type="search" id="st-search" aria-label="{{ t('st.search_label') }}" placeholder="{{ t('st.search_ph') }}" autocomplete="off" spellcheck="false" aria-controls="st-nav">
      </label>
      <span class="st-sr" id="st-search-count" aria-live="polite"></span>
      <a class="pgx-sl stx-sl stx-sl-start" href="/settings" data-section="start"{% if cur == 'start' %} aria-current="page"{% endif %}>
        {{ ic(IC.start, 18) }}<span class="stx-sl-l">{{ t('st.nav.start') }}</span><span class="pgx-cnt" data-tone="warn" id="st-att-count" hidden></span>
      </a>
      {%- for g in navGroups %}
      <div class="stx-grp" data-group="{{ g.id }}">
        <span class="pgx-lbl" id="st-nav-g-{{ g.id }}">{{ t('st.group.' + g.id) }}</span>
        <ul class="stx-navlist" aria-labelledby="st-nav-g-{{ g.id }}">
          {%- for it in g.items %}{% if it[0] != 'pihole' or piholeOn %}
          <li><a class="pgx-sl stx-sl" href="{{ secPath(it[0]) }}" data-section="{{ it[0] }}"{% if it[0] == 'plugins' %} data-ext="1" data-st-keywords="{{ t('st.kw.plugins') }}"{% endif %}{% if it[0] == cur %} aria-current="page"{% endif %}>
            {{ ic(IC[it[0]], 18) }}
            <span class="stx-sl-l">{{ t('st.nav.' + it[0]) }}</span>
            {%- if it[1] %}<span class="st-pro stx-pro">{{ PRO }}</span>{% endif %}
            <span class="stx-dot" data-dot{{ '' if (it[0] == 'plugins' and pluginBadge > 0) else ' hidden' }}><span class="st-sr">{{ t('st.attention') }}</span></span>
            <span class="stx-state" data-state-of="{{ it[0] }}"></span>
            <span class="stx-chev">{{ ic(IC.next, 14) }}</span>
          </a></li>
          {%- endif %}{% endfor %}
        </ul>
      </div>
      {%- endfor %}
      <p class="stx-nav-empty" id="st-nav-empty" hidden>{{ t('st.search_none') }}</p>
    </nav>

    <div class="pgx-main stx-main" id="st-main">
      <a class="stx-back" href="/settings" id="st-back">{{ ic(IC.back, 16) }}{{ t('nav.settings') }}</a>

{# ══ Start (/settings) ═══════════════════════════════════════════════ #}
<section class="st-section stx-start"{{ secAttrs('start') }}>
  {% call pageHead('start', t('nav.settings'), t('st.start.status', { version: appVersion })) %}
    {%- if has('scheduled_backups') %}<button type="button" class="pgx-btn" id="st-start-backup">{{ ic(IC.backup) }}{{ t('st.start.backup_now') }}</button>{% endif %}
    <a class="pgx-btn pgx-btn-pri" href="/settings/updates" id="st-start-update" hidden>{{ ic(IC.updates) }}{{ t('st.start.update') }}</a>
  {% endcall %}

  <div class="pgx-stats stx-tiles" id="st-start-tiles">
    <a class="pgx-card pgx-stat stx-tile" href="#st-c-services" id="st-tile-services" data-tone="good">
      <span class="pgx-lbl">{{ t('st.tile.services') }}</span><b id="st-tile-services-v">–</b><span class="pgx-stat-d" id="st-tile-services-s">{{ t('st.services.checking') }}</span>
    </a>
    <a class="pgx-card pgx-stat stx-tile" href="/settings/domains" data-section-link="domains" id="st-tile-domains" data-tone="warn">
      <span class="pgx-lbl">{{ t('st.nav.domains') }}</span><b id="st-tile-domains-v">–</b><span class="pgx-stat-d" id="st-tile-domains-s"></span>
    </a>
    <a class="pgx-card pgx-stat stx-tile" href="/settings/backup" data-section-link="backup" id="st-tile-backup" data-tone="blue">
      <span class="pgx-lbl">{{ t('st.tile.backup') }}</span><b id="st-tile-backup-v">–</b><span class="pgx-stat-d" id="st-tile-backup-s"></span>
    </a>
    {%- set planLabel = t('license.plan_' + license.plan) if t('license.plan_' + license.plan) != 'license.plan_' + license.plan else (license.plan | replace('-', ' ') | title) %}
    {%- set expParts = (license.expires_at | string).split('T')[0].split('-') if license.expires_at else [] %}
    {%- set expDate = ((expParts[2] + '.' + expParts[1] + '.' + expParts[0]) if language == 'de' else expParts.join('-')) if expParts.length == 3 else '' %}
    <a class="pgx-card pgx-stat stx-tile stx-tile-text" href="/settings/lizenz" data-section-link="lizenz" id="st-tile-license" data-tone="violet">
      <span class="pgx-lbl">{{ t('st.nav.lizenz') }}</span><b>{{ planLabel }}</b><span class="pgx-stat-d">{{ t('st.lic.valid_until', { date: expDate }) if expDate else (t('st.tile.license_none') if license.unlicensed else t('st.tile.license_noexp')) }}</span>
    </a>
  </div>

  <section class="pgx-card stx-card stx-att-card" id="st-att-card" aria-labelledby="st-h-att">
    {% call cardHead('st-h-att', t('st.att.title')) %}<span class="stx-count" id="st-att-n">0</span>{% endcall %}
    <ul class="stx-rows" id="st-att-list" aria-labelledby="st-h-att"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>

  {#- The former section "Übersicht": services (restart / reload) and the server -#}
  <section class="pgx-card stx-card" aria-labelledby="st-c-services" id="st-services">
    {% call cardHead('st-c-services', t('st.services.title'), t('st.services.desc')) %}{% endcall %}
    <ul class="stx-rows">
      <li class="stx-row" id="st-svc-wg" data-state="unknown">
        <span class="pgx-ic" data-size="sm">{{ ic(IC.netzwerk, 18) }}</span>
        <span class="stx-nm"><b>WireGuard</b><small id="st-svc-wg-detail">{{ t('st.services.wg_detail', { port: wgPort, iface: wgInterface, ip: wgGatewayIp }) }}</small></span>
        <span class="st-pill" id="st-svc-wg-state">{{ t('st.services.checking') }}</span>
        <button type="button" class="pgx-btn pgx-btn-sm" id="st-wg-restart">{{ t('st.services.wg_restart') }}</button>
      </li>
      <li class="stx-row" id="st-svc-caddy" data-state="unknown">
        <span class="pgx-ic" data-size="sm">{{ ic(IC.domains, 18) }}</span>
        <span class="stx-nm"><b>Caddy</b><small id="st-svc-caddy-detail"></small></span>
        <span class="st-pill" id="st-svc-caddy-state">{{ t('st.services.checking') }}</span>
        <button type="button" class="pgx-btn pgx-btn-sm" id="st-caddy-reload">{{ t('st.services.caddy_reload') }}</button>
      </li>
    </ul>
    {{ readRow('st-r-name', t('st.server.name'), value=appName) }}
    {{ readRow('st-r-version', t('st.server.version'), mono=true, value='v' + appVersion) }}
    {{ readRow('st-r-endpoint', t('st.server.endpoint'), t('st.server.endpoint_hint'), mono=true, copyLabel=t('st.copy'), value=wgHost + ':' + wgPort) }}
    {{ readRow('st-r-subnet', t('st.server.subnet'), mono=true, value=wgSubnet) }}
    {{ readRow('st-r-lang', t('st.server.language'), t('st.server.language_hint'), value=t('st.lang.' + language)) }}
  </section>

  <section class="stx-all" aria-labelledby="st-h-all">
    <h3 class="pgx-h2" id="st-h-all">{{ t('st.all.title') }}</h3>
    <div class="stx-allgrid">
      {%- for g in navGroups %}
      <div class="pgx-card stx-allcard">
        <span class="stx-allt">{{ t('st.group.' + g.id) }}</span>
        <span class="stx-alld">{{ t('st.groupdesc.' + g.id) }}</span>
        {%- for it in g.items %}{% if it[0] != 'pihole' or piholeOn %}
        <a class="stx-alll" href="{{ secPath(it[0]) }}" data-section="{{ it[0] }}"{% if it[0] == 'plugins' %} data-ext="1"{% endif %}>
          <span class="stx-alll-l">{{ t('st.nav.' + it[0]) }}{% if it[1] %} <span class="st-pro stx-pro">{{ PRO }}</span>{% endif %}</span>
          <span class="stx-state" data-state-of="{{ it[0] }}"></span>{{ ic(IC.next, 14) }}
        </a>
        {%- endif %}{% endfor %}
      </div>
      {%- endfor %}
    </div>
  </section>
</section>

{# ══ System · Domains & Zertifikate ═══════════════════════════════════ #}
<section class="st-section"{{ secAttrs('domains') }}>
  {% call pageHead('domains', t('st.nav.domains'), t('st.desc.domains')) %}
    <button type="button" class="pgx-btn pgx-btn-pri" id="st-dom-addbtn" aria-expanded="false" aria-controls="st-dom-add">{{ ic(IC.plus) }}{{ t('st.domains.add') }}</button>
  {% endcall %}
  <div class="pgx-stats stx-tiles" id="st-dom-tiles">
    <div class="pgx-card pgx-stat stx-tile" data-tone="good"><span class="pgx-lbl">{{ t('st.domains.tile_verified') }}</span><b id="st-dom-t-ok">–</b><span class="pgx-stat-d">{{ t('st.domains.tile_verified_sub') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="warn"><span class="pgx-lbl">{{ t('st.domains.tile_pending') }}</span><b id="st-dom-t-pending">–</b><span class="pgx-stat-d" id="st-dom-t-pending-s"></span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="blue"><span class="pgx-lbl">{{ t('st.domains.tile_certs') }}</span><b id="st-dom-t-certs">–</b><span class="pgx-stat-d" id="st-dom-t-certs-s"></span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="violet"><span class="pgx-lbl">{{ t('st.domains.tile_server') }}</span><b class="pgx-mono stx-tile-mono" id="st-dom-t-ip">–</b><span class="pgx-stat-d" id="st-dom-t-ip-s"></span></div>
  </div>
  <section class="pgx-card stx-card" aria-labelledby="st-c-domains" id="card-domains">
    {% call cardHead('st-c-domains', t('st.domains.title'), t('st.domains.desc')) %}
      <div class="st-seg stx-filter" role="group" aria-label="{{ t('st.domains.filter') }}" id="st-dom-filter">
        <button type="button" class="st-seg-btn" data-value="all" aria-pressed="true">{{ t('st.domains.f_all') }} <em id="st-dom-f-all"></em></button>
        <button type="button" class="st-seg-btn" data-value="verified" aria-pressed="false">{{ t('st.domains.verified') }} <em id="st-dom-f-verified"></em></button>
        <button type="button" class="st-seg-btn" data-value="open" aria-pressed="false">{{ t('st.domains.pending') }} <em id="st-dom-f-open"></em></button>
      </div>
    {% endcall %}
    <form class="stx-add" id="st-dom-add" novalidate hidden>
      <label class="st-sr" for="st-dom-input">{{ t('st.domains.new') }}</label>
      <input type="text" class="st-input st-mono st-grow" id="st-dom-input" placeholder="{{ t('st.domains.new_ph') }}" maxlength="255" autocomplete="off" spellcheck="false" aria-describedby="st-dom-add-err">
      <button type="button" class="pgx-btn" data-add-cancel>{{ t('common.cancel') }}</button>
      <button type="submit" class="pgx-btn pgx-btn-pri">{{ t('st.add') }}</button>
      <span class="st-err st-err-block" id="st-dom-add-err" role="alert" hidden></span>
    </form>
    <div class="st-note st-note-warn" id="st-dom-ipwarn" hidden>{{ t('settings.domains.server_ip_warning') }}</div>
    <ul class="st-list" id="st-dom-list" aria-label="{{ t('st.domains.title') }}"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-acme">
    {% call cardHead('st-c-acme', t('st.acme.title'), t('st.acme.desc')) %}{% endcall %}
    {{ textRow('st-acme', 'acme-email', t('st.acme.email'), t('st.acme.email_hint'), type='email', placeholder=t('st.acme.email_ph'), maxlength=254) }}
    {{ numRow('st-tls-attempts', 'tls-attempts', t('st.acme.attempts'), t('st.acme.attempts_hint'), t('st.unit.attempts'), 0, 10) }}
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-serverip">
    {% call cardHead('st-c-serverip', t('st.serverip.title'), t('st.serverip.desc')) %}{% endcall %}
    {{ readRow('st-r-ip4', t('st.serverip.detected4'), mono=true, value='—') }}
    {{ readRow('st-r-ip6', t('st.serverip.detected6'), mono=true, value='—') }}
    {{ textRow('st-srv-ip', 'srv-ip', t('st.serverip.override4'), placeholder=t('st.serverip.auto'), mono=true, maxlength=64) }}
    {{ textRow('st-srv-ip6', 'srv-ip6', t('st.serverip.override6'), t('settings.tls.server_ipv6_hint'), placeholder=t('st.serverip.auto'), mono=true, maxlength=64) }}
  </section>
</section>

{# ══ System · VPN & Netzwerk ══════════════════════════════════════════ #}
<section class="st-section"{{ secAttrs('netzwerk') }}>
  {% call pageHead('netzwerk', t('st.nav.netzwerk'), t('st.status.netzwerk', { port: wgPort, subnet: wgSubnet })) %}{% endcall %}
  <section class="pgx-card stx-card" aria-labelledby="st-c-vpn">
    {% call cardHead('st-c-vpn', t('st.vpn.title'), t('st.vpn.desc')) %}{% endcall %}
    {{ textRow('st-dns', 'dns', t('st.vpn.dns'), t('st.vpn.dns_hint'), placeholder=t('peers.dns_placeholder'), mono=true, chip=PRO, disabled=not has('custom_dns'), maxlength=255) }}
    {% if not has('custom_dns') %}{{ lockNote('custom_dns') }}{% endif %}
    {{ numRow('st-peer-timeout', 'peer-timeout', t('st.vpn.timeout'), t('st.vpn.timeout_hint'), t('st.unit.seconds'), 30, 600) }}
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-block">
    {% call cardHead('st-c-block', t('st.block.title'), t('st.block.desc')) %}{% endcall %}
    {{ segRow('st-rb-action', 'rb-action', t('st.block.action'), [['not_found', t('st.block.not_found')], ['custom', t('st.block.custom')], ['redirect', t('st.block.redirect')], ['empty', t('st.block.empty')]]) }}
    <div data-st-show="rb-action=redirect">{{ textRow('st-rb-url', 'rb-url', t('st.block.url'), t('st.block.url_hint'), type='url', placeholder=t('st.block.url_ph'), mono=true, maxlength=2048) }}</div>
    <div class="st-row st-row-stack" data-st-row="rb-body" data-st-show="rb-action=custom">
      {{ rowText('st-rb-body', t('st.block.body'), t('st.block.body_hint'), '', true) }}
      <textarea class="st-textarea st-mono" id="st-rb-body" data-st-field="rb-body" rows="5" maxlength="16384" spellcheck="false" placeholder="{{ t('routes.block_body_ph') }}" aria-describedby="st-rb-body-hint st-rb-body-err"></textarea>
    </div>
  </section>
</section>

{# ══ System · Daten & Aufbewahrung ════════════════════════════════════ #}
<section class="st-section"{{ secAttrs('daten') }}>
  {% call pageHead('daten', t('st.nav.daten'), t('st.desc.daten')) %}{% endcall %}
  <section class="pgx-card stx-card" aria-labelledby="st-c-retention">
    {% call cardHead('st-c-retention', t('st.retention.title'), t('st.retention.desc')) %}{% endcall %}
    {{ numRow('st-ret-traffic', 'ret-traffic', t('st.retention.traffic'), t('st.range', { min: 1, max: 365 }), t('st.unit.days'), 1, 365) }}
    {{ numRow('st-ret-activity', 'ret-activity', t('st.retention.activity'), t('st.range', { min: 1, max: 365 }), t('st.unit.days'), 1, 365) }}
    {{ numRow('st-ret-waf', 'ret-waf', t('st.retention.waf'), t('st.retention.waf_hint'), t('st.unit.days'), 1, 365, chip=PRO, disabled=not has('waf')) }}
  </section>
  <p class="stx-box" data-tone="info">{{ t('st.retention.clear_moved') }} <a href="/settings/gefahr" data-section-link="gefahr">{{ t('st.nav.gefahr') }}</a></p>
</section>

{# ══ Sicherheit · Anmeldung & Konten ══════════════════════════════════ #}
<section class="st-section"{{ secAttrs('anmeldung') }}>
  {% call pageHead('anmeldung', t('st.nav.anmeldung'), t('st.desc.anmeldung')) %}{% endcall %}
  <section class="pgx-card stx-card" aria-labelledby="st-c-2fa">
    {% call cardHead('st-c-2fa', t('st.twofa.title'), t('st.twofa.desc')) %}{% endcall %}
    {{ switchRow('st-req2fa', 'req2fa', t('two_fa.settings_require'), t('two_fa.settings_require_hint')) }}
    <div class="st-note" id="st-2fa-self">{{ t('st.twofa.self_ok') if user.totp_enabled else t('two_fa.settings_self_warning') }}</div>
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-lockout">
    {% call cardHead('st-c-lockout', t('st.lockout.title'), t('st.lockout.desc')) %}{% endcall %}
    {{ switchRow('st-lock-on', 'lock-on', t('st.lockout.enabled')) }}
    {{ numRow('st-lock-attempts', 'lock-attempts', t('st.lockout.attempts'), t('st.lockout.attempts_hint'), t('st.unit.attempts'), 1, 100) }}
    {{ numRow('st-lock-minutes', 'lock-minutes', t('st.lockout.duration'), t('st.range', { min: 1, max: 1440 }), t('st.unit.minutes'), 1, 1440) }}
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-locked">
    {% call cardHead('st-c-locked', t('st.lockout.locked'), t('st.lockout.locked_desc')) %}{% endcall %}
    <ul class="st-list" id="st-locked" aria-live="polite"><li class="st-empty">{{ t('security.lockout.no_locked') }}</li></ul>
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-pw">
    {% call cardHead('st-c-pw', t('st.pw.title'), t('st.pw.desc')) %}{% endcall %}
    {{ switchRow('st-pw-on', 'pw-on', t('st.pw.enabled'), t('st.pw.enabled_hint')) }}
    {{ numRow('st-pw-len', 'pw-len', t('security.password.min_length'), t('st.range', { min: 4, max: 128 }), t('st.unit.chars'), 4, 128) }}
    {{ switchRow('st-pw-upper', 'pw-upper', t('security.password.require_uppercase')) }}
    {{ switchRow('st-pw-number', 'pw-number', t('security.password.require_number')) }}
    {{ switchRow('st-pw-special', 'pw-special', t('security.password.require_special')) }}
  </section>
</section>

{# ══ Sicherheit · Gerätebindung ═══════════════════════════════════════ #}
<section class="st-section"{{ secAttrs('geraete') }}>
  {% call pageHead('geraete', t('st.nav.geraete'), t('security.machine_binding.description')) %}{% endcall %}
  <section class="pgx-card stx-card" aria-labelledby="st-c-mb" id="machine-binding-card">
    {% call cardHead('st-c-mb', t('st.mb.title'), t('st.mb.desc'), PRO) %}{% endcall %}
    {% if not has('machine_binding') %}{{ lockNote('machine_binding') }}{% endif %}
    {{ segRow('st-mb-mode', 'mb-mode', t('security.machine_binding.mode'), [['off', t('security.machine_binding.mode_off')], ['global', t('security.machine_binding.mode_global')], ['individual', t('security.machine_binding.mode_individual')]], t('st.mb.mode_hint'), disabled=not has('machine_binding')) }}
  </section>
  <div class="stx-box" data-tone="info">
    <ul class="stx-facts" id="st-mb-facts">
      <li>{{ t('st.mb.note') }}</li>
      <li>{{ t('st.mb.not_peer') }}</li>
      <li>{{ t('st.mb.users_hint') }} <a href="/users" id="st-mb-users-link">{{ t('st.mb.users_link') }}</a></li>
      <li>{{ t('st.mb.clients') }}</li>
    </ul>
  </div>
</section>

{# ══ Sicherheit · IP-Sperre (services/ipBlock.js, public/js/settings-security.js) ═══ #}
<section class="st-section"{{ secAttrs('ipsperre') }}>
  {% set listsOn = has('ip_blocklists') %}
  {% call pageHead('ipsperre', t('st.nav.ipsperre'), t('st.desc.ipsperre')) %}
    <button type="button" class="pgx-btn" id="ipb-ban-open" aria-expanded="false" aria-controls="ipb-ban-add">{{ t('st.ipb.ban_by_hand') }}</button>
  {% endcall %}
  <div class="stx-box" data-tone="warn" id="ipb-engine" hidden>{{ t('st.ipb.engine_missing') }}</div>
  <div class="pgx-stats stx-tiles" id="ipb-tiles">
    <div class="pgx-card pgx-stat stx-tile" data-tone="crit"><span class="pgx-lbl">{{ t('st.ipb.tile_now') }}</span><b id="ipb-t-now">–</b><span class="pgx-stat-d" id="ipb-t-now-s"></span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="warn"><span class="pgx-lbl">{{ t('st.ipb.tile_failures') }}</span><b id="ipb-t-fail">–</b><span class="pgx-stat-d" id="ipb-t-fail-s"></span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="blue"><span class="pgx-lbl">{{ t('st.ipb.tile_lists') }}</span><b id="ipb-t-lists">–</b><span class="pgx-stat-d" id="ipb-t-lists-s">{{ t('st.ipb.tile_lists_sub') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="good"><span class="pgx-lbl">{{ t('st.ipb.tile_exceptions') }}</span><b id="ipb-t-ex">–</b><span class="pgx-stat-d" id="ipb-t-ex-s"></span></div>
  </div>

  <div class="pgx-cols stx-cols">
    <div class="pgx-colm">
    <section class="pgx-card stx-card" aria-labelledby="ipb-c-now">
      {% call cardHead('ipb-c-now', t('st.ipb.now_title'), t('st.ipb.now_desc')) %}
        <a class="pgx-a" href="/logs#events?range=7d&amp;level=error,warn,info&amp;source=activity&amp;q=ip_blocked">{{ t('st.ipb.in_logs') }}</a>
      {% endcall %}
      <form class="stx-add stx-add-grid" id="ipb-ban-add" novalidate hidden>
        <div class="st-fl st-fl-2"><label class="st-fl-label" for="ipb-ban-ip">{{ t('st.ipb.ban_ip') }}</label><input type="text" class="st-input st-mono" id="ipb-ban-ip" maxlength="64" placeholder="203.0.113.7 · 198.51.100.0/24" autocomplete="off" spellcheck="false" aria-describedby="ipb-ban-err"></div>
        <div class="st-fl"><label class="st-fl-label" for="ipb-ban-hours">{{ t('st.ipb.ban_for') }}</label>
          <select class="st-select" id="ipb-ban-hours"><option value="1">{{ t('st.ipb.h1') }}</option><option value="24" selected>{{ t('st.ipb.h24') }}</option><option value="168">{{ t('st.ipb.h168') }}</option><option value="720">{{ t('st.ipb.h720') }}</option><option value="">{{ t('st.ipb.permanent') }}</option></select></div>
        <div class="st-fl st-fl-2"><label class="st-fl-label" for="ipb-ban-note">{{ t('st.ipb.ban_note') }}</label><input type="text" class="st-input" id="ipb-ban-note" maxlength="120" placeholder="{{ t('st.optional') }}" autocomplete="off"></div>
        <div class="stx-add-acts"><button type="button" class="pgx-btn" data-add-cancel>{{ t('common.cancel') }}</button><button type="submit" class="pgx-btn pgx-btn-pri">{{ t('st.ipb.ban_do') }}</button></div>
        <span class="st-err st-err-block" id="ipb-ban-err" role="alert" hidden></span>
      </form>
      <ul class="stx-rows" id="ipb-bans" aria-labelledby="ipb-c-now" aria-live="polite"><li class="st-empty">{{ t('common.loading') }}</li></ul>
    </section>
    </div>
    <aside class="pgx-aside stx-aside" aria-label="{{ t('st.ipb.never_title') }}">
      <section class="pgx-card stx-card" aria-labelledby="ipb-c-never">
        {% call cardHead('ipb-c-never', t('st.ipb.never_title')) %}
          <button type="button" class="pgx-btn pgx-btn-sm" id="ipb-never-open" aria-expanded="false" aria-controls="ipb-never-add">{{ ic(IC.plus, 14) }}{{ t('st.add') }}</button>
        {% endcall %}
        <form class="stx-add" id="ipb-never-add" novalidate hidden>
          <label class="st-sr" for="ipb-never-ip">{{ t('st.ipb.never_ip') }}</label>
          <input type="text" class="st-input st-mono st-grow" id="ipb-never-ip" maxlength="64" placeholder="192.168.178.0/24" autocomplete="off" spellcheck="false" aria-describedby="ipb-never-err">
          <label class="st-sr" for="ipb-never-label">{{ t('st.ipb.never_label') }}</label>
          <input type="text" class="st-input st-grow" id="ipb-never-label" maxlength="60" placeholder="{{ t('st.ipb.never_label') }}" autocomplete="off">
          <div class="stx-add-acts"><button type="button" class="pgx-btn" data-add-cancel>{{ t('common.cancel') }}</button><button type="submit" class="pgx-btn pgx-btn-pri">{{ t('st.add') }}</button></div>
          <span class="st-err st-err-block" id="ipb-never-err" role="alert" hidden></span>
        </form>
        <ul class="stx-rows" id="ipb-never" aria-labelledby="ipb-c-never"></ul>
      </section>
      <p class="stx-box" data-tone="info"><b>{{ t('st.ipb.proxy_title') }}</b> {{ t('st.ipb.proxy') }}</p>
    </aside>
  </div>

  <section class="pgx-card stx-card" aria-labelledby="ipb-c-when">
    {% call cardHead('ipb-c-when', t('st.ipb.when_title'), t('st.ipb.when_desc')) %}{% endcall %}
    {{ switchRow('ipb-enabled', 'ipb-enabled', t('st.ipb.enabled'), t('st.ipb.enabled_hint')) }}
    <div class="st-row" data-st-row="ipb-threshold">
      {{ rowText('ipb-threshold', t('st.ipb.threshold'), t('st.ipb.threshold_hint'), '', true) }}
      <div class="st-row-ctl">
        <input type="number" class="st-input st-input-num" id="ipb-threshold" data-st-field="ipb-threshold" min="3" max="1000" step="1" inputmode="numeric" autocomplete="off" aria-describedby="ipb-threshold-hint ipb-threshold-err">
        <span class="st-unit">{{ t('st.ipb.within') }}</span>
        <select class="st-select ipb-window" id="ipb-window" data-st-field="ipb-window" aria-label="{{ t('st.ipb.window') }}"><option value="10">{{ t('st.ipb.min10') }}</option><option value="60">{{ t('st.ipb.min60') }}</option></select>
      </div>
    </div>
    <div class="st-row st-row-read">
      <div class="st-row-text"><span class="st-label" id="ipb-dur-label">{{ t('st.ipb.duration') }}</span><span class="st-hint">{{ t('st.ipb.duration_hint') }}</span></div>
      <div class="st-row-ctl" role="group" aria-labelledby="ipb-dur-label"><span class="ipb-chip">{{ t('st.ipb.d10') }}</span><span class="st-unit" aria-hidden="true">›</span><span class="ipb-chip">{{ t('st.ipb.d60') }}</span><span class="st-unit" aria-hidden="true">›</span><span class="ipb-chip">{{ t('st.ipb.d1440') }}</span></div>
    </div>
    {{ switchRow('ipb-notify', 'ipb-notify', t('st.ipb.notify'), t('st.ipb.notify_hint')) }}
  </section>

  <section class="pgx-card stx-card" aria-labelledby="ipb-c-count">
    {% call cardHead('ipb-c-count', t('st.ipb.count_title'), t('st.ipb.count_desc')) %}{% endcall %}
    {% for src in ['login', 'route_auth', 'share_link', 'waf', 'scan', 'rate_limit'] %}
    {{ switchRow('ipb-src-' + src, 'ipb-src-' + src, t('st.ipb.src.' + src), t('st.ipb.src.' + src + '_hint')) }}
    {% endfor %}
  </section>

  <section class="pgx-card stx-card" aria-labelledby="ipb-c-lists" id="ipb-lists-card">
    {% call cardHead('ipb-c-lists', t('st.ipb.lists_title'), t('st.ipb.lists_desc'), PRO) %}
      <button type="button" class="pgx-btn pgx-btn-sm" id="ipb-refresh"{% if not listsOn %} disabled{% endif %}>{{ t('st.ipb.refresh') }}</button>
    {% endcall %}
    {% if not listsOn %}{{ lockNote('ip_blocklists') }}{% endif %}
    {% for l in ['drop', 'attackers', 'tor'] %}
    <div class="st-row" data-st-row="ipb-list-{{ l }}">
      {{ rowText('ipb-list-' + l, t('st.ipb.list.' + l), t('st.ipb.list.' + l + '_hint'), '', true) }}
      <div class="st-row-ctl">
        <button type="button" class="st-switch" role="switch" aria-checked="false" id="ipb-list-{{ l }}" data-st-field="ipb-list-{{ l }}" aria-describedby="ipb-list-{{ l }}-hint ipb-list-{{ l }}-meta ipb-list-{{ l }}-err"{% if not listsOn %} disabled{% endif %}><span class="st-knob" aria-hidden="true"></span></button>
        <span class="st-unit st-mono ipb-list-meta" id="ipb-list-{{ l }}-meta">–</span>
      </div>
    </div>
    {% endfor %}
    <p class="stx-msg" id="ipb-lists-msg" role="status"></p>
    <p class="stx-msg">{{ t('st.ipb.lists_sources') }}</p>
  </section>
</section>

{# ══ Sicherheit · Routenschutz (services/routeGuard.js, vpnGuard.js) ═══ #}
<section class="st-section"{{ secAttrs('routenschutz') }}>
  {% call pageHead('routenschutz', t('st.nav.routenschutz'), t('st.desc.routenschutz')) %}
    <a class="pgx-btn" href="/routes">{{ t('st.rg.to_routes') }}</a>
  {% endcall %}
  <div class="pgx-stats stx-tiles" id="rg-tiles">
    <div class="pgx-card pgx-stat stx-tile" data-tone="good"><span class="pgx-lbl">{{ t('st.rg.tile_vpn') }}</span><b id="rg-t-vpn">–</b><span class="pgx-stat-d">{{ t('st.rg.tile_vpn_sub') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="blue"><span class="pgx-lbl">{{ t('st.rg.tile_login') }}</span><b id="rg-t-login">–</b><span class="pgx-stat-d">{{ t('st.rg.tile_login_sub') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="warn" id="rg-t-open-tile"><span class="pgx-lbl">{{ t('st.rg.tile_open') }}</span><b id="rg-t-open">–</b><span class="pgx-stat-d">{{ t('st.rg.tile_open_sub') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="violet"><span class="pgx-lbl">{{ t('st.rg.tile_waf') }}</span><b id="rg-t-waf">–</b><span class="pgx-stat-d" id="rg-t-waf-s"></span></div>
  </div>

  <section class="pgx-card stx-card stx-att-card" aria-labelledby="rg-c-att" id="rg-att-card">
    {% call cardHead('rg-c-att', t('st.att.title')) %}<span class="stx-count" id="rg-att-n">0</span>{% endcall %}
    <ul class="stx-rows" id="rg-att" aria-labelledby="rg-c-att" aria-live="polite"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>

  <section class="pgx-card stx-card" aria-labelledby="rg-c-all">
    {% call cardHead('rg-c-all', t('st.rg.all_title'), t('st.rg.all_desc')) %}
