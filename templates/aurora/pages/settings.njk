{# ── Dialog: off-site target. Type cards first, then the fields of that
   type (data-for), the gateway L4 picker (SFTP/SMB), the SSH key (SFTP). ── #}
<div class="modal-overlay st-modal" id="st-ot-modal" style="display:none">
  <div class="modal modal-xl" role="dialog" aria-modal="true" aria-labelledby="st-ot-title" aria-describedby="st-ot-sub">
    <div class="modal-head">
      <div><span class="modal-title" id="st-ot-title" data-add="{{ t('st.ot.add') }}" data-edit="{{ t('offsite.dlg_edit') }}">{{ t('st.ot.add') }}</span><small class="st-dlg-sub" id="st-ot-sub">{{ t('st.ot.sub') }}</small></div>
      <button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button>
    </div>
    <form class="modal-body st-dlg" id="st-ot-form" novalidate autocomplete="off">
      <fieldset class="st-fieldset">
        <legend class="st-fl-label" id="st-ot-type-label">{{ t('st.ot.type') }}</legend>
        <div class="st-typecards" role="group" aria-labelledby="st-ot-type-label">
          {%- for ty in [['sftp', 'SFTP', t('st.ot.type_sftp')], ['smb', 'SMB', t('st.ot.type_smb')], ['s3', 'S3', t('st.ot.type_s3')], ['webdav', 'WebDAV', t('st.ot.type_webdav')]] %}
          <button type="button" class="st-typecard" data-type="{{ ty[0] }}" aria-pressed="false"><b>{{ ty[1] }}</b><small>{{ ty[2] }}</small></button>
          {%- endfor %}
        </div>
        <span class="st-hint" id="st-ot-type-hint">{{ t('st.ot.type_hint') }}</span>
      </fieldset>
      <div class="st-grid2">
        <div class="st-fl st-span2"><label class="st-fl-label" for="st-ot-name">{{ t('offsite.f_name') }}</label><input type="text" class="st-input" id="st-ot-name" maxlength="64" placeholder="{{ t('offsite.f_name_ph') }}"></div>
        <div class="st-fl st-span2" data-for="webdav"><label class="st-fl-label" for="st-ot-url">{{ t('offsite.field.url') }}</label><input type="url" class="st-input st-mono" id="st-ot-url" maxlength="2048" placeholder="https://cloud.example.com/remote.php/dav/files/alice/gatecontrol/" spellcheck="false"><span class="st-hint">{{ t('offsite.f_url_hint') }}</span></div>
        <div class="st-fl st-span2" data-for="s3"><label class="st-fl-label" for="st-ot-endpoint">{{ t('offsite.f_endpoint') }}</label><input type="url" class="st-input st-mono" id="st-ot-endpoint" maxlength="2048" placeholder="https://s3.eu-central-1.wasabisys.com" spellcheck="false"><span class="st-hint">{{ t('offsite.f_endpoint_hint') }}</span></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-bucket">{{ t('offsite.field.bucket') }}</label><input type="text" class="st-input st-mono" id="st-ot-bucket" maxlength="63" spellcheck="false"></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-region">{{ t('offsite.field.region') }}</label><input type="text" class="st-input st-mono" id="st-ot-region" maxlength="32" placeholder="us-east-1" spellcheck="false"></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-akid">{{ t('offsite.field.access_key_id') }}</label><input type="text" class="st-input st-mono" id="st-ot-akid" maxlength="128" spellcheck="false"></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-secret">{{ t('offsite.field.secret_access_key') }}</label><input type="password" class="st-input st-mono" id="st-ot-secret" maxlength="1024" autocomplete="new-password" spellcheck="false"><span class="st-hint" id="st-ot-secret-hint" hidden>{{ t('offsite.secret_kept') }}</span></div>
        <div class="st-fl st-span2" data-for="s3"><label class="st-fl-label" for="st-ot-prefix">{{ t('offsite.f_prefix') }}</label><input type="text" class="st-input st-mono" id="st-ot-prefix" maxlength="255" placeholder="gatecontrol" spellcheck="false"></div>
        <label class="st-check st-span2" data-for="s3"><input type="checkbox" id="st-ot-pathstyle"> <span>{{ t('offsite.f_path_style') }}</span></label>
        <div class="st-fl" data-for="sftp smb"><label class="st-fl-label" for="st-ot-host">{{ t('offsite.field.host') }}</label><input type="text" class="st-input st-mono" id="st-ot-host" maxlength="253" placeholder="nas.example.com" spellcheck="false"></div>
        <div class="st-fl" data-for="sftp smb"><label class="st-fl-label" for="st-ot-port">{{ t('offsite.field.port') }}</label><input type="number" class="st-input st-mono" id="st-ot-port" min="1" max="65535"></div>
        <div class="st-fl" data-for="smb"><label class="st-fl-label" for="st-ot-share">{{ t('offsite.field.share') }}</label><input type="text" class="st-input st-mono" id="st-ot-share" maxlength="80" placeholder="backup" spellcheck="false"></div>
        <div class="st-fl" data-for="sftp smb"><label class="st-fl-label" for="st-ot-path">{{ t('offsite.f_path') }}</label><input type="text" class="st-input st-mono" id="st-ot-path" maxlength="255" placeholder="gatecontrol" spellcheck="false"></div>
        <div class="st-fl" data-for="sftp smb webdav"><label class="st-fl-label" for="st-ot-user">{{ t('offsite.field.username') }}</label><input type="text" class="st-input st-mono" id="st-ot-user" maxlength="128" spellcheck="false"></div>
        <div class="st-fl" data-for="smb webdav"><label class="st-fl-label" for="st-ot-pw">{{ t('offsite.field.password') }}</label><input type="password" class="st-input" id="st-ot-pw" maxlength="1024" autocomplete="new-password"><span class="st-hint" id="st-ot-pw-hint" hidden>{{ t('offsite.secret_kept') }}</span></div>
        <label class="st-check st-span2" id="st-ot-clearpw-row" data-for="smb webdav" hidden><input type="checkbox" id="st-ot-clearpw"> <span>{{ t('offsite.f_clear_password') }}</span></label>
        <div class="st-fl" data-for="smb"><label class="st-fl-label" for="st-ot-domain">{{ t('offsite.f_domain') }}</label><input type="text" class="st-input st-mono" id="st-ot-domain" maxlength="64" placeholder="WORKGROUP" spellcheck="false"></div>
      </div>
      <div class="st-panel" data-for="sftp smb">
        <label class="st-label" for="st-ot-l4">{{ t('st.ot.l4_title') }}</label>
        <span class="st-hint">{{ t('st.ot.l4_hint') }}</span>
        <select class="st-select st-w-full" id="st-ot-l4"><option value="">{{ t('st.ot.l4_none') }}</option></select>
        <span class="st-hint" id="st-ot-l4-note" aria-live="polite" hidden></span>
      </div>
      <div class="st-panel" data-for="sftp">
        <span class="st-label" id="st-ot-key-label">{{ t('offsite.key_title') }}</span>
        <span class="st-hint">{{ t('offsite.key_hint') }}</span>
        <textarea class="st-textarea st-mono st-key" id="st-ot-pubkey" rows="2" readonly spellcheck="false" aria-labelledby="st-ot-key-label"></textarea>
        <div class="st-btnrow"><button type="button" class="st-btn st-btn-sm" id="st-ot-keycopy">{{ t('st.copy') }}</button><button type="button" class="st-btn st-btn-sm st-btn-danger" id="st-ot-keyrotate">{{ t('st.ot.key_rotate') }}</button></div>
        <span class="st-hint">{{ t('offsite.key_hostkey_note') }}</span>
      </div>
      <div class="st-formline st-formline-end">
        <div class="st-fl"><label class="st-fl-label" for="st-ot-keep">{{ t('offsite.f_keep') }}</label><input type="number" class="st-input st-input-num" id="st-ot-keep" min="1" max="365" value="14" aria-describedby="st-ot-keep-hint"><span class="st-hint" id="st-ot-keep-hint">{{ t('offsite.f_keep_hint') }}</span></div>
        <label class="st-check"><input type="checkbox" id="st-ot-enabled" checked> <span>{{ t('st.ot.enabled') }}</span></label>
      </div>
      <div class="st-err st-err-block" id="st-ot-err" role="alert" hidden></div>
    </form>
    <div class="modal-foot">
      <span class="st-foot-msg st-foot-left">{{ t('st.ot.save_note') }}</span>
      <button type="button" class="st-btn st-btn-ghost" data-close-modal>{{ t('common.cancel') }}</button>
      <button type="button" class="st-btn st-btn-primary" id="st-ot-save">{{ t('st.ot.save') }}</button>
    </div>
  </div>
</div>

{# ── Dialog: Pi-hole instance ─────────────────────────────────────── #}
{% if piholeOn %}
<div class="modal-overlay st-modal" id="st-ph-modal" style="display:none">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="st-ph-title">
    <div class="modal-head">
      <span class="modal-title" id="st-ph-title" data-add="{{ t('pihole.cfg.add_instance') }}" data-edit="{{ t('st.ph.edit') }}">{{ t('pihole.cfg.add_instance') }}</span>
      <button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button>
    </div>
    <form class="modal-body st-dlg" id="st-ph-form" novalidate autocomplete="off">
      <div class="st-fl"><label class="st-fl-label" for="st-ph-label">{{ t('pihole.cfg.label') }}</label><input type="text" class="st-input" id="st-ph-label" maxlength="100"></div>
      <div class="st-fl"><label class="st-fl-label" for="st-ph-url">{{ t('pihole.cfg.url') }}</label><input type="url" class="st-input st-mono" id="st-ph-url" placeholder="http://10.8.0.5:8080" spellcheck="false" aria-describedby="st-ph-url-err"><span class="st-err" id="st-ph-url-err" role="alert" hidden></span></div>
      <div class="st-grid2">
        <div class="st-fl"><label class="st-fl-label" for="st-ph-dns">{{ t('pihole.cfg.dns_ip') }}</label><input type="text" class="st-input st-mono" id="st-ph-dns" placeholder="10.8.0.5" spellcheck="false"></div>
        <div class="st-fl"><label class="st-fl-label" for="st-ph-dnsport">{{ t('pihole.cfg.dns_port') }}</label><input type="number" class="st-input st-mono" id="st-ph-dnsport" min="1" max="65535" value="53" aria-describedby="st-ph-dnsport-hint"><span class="st-hint" id="st-ph-dnsport-hint">{{ t('pihole.cfg.dns_port_hint') }}</span></div>
      </div>
      <div class="st-fl"><label class="st-fl-label" for="st-ph-pw">{{ t('pihole.cfg.password') }}</label><input type="password" class="st-input" id="st-ph-pw" autocomplete="new-password" aria-describedby="st-ph-pw-hint"><span class="st-hint" id="st-ph-pw-hint" hidden>{{ t('pihole.cfg.password_keep_hint') }}</span></div>
      <label class="st-check"><input type="checkbox" id="st-ph-tls" checked> <span>{{ t('pihole.cfg.tls') }}</span></label>
      <div class="st-note" id="st-ph-testmsg" role="status" hidden></div>
    </form>
    <div class="modal-foot">
      <button type="button" class="st-btn st-btn-danger st-foot-left" id="st-ph-delete" hidden>{{ t('st.ph.delete') }}</button>
      <button type="button" class="st-btn" id="st-ph-test">{{ t('pihole.cfg.test_connection') }}</button>
      <button type="button" class="st-btn st-btn-primary" id="st-ph-save">{{ t('common.save') }}</button>
    </div>
  </div>
</div>
{% endif %}

{# ── Dialog: stop WireGuard (admin password) ─────────────────────── #}
<div class="modal-overlay st-modal" id="st-wgstop-modal" style="display:none">
  <div class="modal modal-sm" role="dialog" aria-modal="true" aria-labelledby="st-wgstop-title" aria-describedby="st-wgstop-text">
    <div class="modal-head"><span class="modal-title" id="st-wgstop-title">{{ t('config.stop_confirm_title') }}</span><button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button></div>
    <form class="modal-body st-dlg" id="st-wgstop-form" novalidate>
      <p class="st-dlg-text" id="st-wgstop-text">{{ t('config.stop_confirm_text') }}</p>
      <div class="st-fl"><label class="st-fl-label" for="st-wgstop-pw">{{ t('st.danger.password') }}</label><input type="password" class="st-input" id="st-wgstop-pw" autocomplete="current-password" aria-describedby="st-wgstop-err"><span class="st-err" id="st-wgstop-err" role="alert" hidden></span></div>
    </form>
    <div class="modal-foot"><button type="button" class="st-btn st-btn-ghost" data-close-modal>{{ t('common.cancel') }}</button><button type="button" class="st-btn st-btn-danger" id="st-wgstop-go">{{ t('st.danger.wg_stop_confirm') }}</button></div>
  </div>
</div>

