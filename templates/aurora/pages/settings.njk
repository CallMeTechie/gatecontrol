</section>

{# ══ Wartung · Lizenz ═════════════════════════════════════════════════ #}
<section class="st-section" data-section="lizenz" aria-labelledby="st-h-lizenz" data-st-keywords="{{ t('st.kw.lizenz') }}" hidden>
  <div class="st-sec-head"><h2 class="st-sec-title" id="st-h-lizenz" tabindex="-1">{{ t('st.nav.lizenz') }}</h2><p class="st-sec-desc">{{ t('st.desc.lizenz') }}</p></div>
  <section class="st-card" aria-label="{{ t('st.lic.plan') }}">
    <div class="st-plan">
      {%- set planLabel = t('license.plan_' + license.plan) if t('license.plan_' + license.plan) != 'license.plan_' + license.plan else (license.plan | replace('-', ' ') | title) %}
      <div class="st-plan-mark" aria-hidden="true">{{ planLabel | first | upper }}</div>
      <div class="st-plan-text">
        <div class="st-plan-name">{{ planLabel }}</div>
        <div class="st-plan-meta">
          {%- set expParts = (license.expires_at | string).split('T')[0].split('-') if license.expires_at else [] %}
          {%- set expDate = ((expParts[2] + '.' + expParts[1] + '.' + expParts[0]) if language == 'de' else expParts.join('-')) if expParts.length == 3 else '' %}
          {%- set updParts = (license.updates_until | string).split('T')[0].split('-') if license.updates_until else [] %}
          {%- set updDate = ((updParts[2] + '.' + updParts[1] + '.' + updParts[0]) if language == 'de' else updParts.join('-')) if updParts.length == 3 else '' %}
          {%- set meta = [
            t('st.lic.valid_until', { date: expDate }) if expDate else '',
            t('st.lic.updates_until', { date: updDate }) if updDate else '',
            t('st.lic.activations', { n: license.activations, max: license.max_activations }) if license.activations else '',
            t('st.lic.key', { key: license.license_key_masked }) if license.license_key_masked else ''
          ] | select | join(' · ') -%}
          {{ meta if meta else (t('license.unlicensed_banner') if license.unlicensed else (t('license.community_hint') if license.plan == 'community' else '')) }}
        </div>
        {%- if license.verification %}
        <div class="st-plan-meta st-lic-verify" id="st-lic-verify" data-verification="{{ license.verification }}">{{ t('st.lic.verify_' + license.verification) }}</div>
        {%- endif %}
      </div>
      {%- if license.license_key_masked %}<button type="button" class="st-btn" id="st-lic-refresh">{{ t('st.lic.refresh') }}</button>{% endif %}
    </div>
    {%- if not license.license_key_masked %}
    <form class="st-lic-form" id="st-lic-form" autocomplete="off" novalidate>
      {{ textRow('st-lic-key', '', t('license.key_label'), placeholder=t('license.key_placeholder'), mono=true, maxlength=200) }}
      {{ textRow('st-lic-sig', '', t('license.signing_key_label'), placeholder=t('license.signing_key_placeholder'), mono=true, maxlength=4000) }}
      <div class="st-card-foot">
        {%- if license.unlicensed %}<a href="https://callmetechie.de/products/gatecontrol/pricing" target="_blank" rel="noopener" class="st-link st-foot-left">{{ t('license.get_free_license') }}</a>{% endif %}
        <span class="st-foot-msg" id="st-lic-msg" role="status"></span>
        <button type="submit" class="st-btn st-btn-primary">{{ t('license.activate') }}</button>
      </div>
    </form>
    {%- endif %}
  </section>
  <section class="st-card" aria-labelledby="st-c-features">
    {% call cardHead('st-c-features', t('st.lic.features')) %}{% endcall %}
    {%- if license.derived_count > 0 %}
    <p class="st-note st-lic-derived-note" id="st-lic-derived-note">{{ t('st.lic.derived_note', { n: license.derived_count }) }}</p>
    {%- endif %}
    <ul class="st-features">
      {%- for key, value in license.features %}{% if value is number or value == true or value == false %}
      {%- set on = (value == true) or (value is number and value != 0) %}
      {%- set derived = on and value == true and license.sources and license.sources[key] == 'plan_default' %}
      <li class="st-feature" data-on="{{ '1' if on else '0' }}" data-src="{{ (license.sources[key] if license.sources else '') or '' }}" data-key="{{ key }}"{% if derived %} title="{{ t('st.lic.derived_title') }}"{% endif %}>
        <span class="st-feature-ic" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="{{ 'M5 12l5 5 9-10' if on else 'M7 7l10 10M17 7L7 17' }}"/></svg></span>
        <span class="st-feature-name">{{ t('st.feature.' + key) if t('st.feature.' + key) != 'st.feature.' + key else (key | replace('_', ' ') | capitalize) }}</span>
        <span class="st-feature-val">
          {%- if value is number and value == -1 %}{{ t('license.unlimited') }}
          {%- elif value is number and value == 0 %}{{ t('st.lic.not_included') }}
          {%- elif value is number %}{{ value }}
          {%- elif value and derived %}{{ t('st.lic.included_derived') }}
          {%- elif value %}{{ t('st.lic.included') }}
          {%- else %}{{ t('st.lic.not_included') }}{% endif -%}
        </span>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </section>
  {%- if license.license_key_masked %}
  <section class="st-card st-card-danger" aria-labelledby="st-c-licremove">
    {% call cardHead('st-c-licremove', t('st.lic.remove_title'), t('st.lic.remove_desc')) %}{% endcall %}
    <div class="st-card-foot"><button type="button" class="st-btn st-btn-danger" id="st-lic-remove">{{ t('st.lic.remove') }}</button></div>
  </section>
  {%- endif %}
</section>

{# ══ Wartung · Gefahrenzone ═══════════════════════════════════════════ #}
<section class="st-section" data-section="gefahr" aria-labelledby="st-h-gefahr" data-st-keywords="{{ t('st.kw.gefahr') }}" hidden>
  <div class="st-sec-head"><h2 class="st-sec-title" id="st-h-gefahr" tabindex="-1">{{ t('st.nav.gefahr') }}</h2><p class="st-sec-desc">{{ t('st.desc.gefahr') }}</p></div>
