{# ══ Wartung · Backups ════════════════════════════════════════════════ #}
<section class="st-section" data-section="backup" aria-labelledby="st-h-backup" data-st-keywords="{{ t('st.kw.backup') }}" hidden>
  <div class="st-sec-head"><h2 class="st-sec-title" id="st-h-backup" tabindex="-1">{{ t('st.nav.backup') }}</h2><p class="st-sec-desc">{{ t('st.desc.backup') }}</p></div>
  {% set abOff = not has('scheduled_backups') %}
  <section class="st-card" aria-label="{{ t('st.bk.status') }}">
    <div class="st-tiles st-tiles-pad" id="st-bk-stats">
      <div class="st-stat"><div class="st-stat-label">{{ t('st.bk.last') }}</div><div class="st-stat-value" id="st-bk-last">—</div><div class="st-stat-sub" id="st-bk-last-sub"></div></div>
      <div class="st-stat"><div class="st-stat-label">{{ t('st.bk.next') }}</div><div class="st-stat-value" id="st-bk-next">—</div><div class="st-stat-sub" id="st-bk-next-sub"></div></div>
      <div class="st-stat" id="st-bk-off-stat"><div class="st-stat-label">{{ t('st.bk.offsite') }}</div><div class="st-stat-value" id="st-bk-off">—</div><div class="st-stat-sub" id="st-bk-off-sub"></div></div>
    </div>
    <div class="st-card-pad st-btnrow">
      <button type="button" class="st-btn st-btn-primary" id="st-bk-run"{% if abOff %} disabled{% endif %}>{{ t('st.bk.run') }}</button>
      <button type="button" class="st-btn" id="st-bk-download">{{ t('st.bk.download') }}</button>
      <span class="st-foot-msg" id="st-bk-msg" role="status"></span>
    </div>
  </section>
  <section class="st-card" aria-labelledby="st-c-auto">
    {% call cardHead('st-c-auto', t('autobackup.title'), '', PRO) %}{% endcall %}
    {% if abOff %}{{ lockNote('scheduled_backups') }}{% endif %}
    {{ switchRow('st-ab-on', 'ab-on', t('st.bk.auto'), disabled=abOff) }}
    {{ selectRow('st-ab-schedule', 'ab-schedule', t('autobackup.schedule'), [['6h', t('autobackup.schedule_6h')], ['12h', t('autobackup.schedule_12h')], ['daily', t('autobackup.schedule_daily')], ['3d', t('autobackup.schedule_3d')], ['weekly', t('autobackup.schedule_weekly')]], disabled=abOff) }}
    {{ numRow('st-ab-keep', 'ab-keep', t('st.bk.keep'), t('st.bk.keep_hint'), t('st.unit.backups'), 1, 100, disabled=abOff) }}
    {{ readRow('st-ab-dir', t('autobackup.directory'), mono=true, value='/data/backups/') }}
  </section>
  <section class="st-card" aria-labelledby="st-c-offsite" id="card-offsite">
    {% call cardHead('st-c-offsite', t('st.bk.offsite_title'), t('st.bk.offsite_desc'), PRO) %}{% endcall %}
    {% if abOff %}{{ lockNote('scheduled_backups') }}{% endif %}
    <div class="st-src" id="offsite-plan-default" data-license-source="scheduled_backups"></div>
    <div class="st-note st-note-warn" id="st-off-abhint" hidden>{{ t('offsite.autobackup_off') }}</div>
    <div class="st-row" data-st-row="off-pass">
      {{ rowText('st-off-pass', t('offsite.passphrase'), t('st.bk.pass_hint'), '', true) }}
      <div class="st-row-ctl st-row-ctl-stack" data-st-field="off-pass" data-st-custom="1" id="st-off-passfield">
        <input type="password" class="st-input" id="st-off-pass" maxlength="1024" autocomplete="new-password" spellcheck="false" aria-describedby="st-off-pass-hint st-off-strength st-off-pass-err"{% if abOff %} disabled{% endif %}>
        <label class="st-sr" for="st-off-pass2">{{ t('offsite.passphrase_repeat') }}</label>
        <input type="password" class="st-input" id="st-off-pass2" maxlength="1024" autocomplete="new-password" spellcheck="false" placeholder="{{ t('offsite.passphrase_repeat') }}"{% if abOff %} disabled{% endif %}>
        <div class="st-strength" id="st-off-strength" data-level="empty" aria-live="polite"><span class="st-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span id="st-off-strength-text"></span></div>
      </div>
    </div>
    {{ switchRow('st-off-key', 'off-key', t('offsite.include_key'), t('offsite.include_key_desc'), disabled=abOff) }}
    <div class="st-note st-note-warn">{{ t('offsite.passphrase_loss') }}</div>
    <ul class="st-list st-list-top" id="st-off-targets"><li class="st-empty">{{ t('common.loading') }}</li></ul>
    <div class="st-card-pad"><button type="button" class="st-btn st-btn-dashed" id="st-off-add"{% if abOff %} disabled{% endif %}>{{ t('st.bk.add_target') }}</button></div>
  </section>
  <section class="st-card" aria-labelledby="st-c-files">
    {% call cardHead('st-c-files', t('st.bk.files')) %}{% endcall %}
    <ul class="st-list" id="st-bk-files"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>
  <section class="st-card" aria-labelledby="st-c-premig" id="card-premigration">
    {% call cardHead('st-c-premig', t('premig.title'), t('st.bk.premig_desc')) %}{% endcall %}
    <ul class="st-list" id="st-premig"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>
  <section class="st-card st-card-danger" aria-labelledby="st-c-restore" id="card-restore">
    {% call cardHead('st-c-restore', t('st.bk.restore'), t('st.bk.restore_desc')) %}{% endcall %}
    <div class="st-row">
      <div class="st-row-text"><span class="st-label" id="st-rs-label">{{ t('st.bk.restore_file') }}</span><span class="st-hint">{{ t('st.bk.restore_file_hint') }}</span></div>
      <div class="st-row-ctl">
        <input type="file" id="st-rs-file" accept=".json,.gcbk" class="st-sr" aria-labelledby="st-rs-label">
        <button type="button" class="st-btn" id="st-rs-pick">{{ t('st.bk.restore_pick') }}</button>
      </div>
    </div>
    <div class="st-restore" id="st-rs-box" hidden>
      <div class="st-row" id="st-rs-passrow" hidden>
        {{ rowText('st-rs-pass', t('offsite.restore_passphrase'), t('offsite.restore_passphrase_hint'), '', true) }}
        <div class="st-row-ctl"><input type="password" class="st-input" id="st-rs-pass" maxlength="1024" autocomplete="off" spellcheck="false" aria-describedby="st-rs-pass-hint"><button type="button" class="st-btn" id="st-rs-check">{{ t('offsite.restore_check') }}</button></div>
      </div>
      <div class="st-note" id="st-rs-preview" role="status"></div>
      <div class="st-card-foot"><button type="button" class="st-btn st-btn-danger" id="st-rs-go" hidden>{{ t('settings.restore_confirm') }}</button></div>
    </div>
  </section>
</section>

{# ══ Wartung · Updates ════════════════════════════════════════════════ #}
<section class="st-section" data-section="updates" aria-labelledby="st-h-updates" data-st-keywords="{{ t('st.kw.updates') }}" hidden>
  <div class="st-sec-head"><h2 class="st-sec-title" id="st-h-updates" tabindex="-1">{{ t('st.nav.updates') }}</h2><p class="st-sec-desc">{{ t('st.desc.updates') }}</p></div>
  <section class="st-card" aria-labelledby="st-c-au" id="card-au-window">
    {% call cardHead('st-c-au', t('st.au.title')) %}{% endcall %}
    {{ segRow('st-au-mode', 'au-mode', t('st.au.mode'), [['auto', t('st.au.mode_auto')], ['manual', t('st.au.mode_manual')]], t('st.au.mode_hint')) }}
    {{ switchRow('st-au-win', 'au-win', t('st.au.window'), t('autoupdate.window_help')) }}
    <div data-st-show="au-win=true">
      {{ textRow('st-au-from', 'au-from', t('autoupdate.window_from'), type='time', mono=true, width='xs') }}
