{# ══ Wartung · Backups ════════════════════════════════════════════════ #}
<section class="st-section"{{ secAttrs('backup') }}>
  {% set abOff = not has('scheduled_backups') %}
  {% call pageHead('backup', t('st.nav.backup'), t('st.desc.backup')) %}
    <button type="button" class="pgx-btn" id="st-bk-download">{{ ic(IC.backup) }}{{ t('st.bk.download') }}</button>
    <button type="button" class="pgx-btn pgx-btn-pri" id="st-bk-run"{% if abOff %} disabled{% endif %}>{{ t('st.start.backup_now') }}</button>
  {% endcall %}
  <p class="stx-box" id="st-bk-msg" role="status" hidden></p>
  <div class="pgx-stats stx-tiles" id="st-bk-stats" role="group" aria-label="{{ t('st.bk.status') }}">
    <div class="pgx-card pgx-stat stx-tile stx-tile-text" data-tone="blue"><span class="pgx-lbl">{{ t('st.bk.last') }}</span><b id="st-bk-last">—</b><span class="pgx-stat-d" id="st-bk-last-sub"></span></div>
    <div class="pgx-card pgx-stat stx-tile stx-tile-text" data-tone="good"><span class="pgx-lbl">{{ t('st.bk.next') }}</span><b id="st-bk-next">—</b><span class="pgx-stat-d" id="st-bk-next-sub"></span></div>
    <div class="pgx-card pgx-stat stx-tile stx-tile-text" id="st-bk-off-stat" data-tone="violet"><span class="pgx-lbl">{{ t('st.bk.offsite') }}</span><b id="st-bk-off">—</b><span class="pgx-stat-d" id="st-bk-off-sub"></span></div>
  </div>
  <section class="pgx-card stx-card" aria-labelledby="st-c-auto">
    {% call cardHead('st-c-auto', t('autobackup.title'), t('st.bk.auto_desc'), PRO) %}{% endcall %}
    {% if abOff %}{{ lockNote('scheduled_backups') }}{% endif %}
    {{ switchRow('st-ab-on', 'ab-on', t('st.bk.auto'), disabled=abOff) }}
    {{ selectRow('st-ab-schedule', 'ab-schedule', t('autobackup.schedule'), [['6h', t('autobackup.schedule_6h')], ['12h', t('autobackup.schedule_12h')], ['daily', t('autobackup.schedule_daily')], ['3d', t('autobackup.schedule_3d')], ['weekly', t('autobackup.schedule_weekly')]], disabled=abOff) }}
    {{ numRow('st-ab-keep', 'ab-keep', t('st.bk.keep'), t('st.bk.keep_hint'), t('st.unit.backups'), 1, 100, disabled=abOff) }}
    {{ readRow('st-ab-dir', t('autobackup.directory'), mono=true, value='/data/backups/') }}
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-offsite" id="card-offsite">
    {% call cardHead('st-c-offsite', t('st.bk.offsite_title'), t('st.bk.offsite_desc'), PRO) %}
      <button type="button" class="pgx-btn pgx-btn-sm" id="st-off-add"{% if abOff %} disabled{% endif %}>{{ ic(IC.plus, 14) }}{{ t('st.bk.add_target') }}</button>
    {% endcall %}
    {% if abOff %}{{ lockNote('scheduled_backups') }}{% endif %}
    <div class="st-src" id="offsite-plan-default" data-license-source="scheduled_backups"></div>
    <div class="st-note st-note-warn" id="st-off-abhint" hidden>{{ t('offsite.autobackup_off') }}</div>
    <ul class="st-list" id="st-off-targets"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-crypt">
    {% call cardHead('st-c-crypt', t('st.bk.crypt_title'), t('st.bk.crypt_desc'), PRO) %}{% endcall %}
    <div class="st-row" data-st-row="off-pass">
      {{ rowText('st-off-pass', t('offsite.passphrase'), t('st.bk.pass_hint'), '', true) }}
      <div class="st-row-ctl st-row-ctl-stack" data-st-field="off-pass" data-st-custom="1" id="st-off-passfield">
        <input type="password" class="st-input" id="st-off-pass" maxlength="1024" autocomplete="new-password" spellcheck="false" aria-describedby="st-off-pass-hint st-off-strength st-off-pass-err"{% if abOff %} disabled{% endif %}>
        <label class="st-sr" for="st-off-pass2">{{ t('offsite.passphrase_repeat') }}</label>
        <input type="password" class="st-input" id="st-off-pass2" maxlength="1024" autocomplete="new-password" spellcheck="false" placeholder="{{ t('offsite.passphrase_repeat') }}"{% if abOff %} disabled{% endif %}>
        <div class="st-strength" id="st-off-strength" data-level="empty" aria-live="polite"><span class="st-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span id="st-off-strength-text"></span></div>
      </div>
    </div>
    {{ switchRow('st-off-key', 'off-key', t('offsite.include_key'), t('offsite.include_key_desc'), disabled=abOff) }}
    <div class="st-note st-note-warn">{{ t('offsite.passphrase_loss') }}</div>
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-files">
    {% call cardHead('st-c-files', t('st.bk.files'), t('st.bk.files_desc')) %}{% endcall %}
    <ul class="st-list" id="st-bk-files"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-premig" id="card-premigration">
    {% call cardHead('st-c-premig', t('premig.title'), t('st.bk.premig_desc')) %}{% endcall %}
    <ul class="st-list" id="st-premig"><li class="st-empty">{{ t('common.loading') }}</li></ul>
  </section>
  <p class="stx-box" data-tone="info">{{ t('st.bk.restore_moved') }} <a href="/settings/gefahr#card-restore" data-section-link="gefahr">{{ t('st.nav.gefahr') }}</a></p>
</section>

{# ══ Wartung · Updates ════════════════════════════════════════════════ #}
<section class="st-section"{{ secAttrs('updates') }}>
  {% call pageHead('updates', t('st.nav.updates'), t('st.status.updates', { version: appVersion })) %}
    <button type="button" class="pgx-btn pgx-btn-pri" id="st-au-trigger" hidden>{{ ic(IC.updates) }}{{ t('autoupdate.trigger') }}</button>
  {% endcall %}
  <div class="stx-box" data-tone="warn" id="st-au-waiting" hidden>{{ t('autoupdate.waiting_window_hint') }}</div>
  <section class="pgx-card stx-card" aria-labelledby="st-c-au" id="card-au-window">
    {% call cardHead('st-c-au', t('st.au.title'), t('st.au.desc')) %}{% endcall %}
    {{ segRow('st-au-mode', 'au-mode', t('st.au.mode'), [['auto', t('st.au.mode_auto')], ['manual', t('st.au.mode_manual')]], t('st.au.mode_hint')) }}
    {{ switchRow('st-au-win', 'au-win', t('st.au.window'), t('autoupdate.window_help')) }}
    <div data-st-show="au-win=true">
      {{ textRow('st-au-from', 'au-from', t('autoupdate.window_from'), type='time', mono=true, width='xs') }}
      {{ textRow('st-au-to', 'au-to', t('autoupdate.window_to'), type='time', mono=true, width='xs') }}
      {{ selectRow('st-au-tz', 'au-tz', t('autoupdate.window_tz'), [['Europe/Berlin', 'Europe/Berlin']]) }}
      <div class="st-timeline" id="st-au-timeline">
        <div class="st-tl-caption" id="st-au-caption"></div>
        <div class="st-tl-bar" aria-hidden="true"><div class="st-tl-win" id="st-au-win1"></div><div class="st-tl-win" id="st-au-win2" hidden></div><div class="st-tl-now" id="st-au-now"></div></div>
        <div class="st-tl-axis" aria-hidden="true"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
      </div>
    </div>
    {{ switchRow('st-au-mail', 'au-mail', t('st.au.mail'), t('st.au.mail_hint')) }}
  </section>
  <section class="pgx-card stx-card" aria-labelledby="st-c-updatesh">
    {% call cardHead('st-c-updatesh', t('st.ush.title'), t('st.ush.desc')) %}
      <a class="pgx-btn pgx-btn-sm" href="/api/v1/system/update-sh" download>{{ t('st.ush.download') }}</a>
    {% endcall %}
    <div class="st-row">
      <div class="st-row-text"><span class="st-label">{{ t('st.ush.state') }}</span><span class="st-hint" id="st-ush-state"></span></div>
      <div class="st-row-ctl">
        <button type="button" class="pgx-btn pgx-btn-sm" id="st-ush-show" aria-expanded="false" aria-controls="st-ush-cmds">{{ t('updatesh.show') }}</button>
      </div>
    </div>
    <div class="st-cmds" id="st-ush-cmds" hidden>
      <p class="st-hint">{{ t('autoupdate.reinstall_hint') }}</p>
      <pre class="st-pre" id="st-ush-cmd">cd /opt/gatecontrol
curl -fsSLO https://raw.githubusercontent.com/CallMeTechie/gatecontrol/master/update.sh
chmod +x update.sh</pre>
      <div class="st-btnrow"><button type="button" class="pgx-btn pgx-btn-sm" id="st-ush-copy">{{ t('st.copy') }}</button></div>
      <p class="st-hint">{{ t('autoupdate.reinstall_cron') }}</p>
    </div>
  </section>
</section>

{# ══ Wartung · Lizenz ═════════════════════════════════════════════════ #}
<section class="st-section"{{ secAttrs('lizenz') }}>
  {%- set updParts = (license.updates_until | string).split('T')[0].split('-') if license.updates_until else [] %}
  {%- set updDate = ((updParts[2] + '.' + updParts[1] + '.' + updParts[0]) if language == 'de' else updParts.join('-')) if updParts.length == 3 else '' %}
  {%- set licStatus = t('st.lic.status', { plan: planLabel }) + (' · ' + t('st.lic.valid_until', { date: expDate }) if expDate else '') %}
  {% call pageHead('lizenz', t('st.nav.lizenz'), licStatus if not license.unlicensed else t('license.unlicensed_banner')) %}
    {%- if license.license_key_masked %}<button type="button" class="pgx-btn" id="st-lic-refresh">{{ ic(IC.updates) }}{{ t('st.lic.refresh') }}</button>{% endif %}
    {%- if license.unlicensed %}<a href="https://callmetechie.de/products/gatecontrol/pricing" target="_blank" rel="noopener" class="pgx-btn">{{ t('license.get_free_license') }}</a>{% endif %}
  {% endcall %}
  {%- set featOn = 0 %}{% set featAll = 0 %}
  {%- for key, value in license.features %}{% if value is number or value == true or value == false %}{% set featAll = featAll + 1 %}{% if (value == true) or (value is number and value != 0) %}{% set featOn = featOn + 1 %}{% endif %}{% endif %}{% endfor %}
  <div class="pgx-stats stx-tiles">
    <div class="pgx-card pgx-stat stx-tile stx-tile-text" data-tone="violet"><span class="pgx-lbl">{{ t('st.lic.plan') }}</span><b>{{ planLabel }}</b><span class="pgx-stat-d">{{ license.license_key_masked or t('st.lic.no_key') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="good"><span class="pgx-lbl">{{ t('st.lic.tile_valid') }}</span><b>{{ expDate or '–' }}</b><span class="pgx-stat-d">{{ t('st.lic.updates_until', { date: updDate }) if updDate else t('st.lic.no_expiry') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="blue"><span class="pgx-lbl">{{ t('st.lic.tile_features') }}</span><b>{{ featOn }}<small> / {{ featAll }}</small></b><span class="pgx-stat-d">{{ t('st.lic.tile_features_sub') }}</span></div>
    <div class="pgx-card pgx-stat stx-tile" data-tone="warn"><span class="pgx-lbl">{{ t('st.lic.tile_activations') }}</span><b>{{ (license.activations + '<small> / ' + license.max_activations + '</small>') | safe if license.activations else '–' }}</b><span class="pgx-stat-d">{{ t('st.lic.tile_activations_sub') }}</span></div>
  </div>
  {%- if license.verification or (license.verification == 'signed_offline' and license.lastCheck and not license.lastCheck.ok) %}
  <div class="stx-box" data-tone="{{ 'warn' if (license.lastCheck and not license.lastCheck.ok) else 'info' }}">
    {%- if license.verification %}<span class="st-lic-verify" id="st-lic-verify" data-verification="{{ license.verification }}">{{ t('st.lic.verify_' + license.verification) }}</span>{% endif %}
    {%- if license.verification == 'signed_offline' and license.lastCheck and not license.lastCheck.ok %}
    {#- times in UTC here; settings.js shows them in the browser's local time #}
    {%- set lcAt = (license.lastCheck.at | string).replace('T', ' ').slice(0, 16) + ' UTC' %}
    {%- set lcNext = ((license.nextCheckAt | string).replace('T', ' ').slice(0, 16) + ' UTC') if license.nextCheckAt else '' %}
    <span class="st-lic-lastcheck" id="st-lic-lastcheck" data-reason="{{ license.lastCheck.reason }}" data-at="{{ license.lastCheck.at }}" data-next="{{ license.nextCheckAt or '' }}">
      {{- t('st.lic.last_check_failed', { reason: license.lastCheck.reason, at: lcAt }) }}{% if lcNext %} {{ t('st.lic.next_check', { at: lcNext }) }}{% endif -%}
    </span>
    {%- endif %}
  </div>
  {%- endif %}
  {%- if not license.license_key_masked %}
  <section class="pgx-card stx-card" aria-labelledby="st-c-lickey">
    {% call cardHead('st-c-lickey', t('st.lic.key_title'), t('license.community_hint') if license.plan == 'community' else t('st.lic.key_desc')) %}{% endcall %}
    <form class="st-lic-form" id="st-lic-form" autocomplete="off" novalidate>
      {{ textRow('st-lic-key', '', t('license.key_label'), placeholder=t('license.key_placeholder'), mono=true, maxlength=200) }}
      {{ textRow('st-lic-sig', '', t('license.signing_key_label'), placeholder=t('license.signing_key_placeholder'), mono=true, maxlength=4000) }}
      {% call actionRow(t('st.lic.activate_label'), t('st.lic.activate_hint')) %}<button type="submit" class="pgx-btn pgx-btn-pri">{{ t('license.activate') }}</button>{% endcall %}
      <p class="stx-msg" id="st-lic-msg" role="status"></p>
    </form>
  </section>
  {%- endif %}
  <section class="pgx-card stx-card" aria-labelledby="st-c-features">
    {% call cardHead('st-c-features', t('st.lic.features'), t('st.lic.features_desc', { on: featOn, n: featAll })) %}{% endcall %}
    {%- if license.derived_count > 0 %}
    <p class="st-note st-lic-derived-note" id="st-lic-derived-note">{{ t('st.lic.derived_note', { n: license.derived_count }) }}</p>
    {%- endif %}
    {%- macro featureItem(key, value) -%}
      {%- set on = (value == true) or (value is number and value != 0) %}
      {%- set derived = on and value == true and license.sources and license.sources[key] == 'plan_default' %}
      <li class="st-feature" data-on="{{ '1' if on else '0' }}" data-src="{{ (license.sources[key] if license.sources else '') or '' }}" data-key="{{ key }}"{% if derived %} title="{{ t('st.lic.derived_title') }}"{% endif %}>
        <span class="st-feature-ic" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="{{ 'M5 12l5 5 9-10' if on else 'M7 7l10 10M17 7L7 17' }}"/></svg></span>
        <span class="st-feature-name">{{ t('st.feature.' + key) if t('st.feature.' + key) != 'st.feature.' + key else (key | replace('_', ' ') | capitalize) }}</span>
        <span class="st-feature-val">
          {%- if value is number and value == -1 %}{{ t('license.unlimited') }}
          {%- elif value is number and value == 0 %}{{ t('st.lic.not_included') }}
          {%- elif value is number %}{{ value }}
          {%- elif value and derived %}{{ t('st.lic.included_derived') }}
          {%- elif value %}{{ t('st.lic.included') }}
          {%- else %}{{ t('st.lic.not_included') }}{% endif -%}
        </span>
      </li>
    {%- endmacro -%}
    <ul class="st-features stx-features" id="st-lic-features-on">
      {%- for key, value in license.features %}{% if (value is number and value != 0) or value == true %}{{ featureItem(key, value) }}{% endif %}{% endfor %}
    </ul>
    {%- if featAll > featOn %}
    <details class="stx-more" id="st-lic-more">
      <summary>{{ t('st.lic.show_missing', { n: featAll - featOn }) }}</summary>
      <ul class="st-features stx-features">
        {%- for key, value in license.features %}{% if (value is number and value == 0) or value == false %}{{ featureItem(key, value) }}{% endif %}{% endfor %}
      </ul>
    </details>
    {%- endif %}
  </section>
</section>

{# ══ Wartung · Gefahrenzone ═══════════════════════════════════════════ #}
<section class="st-section"{{ secAttrs('gefahr') }}>
  {% call pageHead('gefahr', t('st.nav.gefahr'), t('st.desc.gefahr')) %}{% endcall %}
  <section class="pgx-card stx-card stx-card-danger" aria-labelledby="st-c-dzwg">
    {% call cardHead('st-c-dzwg', t('st.danger.vpn_title'), t('st.danger.vpn_desc')) %}{% endcall %}
    {% call actionRow(t('st.danger.wg_stop'), t('st.danger.wg_stop_hint')) %}<button type="button" class="pgx-btn pgx-btn-danger" id="st-wg-stop">{{ t('st.danger.wg_stop_btn') }}</button>{% endcall %}
  </section>
  <section class="pgx-card stx-card stx-card-danger" aria-labelledby="st-c-dzdata">
    {% call cardHead('st-c-dzdata', t('st.danger.data'), t('st.danger.data_desc')) %}{% endcall %}
    {% call actionRow(t('st.cleanup.clear'), t('st.danger.clear_hint')) %}<button type="button" class="pgx-btn pgx-btn-danger" data-st-action="clear-logs">{{ t('st.danger.clear_btn') }}</button>{% endcall %}
  </section>
  <section class="pgx-card stx-card stx-card-danger" aria-labelledby="st-c-restore" id="card-restore">
    {% call cardHead('st-c-restore', t('st.bk.restore'), t('st.bk.restore_desc')) %}{% endcall %}
    <div class="st-row">
      <div class="st-row-text"><span class="st-label" id="st-rs-label">{{ t('st.bk.restore_file') }}</span><span class="st-hint">{{ t('st.bk.restore_file_hint') }}</span></div>
      <div class="st-row-ctl">
        <input type="file" id="st-rs-file" accept=".json,.gcbk" class="st-sr" aria-labelledby="st-rs-label">
        <button type="button" class="pgx-btn" id="st-rs-pick">{{ t('st.bk.restore_pick') }}</button>
      </div>
    </div>
    <div class="st-restore" id="st-rs-box" hidden>
      <div class="st-row" id="st-rs-passrow" hidden>
        {{ rowText('st-rs-pass', t('offsite.restore_passphrase'), t('offsite.restore_passphrase_hint'), '', true) }}
        <div class="st-row-ctl"><input type="password" class="st-input" id="st-rs-pass" maxlength="1024" autocomplete="off" spellcheck="false" aria-describedby="st-rs-pass-hint"><button type="button" class="pgx-btn" id="st-rs-check">{{ t('offsite.restore_check') }}</button></div>
      </div>
      <div class="st-note" id="st-rs-preview" role="status"></div>
      {% call actionRow(t('st.bk.restore_go_label'), t('st.bk.restore_go_hint')) %}<button type="button" class="pgx-btn pgx-btn-danger" id="st-rs-go" hidden>{{ t('settings.restore_confirm') }}</button>{% endcall %}
    </div>
  </section>
  {%- if license.license_key_masked %}
  <section class="pgx-card stx-card stx-card-danger" aria-labelledby="st-c-licremove">
    {% call cardHead('st-c-licremove', t('st.lic.remove_title'), t('st.lic.remove_desc')) %}{% endcall %}
    {% call actionRow(t('st.lic.remove_label'), license.license_key_masked) %}<button type="button" class="pgx-btn pgx-btn-danger" id="st-lic-remove">{{ t('st.lic.remove') }}</button>{% endcall %}
  </section>
  {%- endif %}
</section>

      <div class="st-savebar" id="st-savebar" role="region" aria-label="{{ t('st.save.region') }}" hidden>
        <span class="st-savebar-dot" aria-hidden="true"></span>
        <span class="st-savebar-text" id="st-savebar-text" aria-live="polite"></span>
        <span class="st-savebar-err" id="st-savebar-err" role="alert" hidden></span>
        <button type="button" class="pgx-btn" id="st-discard">{{ t('st.save.discard') }}</button>
        <button type="button" class="pgx-btn pgx-btn-pri" id="st-save">{{ t('st.save.save') }}</button>
      </div>
      <p class="st-saved" id="st-saved" aria-live="polite"></p>
    </div>
  </div>

{# ── Dialog: webhook (create / edit) ─────────────────────────────── #}
<div class="modal-overlay st-modal" id="st-wh-modal" style="display:none">
  <div class="modal modal-wide" role="dialog" aria-modal="true" aria-labelledby="st-wh-title">
    <div class="modal-head">
      <span class="modal-title" id="st-wh-title" data-add="{{ t('st.wh.dlg_add') }}" data-edit="{{ t('st.wh.dlg_edit') }}">{{ t('st.wh.dlg_add') }}</span>
      <button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button>
    </div>
    <form class="modal-body st-dlg" id="st-wh-form" novalidate>
      <div class="st-fl"><label class="st-fl-label" for="st-wh-url">{{ t('st.wh.url') }}</label><input type="url" class="st-input st-mono" id="st-wh-url" maxlength="500" placeholder="https://hooks.example.com/…" autocomplete="off" spellcheck="false" aria-describedby="st-wh-url-hint st-wh-url-err"><span class="st-hint" id="st-wh-url-hint">{{ t('st.wh.url_hint') }}</span><span class="st-err" id="st-wh-url-err" role="alert" hidden></span></div>
      <div class="st-fl"><label class="st-fl-label" for="st-wh-desc">{{ t('st.wh.desc') }}</label><input type="text" class="st-input" id="st-wh-desc" maxlength="255" placeholder="{{ t('st.wh.desc_ph') }}" autocomplete="off"></div>
      <fieldset class="st-fieldset">
        <legend class="st-fl-label">{{ t('st.wh.events') }}</legend>
        <div class="st-radios">
          <label class="st-radio"><input type="radio" name="st-wh-scope" value="all" id="st-wh-all"> <span>{{ t('st.wh.all') }}<small>{{ t('st.wh.all_hint') }}</small></span></label>
          <label class="st-radio"><input type="radio" name="st-wh-scope" value="pick" id="st-wh-pick"> <span>{{ t('st.wh.pick') }}</span></label>
        </div>
        <div class="st-wh-groups" id="st-wh-groups"></div>
        <span class="st-err" id="st-wh-events-err" role="alert" hidden></span>
      </fieldset>
      <label class="st-check"><input type="checkbox" id="st-wh-enabled"> <span>{{ t('st.wh.enabled') }}</span></label>
      <div class="st-err st-err-block" id="st-wh-err" role="alert" hidden></div>
    </form>
    <div class="modal-foot">
      <button type="button" class="pgx-btn pgx-btn-danger st-foot-left" id="st-wh-delete" hidden>{{ t('st.wh.delete') }}</button>
      <button type="button" class="pgx-btn" data-close-modal>{{ t('common.cancel') }}</button>
      <button type="button" class="pgx-btn pgx-btn-pri" id="st-wh-save">{{ t('common.save') }}</button>
    </div>
  </div>
</div>

{# ── Dialog: off-site target. Type cards first, then the fields of that
   type (data-for), the gateway L4 picker (SFTP/SMB), the SSH key (SFTP). ── #}
<div class="modal-overlay st-modal" id="st-ot-modal" style="display:none">
  <div class="modal modal-xl" role="dialog" aria-modal="true" aria-labelledby="st-ot-title" aria-describedby="st-ot-sub">
    <div class="modal-head">
      <div><span class="modal-title" id="st-ot-title" data-add="{{ t('st.ot.add') }}" data-edit="{{ t('offsite.dlg_edit') }}">{{ t('st.ot.add') }}</span><small class="st-dlg-sub" id="st-ot-sub">{{ t('st.ot.sub') }}</small></div>
      <button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button>
    </div>
    <form class="modal-body st-dlg" id="st-ot-form" novalidate autocomplete="off">
      <fieldset class="st-fieldset">
        <legend class="st-fl-label" id="st-ot-type-label">{{ t('st.ot.type') }}</legend>
        <div class="st-typecards" role="group" aria-labelledby="st-ot-type-label">
          {%- for ty in [['sftp', 'SFTP', t('st.ot.type_sftp')], ['smb', 'SMB', t('st.ot.type_smb')], ['s3', 'S3', t('st.ot.type_s3')], ['webdav', 'WebDAV', t('st.ot.type_webdav')]] %}
          <button type="button" class="st-typecard" data-type="{{ ty[0] }}" aria-pressed="false"><b>{{ ty[1] }}</b><small>{{ ty[2] }}</small></button>
          {%- endfor %}
        </div>
        <span class="st-hint" id="st-ot-type-hint">{{ t('st.ot.type_hint') }}</span>
      </fieldset>
      <div class="st-grid2">
        <div class="st-fl st-span2"><label class="st-fl-label" for="st-ot-name">{{ t('offsite.f_name') }}</label><input type="text" class="st-input" id="st-ot-name" maxlength="64" placeholder="{{ t('offsite.f_name_ph') }}"></div>
        <div class="st-fl st-span2" data-for="webdav"><label class="st-fl-label" for="st-ot-url">{{ t('offsite.field.url') }}</label><input type="url" class="st-input st-mono" id="st-ot-url" maxlength="2048" placeholder="https://cloud.example.com/remote.php/dav/files/alice/gatecontrol/" spellcheck="false"><span class="st-hint">{{ t('offsite.f_url_hint') }}</span></div>
        <div class="st-fl st-span2" data-for="s3"><label class="st-fl-label" for="st-ot-endpoint">{{ t('offsite.f_endpoint') }}</label><input type="url" class="st-input st-mono" id="st-ot-endpoint" maxlength="2048" placeholder="https://s3.eu-central-1.wasabisys.com" spellcheck="false"><span class="st-hint">{{ t('offsite.f_endpoint_hint') }}</span></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-bucket">{{ t('offsite.field.bucket') }}</label><input type="text" class="st-input st-mono" id="st-ot-bucket" maxlength="63" spellcheck="false"></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-region">{{ t('offsite.field.region') }}</label><input type="text" class="st-input st-mono" id="st-ot-region" maxlength="32" placeholder="us-east-1" spellcheck="false"></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-akid">{{ t('offsite.field.access_key_id') }}</label><input type="text" class="st-input st-mono" id="st-ot-akid" maxlength="128" spellcheck="false"></div>
        <div class="st-fl" data-for="s3"><label class="st-fl-label" for="st-ot-secret">{{ t('offsite.field.secret_access_key') }}</label><input type="password" class="st-input st-mono" id="st-ot-secret" maxlength="1024" autocomplete="new-password" spellcheck="false"><span class="st-hint" id="st-ot-secret-hint" hidden>{{ t('offsite.secret_kept') }}</span></div>
        <div class="st-fl st-span2" data-for="s3"><label class="st-fl-label" for="st-ot-prefix">{{ t('offsite.f_prefix') }}</label><input type="text" class="st-input st-mono" id="st-ot-prefix" maxlength="255" placeholder="gatecontrol" spellcheck="false"></div>
        <label class="st-check st-span2" data-for="s3"><input type="checkbox" id="st-ot-pathstyle"> <span>{{ t('offsite.f_path_style') }}</span></label>
        <div class="st-fl" data-for="sftp smb"><label class="st-fl-label" for="st-ot-host">{{ t('offsite.field.host') }}</label><input type="text" class="st-input st-mono" id="st-ot-host" maxlength="253" placeholder="nas.example.com" spellcheck="false"></div>
        <div class="st-fl" data-for="sftp smb"><label class="st-fl-label" for="st-ot-port">{{ t('offsite.field.port') }}</label><input type="number" class="st-input st-mono" id="st-ot-port" min="1" max="65535"></div>
        <div class="st-fl" data-for="smb"><label class="st-fl-label" for="st-ot-share">{{ t('offsite.field.share') }}</label><input type="text" class="st-input st-mono" id="st-ot-share" maxlength="80" placeholder="backup" spellcheck="false"></div>
        <div class="st-fl" data-for="sftp smb"><label class="st-fl-label" for="st-ot-path">{{ t('offsite.f_path') }}</label><input type="text" class="st-input st-mono" id="st-ot-path" maxlength="255" placeholder="gatecontrol" spellcheck="false"></div>
        <div class="st-fl" data-for="sftp smb webdav"><label class="st-fl-label" for="st-ot-user">{{ t('offsite.field.username') }}</label><input type="text" class="st-input st-mono" id="st-ot-user" maxlength="128" spellcheck="false"></div>
        <div class="st-fl" data-for="smb webdav"><label class="st-fl-label" for="st-ot-pw">{{ t('offsite.field.password') }}</label><input type="password" class="st-input" id="st-ot-pw" maxlength="1024" autocomplete="new-password"><span class="st-hint" id="st-ot-pw-hint" hidden>{{ t('offsite.secret_kept') }}</span></div>
        <label class="st-check st-span2" id="st-ot-clearpw-row" data-for="smb webdav" hidden><input type="checkbox" id="st-ot-clearpw"> <span>{{ t('offsite.f_clear_password') }}</span></label>
        <div class="st-fl" data-for="smb"><label class="st-fl-label" for="st-ot-domain">{{ t('offsite.f_domain') }}</label><input type="text" class="st-input st-mono" id="st-ot-domain" maxlength="64" placeholder="WORKGROUP" spellcheck="false"></div>
      </div>
      <div class="st-panel" data-for="sftp smb">
        <label class="st-label" for="st-ot-l4">{{ t('st.ot.l4_title') }}</label>
        <span class="st-hint">{{ t('st.ot.l4_hint') }}</span>
        <select class="st-select st-w-full" id="st-ot-l4"><option value="">{{ t('st.ot.l4_none') }}</option></select>
        <span class="st-hint" id="st-ot-l4-note" aria-live="polite" hidden></span>
      </div>
      <div class="st-panel" data-for="sftp">
        <span class="st-label" id="st-ot-key-label">{{ t('offsite.key_title') }}</span>
        <span class="st-hint">{{ t('offsite.key_hint') }}</span>
        <textarea class="st-textarea st-mono st-key" id="st-ot-pubkey" rows="2" readonly spellcheck="false" aria-labelledby="st-ot-key-label"></textarea>
        <div class="st-btnrow"><button type="button" class="pgx-btn pgx-btn-sm" id="st-ot-keycopy">{{ t('st.copy') }}</button><button type="button" class="pgx-btn pgx-btn-sm pgx-btn-danger" id="st-ot-keyrotate">{{ t('st.ot.key_rotate') }}</button></div>
        <span class="st-hint">{{ t('offsite.key_hostkey_note') }}</span>
      </div>
      <div class="st-formline st-formline-end">
        <div class="st-fl"><label class="st-fl-label" for="st-ot-keep">{{ t('offsite.f_keep') }}</label><input type="number" class="st-input st-input-num" id="st-ot-keep" min="1" max="365" value="14" aria-describedby="st-ot-keep-hint"><span class="st-hint" id="st-ot-keep-hint">{{ t('offsite.f_keep_hint') }}</span></div>
        <label class="st-check"><input type="checkbox" id="st-ot-enabled" checked> <span>{{ t('st.ot.enabled') }}</span></label>
      </div>
      <div class="st-err st-err-block" id="st-ot-err" role="alert" hidden></div>
    </form>
    <div class="modal-foot">
      <span class="st-foot-msg st-foot-left">{{ t('st.ot.save_note') }}</span>
      <button type="button" class="pgx-btn" data-close-modal>{{ t('common.cancel') }}</button>
      <button type="button" class="pgx-btn pgx-btn-pri" id="st-ot-save">{{ t('st.ot.save') }}</button>
    </div>
  </div>
</div>

{# ── Dialog: Pi-hole instance ─────────────────────────────────────── #}
{% if piholeOn %}
<div class="modal-overlay st-modal" id="st-ph-modal" style="display:none">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="st-ph-title">
    <div class="modal-head">
      <span class="modal-title" id="st-ph-title" data-add="{{ t('pihole.cfg.add_instance') }}" data-edit="{{ t('st.ph.edit') }}">{{ t('pihole.cfg.add_instance') }}</span>
      <button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button>
    </div>
    <form class="modal-body st-dlg" id="st-ph-form" novalidate autocomplete="off">
      <div class="st-fl"><label class="st-fl-label" for="st-ph-label">{{ t('pihole.cfg.label') }}</label><input type="text" class="st-input" id="st-ph-label" maxlength="100"></div>
      <div class="st-fl"><label class="st-fl-label" for="st-ph-url">{{ t('pihole.cfg.url') }}</label><input type="url" class="st-input st-mono" id="st-ph-url" placeholder="http://10.8.0.5:8080" spellcheck="false" aria-describedby="st-ph-url-err"><span class="st-err" id="st-ph-url-err" role="alert" hidden></span></div>
      <div class="st-grid2">
        <div class="st-fl"><label class="st-fl-label" for="st-ph-dns">{{ t('pihole.cfg.dns_ip') }}</label><input type="text" class="st-input st-mono" id="st-ph-dns" placeholder="10.8.0.5" spellcheck="false"></div>
        <div class="st-fl"><label class="st-fl-label" for="st-ph-dnsport">{{ t('pihole.cfg.dns_port') }}</label><input type="number" class="st-input st-mono" id="st-ph-dnsport" min="1" max="65535" value="53" aria-describedby="st-ph-dnsport-hint"><span class="st-hint" id="st-ph-dnsport-hint">{{ t('pihole.cfg.dns_port_hint') }}</span></div>
      </div>
      <div class="st-fl"><label class="st-fl-label" for="st-ph-pw">{{ t('pihole.cfg.password') }}</label><input type="password" class="st-input" id="st-ph-pw" autocomplete="new-password" aria-describedby="st-ph-pw-hint"><span class="st-hint" id="st-ph-pw-hint" hidden>{{ t('pihole.cfg.password_keep_hint') }}</span></div>
      <label class="st-check"><input type="checkbox" id="st-ph-tls" checked> <span>{{ t('pihole.cfg.tls') }}</span></label>
      <div class="st-note" id="st-ph-testmsg" role="status" hidden></div>
    </form>
    <div class="modal-foot">
      <button type="button" class="pgx-btn pgx-btn-danger st-foot-left" id="st-ph-delete" hidden>{{ t('st.ph.delete') }}</button>
      <button type="button" class="pgx-btn" id="st-ph-test">{{ t('pihole.cfg.test_connection') }}</button>
      <button type="button" class="pgx-btn pgx-btn-pri" id="st-ph-save">{{ t('common.save') }}</button>
    </div>
  </div>
</div>
{% endif %}

{# ── Dialog: one AI provider ("Verwalten": key, test, model, delete key) ── #}
<div class="modal-overlay st-modal" id="ai-prov-modal" style="display:none">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="ai-prov-title">
    <div class="modal-head"><span class="modal-title" id="ai-prov-title"></span><button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button></div>
    <div class="modal-body st-dlg" id="ai-prov-body"></div>
    <div class="modal-foot"><button type="button" class="pgx-btn" data-close-modal>{{ t('common.close') }}</button></div>
  </div>
</div>

{# ── Dialog: the log of AI requests (metadata only) ─────────────────── #}
<div class="modal-overlay st-modal" id="ai-log-modal" style="display:none">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="ai-log-title">
    <div class="modal-head"><span class="modal-title" id="ai-log-title">{{ t('ai.log.title') }}</span><button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button></div>
    <div class="modal-body st-dlg">
      <p class="st-hint">{{ t('ai.log.hint') }}</p>
      <ul class="st-list" id="ai-log-list" aria-labelledby="ai-log-title"></ul>
    </div>
    <div class="modal-foot"><button type="button" class="pgx-btn" data-close-modal>{{ t('common.close') }}</button></div>
  </div>
</div>

{# ── Dialog: stop WireGuard (admin password) ─────────────────────── #}
<div class="modal-overlay st-modal" id="st-wgstop-modal" style="display:none">
  <div class="modal modal-sm" role="dialog" aria-modal="true" aria-labelledby="st-wgstop-title" aria-describedby="st-wgstop-text">
    <div class="modal-head"><span class="modal-title" id="st-wgstop-title">{{ t('config.stop_confirm_title') }}</span><button type="button" class="modal-close" data-close-modal aria-label="{{ t('common.close') }}">&times;</button></div>
    <form class="modal-body st-dlg" id="st-wgstop-form" novalidate>
      <p class="st-dlg-text" id="st-wgstop-text">{{ t('config.stop_confirm_text') }}</p>
      <div class="st-fl"><label class="st-fl-label" for="st-wgstop-pw">{{ t('st.danger.password') }}</label><input type="password" class="st-input" id="st-wgstop-pw" autocomplete="current-password" aria-describedby="st-wgstop-err"><span class="st-err" id="st-wgstop-err" role="alert" hidden></span></div>
    </form>
    <div class="modal-foot"><button type="button" class="pgx-btn" data-close-modal>{{ t('common.cancel') }}</button><button type="button" class="pgx-btn pgx-btn-crit" id="st-wgstop-go">{{ t('st.danger.wg_stop_confirm') }}</button></div>
  </div>
</div>
</div>

