  benachrichtigungen: 'M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4',
  webhooks: 'M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7',
  monitoring: 'M3 20h18M6 16l4-5 3 3 5-7',
  pihole: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 8v8M8 12h8',
  geoip: 'M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11zM12 10v.5',
  portal: 'M3 9l9-6 9 6v11H3zM9 20v-6h6v6',
  plugins: 'M14 4h-4v3H7v4h3v3h4v-3h3V7h-3zM5 20h14',
  ki: 'M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7-4.7-1.8 4.7-1.8zM18.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z',
  backup: 'M12 3v12M7 10l5 5 5-5M4 21h16',
