{# Passkeys (docs/feature-admin-passkeys.md) — Block in „Anmeldung & Sicherheit“ der Profilseite, gesteuert von /js/profile-passkeys.js #}
<div class="pf-block pk-card" id="pk-card" role="group" aria-labelledby="pk-title">
  <div class="pf-row pf-row-flat">
    <div class="pf-row-label">
      <div class="pf-label-line">
        <span class="pf-label" id="pk-title">{{ t('passkey.title') }}</span>
        <span class="tf-status pf-pill-teal" id="pk-status"></span>
      </div>
      <div class="pf-hint pf-hint-wide">{{ t('profile.pk_hint') }} {{ t('profile.pk_origin') | replace('{{origin}}', baseUrl) }}</div>
    </div>
    <div class="pf-row-actions" id="pk-actions">
      <button type="button" class="btn btn-primary pf-btn" id="pk-btn-add" aria-controls="pk-form-add" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        {{ t('passkey.add') }}
      </button>
    </div>
  </div>
  <div class="tf-banner tf-banner-amber pf-banner" id="pk-unavailable" hidden></div>
  <div class="pf-msg" id="pk-message" role="status"></div>

  <div class="pf-expand pf-expand-accent" id="pk-form-add" hidden>
    <div class="pf-inline pf-inline-end">
      <div class="pf-grow">
        <label class="pf-field-label" for="pk-name">{{ t('passkey.name_label') }}</label>
        <input type="text" class="form-input pf-input" id="pk-name" maxlength="64" placeholder="{{ t('passkey.name_placeholder') }}" autocomplete="off">
      </div>
      <div class="pf-grow" id="pk-add-reauth" hidden>
        <label class="pf-field-label" for="pk-add-password">{{ t('passkey.reauth_hint') }}</label>
        <input type="password" class="form-input pf-input" id="pk-add-password" autocomplete="current-password" placeholder="{{ t('two_fa.password_label') }}">
      </div>
      <div class="pf-actions">
        <button type="button" class="btn btn-ghost pf-btn" data-pk-cancel="pk-form-add">{{ t('two_fa.cancel') }}</button>
        <button type="button" class="btn btn-primary pf-btn" id="pk-btn-add-confirm">{{ t('passkey.add_confirm') }}</button>
      </div>
    </div>
  </div>

  <ul class="pk-list" id="pk-list"></ul>
  <div class="pk-empty" id="pk-empty" hidden>{{ t('passkey.empty') }}</div>

  <div class="pf-expand pf-expand-danger" id="pk-form-delete" hidden>
    <div class="tf-hint pf-strong" id="pk-delete-text"></div>
    <div class="pf-inline pf-inline-end">
      <div class="pf-grow" id="pk-delete-reauth" hidden>
        <label class="pf-field-label" for="pk-delete-password">{{ t('passkey.reauth_hint') }}</label>
        <input type="password" class="form-input pf-input" id="pk-delete-password" autocomplete="current-password" placeholder="{{ t('two_fa.password_label') }}">
      </div>
      <div class="pf-actions">
        <button type="button" class="btn btn-ghost pf-btn" data-pk-cancel="pk-form-delete">{{ t('two_fa.cancel') }}</button>
        <button type="button" class="btn btn-danger pf-btn" id="pk-btn-delete-confirm">{{ t('passkey.remove') }}</button>
      </div>
    </div>
  </div>
  <script type="application/json" id="pk-i18n">{
    "count": {{ t('passkey.status_count') | dump | safe }},
    "none": {{ t('passkey.status_none') | dump | safe }},
    "created": {{ t('passkey.created') | dump | safe }},
    "last_used": {{ t('passkey.last_used') | dump | safe }},
    "never_used": {{ t('passkey.never_used') | dump | safe }},
    "synced": {{ t('passkey.synced') | dump | safe }},
    "remove": {{ t('passkey.remove') | dump | safe }},
    "remove_label": {{ t('passkey.remove_label') | dump | safe }},
    "remove_confirm": {{ t('passkey.remove_confirm') | dump | safe }},
    "added": {{ t('passkey.added_success') | dump | safe }},
    "removed": {{ t('passkey.removed_success') | dump | safe }},
    "cancelled": {{ t('passkey.add_cancelled') | dump | safe }},
    "unsupported": {{ t('passkey.error_browser_unsupported') | dump | safe }},
    "unavailable": {{ t('passkey.error_unavailable') | dump | safe }},
    "wrong_origin": {{ t('passkey.error_wrong_origin') | dump | safe }},
    "error": {{ t('common.error') | dump | safe }}
  }</script>
</div>
