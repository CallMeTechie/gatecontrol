<nav class="sidebar" id="sidebar">
  {% if not user or user.role != 'admin' %}
  {# Member navigation: the portal (own devices, services, home, vehicle —
     "Mein Bereich" moved there) and the own account. Every admin page
     redirects members to /profile. #}
  <div class="nav-section-label">{{ t('nav.member_area') }}</div>
  {% if portalUrl %}
  <a href="{{ portalUrl }}" class="nav-item" rel="noopener" id="nav-portal"><svg viewBox="0 0 24 24" fill="none"><path d="M3 11.5 12 4l9 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 10v10h13V10" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>{{ t('nav.portal') }}</a>
  {% endif %}
  <a href="/profile" class="nav-item {{ 'active' if activeNav == 'profile' }}"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{{ t('nav.account_security') }}</a>
  {% else %}
  {# Groups (docs/feature-release-b.md §8): Übersicht · Netzwerk · Sicherheit ·
     Integrationen · System. URLs, badges and licence conditions unchanged;
     the quick search (command-palette.js) reads its page list from here. #}
  <div class="nav-section-label">{{ t('nav.overview') }}</div>
  <a href="/dashboard" class="nav-item {{ 'active' if activeNav == 'dashboard' }}"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="12" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="3" y="16" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/></svg>{{ t('nav.dashboard') }}</a>

  <div class="nav-section-label">{{ t('nav.group_network') }}</div>
  <a href="/peers" class="nav-item {{ 'active' if activeNav == 'peers' }}"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="6" r="3" stroke="currentColor" stroke-width="2"/><circle cx="5" cy="18" r="3" stroke="currentColor" stroke-width="2"/><circle cx="19" cy="18" r="3" stroke="currentColor" stroke-width="2"/></svg>{{ t('nav.peers') }}<span class="nav-badge green" id="peer-count-badge">{{ peerCount or 0 }}</span></a>
  <a href="/routes" class="nav-item {{ 'active' if activeNav == 'routes' }}"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" stroke="currentColor" stroke-width="2"/></svg>{{ t('nav.routes') }}<span class="nav-badge coral" id="route-count-badge">{{ routeCount or 0 }}</span></a>
  <a href="/gateways" class="nav-item {{ 'active' if activeNav == 'gateways' }}"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="6" rx="2" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="18" height="6" rx="2" stroke="currentColor" stroke-width="2"/></svg>{{ t('nav.gateways') }}</a>
  {% if license.features.gateway_pools %}
  <a href="/gateway-pools" class="nav-item {{ 'active' if activeNav == 'gateway-pools' }}"><svg viewBox="0 0 24 24" fill="none"><ellipse cx="12" cy="5" rx="8" ry="3" stroke="currentColor" stroke-width="2"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" stroke="currentColor" stroke-width="2"/></svg>{{ t('gateway_pools.title') }}</a>
  {% endif %}
  <a href="/rdp" class="nav-item {{ 'active' if activeNav == 'rdp' }}"><svg viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="20" height="13" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{{ t('nav.rdp') }}</a>
  {% if license.features.internal_dns %}
  <a href="/dns" class="nav-item {{ 'active' if activeNav == 'dns' }}"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M3 12h18" stroke="currentColor" stroke-width="2"/></svg>{{ t('nav.dns') }}</a>
  {% endif %}
  {% if license.features.pihole_integration %}
  <a href="/pihole" class="nav-item {{ 'active' if activeNav == 'pihole' }}"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M5 5l14 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{{ t('nav.pihole') }}</a>
  {% endif %}

  <div class="nav-section-label">{{ t('nav.group_security') }}</div>
  <a href="/security" class="nav-item {{ 'active' if activeNav == 'security' }}"><svg viewBox="0 0 24 24" fill="none"><path d="M10 6h10M10 12h10M10 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="m3.5 6 1.5 1.5L7.5 5M3.5 12l1.5 1.5L7.5 11M3.5 18l1.5 1.5L7.5 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ t('nav.security_check') }}</a>
  <a href="/certificates" class="nav-item {{ 'active' if activeNav == 'certificates' }}"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{{ t('nav.certificates') }}</a>
  {% if license.features.waf %}
  <a href="/waf" class="nav-item {{ 'active' if activeNav == 'waf' }}"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2 4 5v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V5l-8-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ t('nav.waf') }}</a>
  {% endif %}
  <a href="/users" class="nav-item {{ 'active' if activeNav == 'users' }}"><svg viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="2"/><path d="M3 20c0-3.3 2.7-5 6-5s6 1.7 6 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{{ t('nav.users') }}</a>

  {% if pluginNav and pluginNav.length %}
  {#- Integrationen (docs/plugins.md): one entry per installed plugin with a
      page (Smart Home, Klimaanlage, Fahrzeuge … are plugins); a plugin that
      is not running stays listed, greyed, tagged "aus" — its page explains
      why (old bookmarks keep working). -#}
  <div class="nav-section-label">{{ t('nav.group_integrations') }}</div>
  {% for pn in pluginNav %}
  <a href="{{ pn.href }}" class="nav-item{{ ' active' if activeNav == 'plugin:' + pn.id }}{{ ' nav-item-off' if not pn.on }}" data-plugin-nav="{{ pn.id }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{{ pn.icon }}"/></svg>{{ pn.label }}{% if not pn.on %}<span class="nav-tag-off">{{ t('plugins.nav_off') }}</span>{% endif %}</a>
  {% endfor %}
  {% endif %}

  <div class="nav-section-label">{{ t('nav.system') }}</div>
  {#- Notification centre (docs/feature-notification-center.md); the badge
      (messages waiting for offline devices) is filled by notifications.js. -#}
  <a href="/notifications" class="nav-item {{ 'active' if activeNav == 'notifications' }}"><svg viewBox="0 0 24 24" fill="none"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ t('nav.notifications') }}<span class="nav-badge amber" id="nc-nav-badge" hidden></span></a>
  <a href="/logs" class="nav-item {{ 'active' if activeNav == 'logs' }}"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 4-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ t('nav.logs') }}</a>
  <a href="/settings" class="nav-item {{ 'active' if activeNav == 'settings' }}"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>{{ t('nav.settings') }}</a>
  {% endif %}
</nav>
