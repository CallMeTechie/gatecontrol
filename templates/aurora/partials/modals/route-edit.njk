{% import theme + "/partials/_tip.njk" as ui with context %}
{#
  "Weiterleitung bearbeiten" (docs/feature-domain-zones.md, "Eintrags-Editor").
  Header with type chip, "Weg der Verbindung", a section nav with one-line live
  summaries and a sticky footer with the change summary. Every former option
  is still here; HTTPS-only sections stay visible but greyed for TCP/UDP
  (.rt-ee-http-only, "nur HTTPS"). Pro options are visible but locked
  without the licence (Pro chip). Filled/read by entry-editor.js.
#}
{% set ee_sections = [
  ['target', t('entry_editor.sec_target'), false],
  ['access', t('entry_editor.sec_access'), false],
  ['auth', t('entry_editor.sec_auth'), true],
  ['security', t('entry_editor.sec_security'), false],
  ['reliability', t('entry_editor.sec_reliability'), false],
  ['headers', t('entry_editor.sec_headers'), true],
  ['branding', t('entry_editor.sec_branding'), true],
  ['diagnose', t('entry_editor.sec_diagnose'), false]
] %}
<div class="modal-overlay rt-ee-overlay" id="modal-edit-route" style="display:none" data-load-failed="{{ t('entry_editor.load_failed') }}">
  <div class="modal rt-ee" role="dialog" aria-modal="true" aria-labelledby="ee-title">
    <input type="hidden" id="edit-route-id">
    <div class="rt-ee-head">
      <span class="rt-chip rt-chip-https rt-ee-chip" id="ee-type-chip">HTTPS</span>
      <div class="rt-ee-titles">
        <h2 class="rt-dlg-title" id="ee-title">{{ t('entry_editor.title') }}</h2>
        <div class="rt-dlg-sub"><span class="rt-mono rt-strong" id="ee-host"></span><span id="ee-name-sub"></span></div>
      </div>
      <button type="button" class="rt-dlg-close" id="ee-close" aria-label="{{ t('common.close') }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="rt-ee-flow" id="ee-flow" role="group" aria-label="{{ t('entry_editor.flow') }}"></div>

    <div class="rt-ee-main">
      <nav class="rt-ee-nav" id="ee-nav" aria-label="{{ t('entry_editor.sections') }}">
        {% for s in ee_sections %}
        <button type="button" class="rt-ee-tab{% if s[2] %} rt-ee-tab-http{% endif %}" data-ee-section="{{ s[0] }}" aria-controls="ee-panel-{{ s[0] }}" aria-current="{{ 'page' if loop.first else 'false' }}">
          <span class="rt-ee-tab-label">{{ s[1] }}</span>
          <span class="rt-ee-tab-sum" id="ee-sum-{{ s[0] }}"></span>
          {% if s[2] %}<span class="rt-ee-tab-note">{{ t('entry_editor.https_only') }}</span>{% endif %}
        </button>
        {% endfor %}
      </nav>

      <div class="rt-ee-panels" id="ee-panels">

      {# ═══ Ziel & Ports ═══════════════════════════════════ #}
      <section class="rt-ee-panel edit-route-panel" data-panel="target" id="ee-panel-target" aria-labelledby="ee-h-target">
        <h3 class="rt-ee-panel-title" id="ee-h-target">{{ t('entry_editor.sec_target') }}</h3>
        <div class="rt-grid2">
          {# Entry name (docs/feature-next-package.md S3 §3) #}
          <div class="rt-field" id="edit-route-label-group">
            <label class="rt-label" for="edit-route-label">{{ t('entry.label_field') }}</label>
            <input type="text" class="rt-input" id="edit-route-label" placeholder="{{ t('entry.label_placeholder') }}" maxlength="64">
            <small class="rt-hint">{{ t('entry.label_hint') }}</small>
          </div>
          <div class="rt-field">
            <div class="rt-label" id="ee-kind-lbl">{{ t('entry_editor.type') }}</div>
            <div class="rt-seg" id="ee-kind-group" role="group" aria-labelledby="ee-kind-lbl">
              <button type="button" class="rt-seg-btn rt-mono" data-value="http" aria-pressed="true">HTTPS</button>
              <button type="button" class="rt-seg-btn rt-mono" data-value="tcp" aria-pressed="false">TCP</button>
              <button type="button" class="rt-seg-btn rt-mono" data-value="udp" aria-pressed="false">UDP</button>
            </div>
            <input type="hidden" id="edit-route-type" value="http">
            <input type="hidden" id="edit-l4-protocol" value="tcp">
            <small class="rt-hint" id="ee-kind-hint"></small>
          </div>
        </div>
        <div class="rt-field">
          <label class="rt-label" for="edit-route-desc">{{ t('routes.description') or 'Description' }}</label>
          <input type="text" class="rt-input" id="edit-route-desc" placeholder="{{ t('routes.description_placeholder') or 'Optional description' }}" maxlength="255">
        </div>

        {# Domain picker for entries without a domain zone (legacy hosts). Zone
           hosts take their name from the host (rename in "Host bearbeiten"). #}
        <div class="rt-ee-card" id="ee-domain-legacy">
          <div class="form-row">
            <div class="form-group" id="edit-route-domain-wrap">
              <label class="form-label" id="edit-route-domain-label"><span class="gc-label-text">{{ t('routes.domain') }}</span>{{ ui.tip('routes.tip_domain') }}</label>
              <select id="edit-route-base-domain" class="rt-select" aria-label="{{ t('routes.domain') }}"></select>
              <input type="text" class="rt-input" id="edit-route-prefix" placeholder="{{ t('routes.prefix') }}" maxlength="63" aria-label="{{ t('routes.prefix') }}">
              <small class="form-hint">{{ t('routes.prefix_hint') }}</small>
              <small id="edit-route-unverified-warning" class="form-hint" style="display:none;color:var(--amber)"></small>
              <input type="text" class="rt-input" id="edit-route-domain-freetext" placeholder="{{ t('routes.domain_placeholder') }}" maxlength="253" style="display:none" aria-label="{{ t('routes.domain') }}"
                data-dns-checking="{{ t('routes.dns_checking') }}"
                data-dns-ok="{{ t('routes.dns_ok') }}"
                data-dns-warning="{{ t('routes.dns_warning') }}">
              <small id="edit-route-domain-preview" class="form-hint" style="display:none"></small>
              <small id="edit-route-domain-ctx-hint" class="form-hint" style="display:none"></small>
              <small id="edit-route-dns-hint" class="form-hint" style="display:none"></small>
            </div>
          </div>
        </div>

        <fieldset class="rt-fs" id="ee-fs-target">
          <legend>{{ t('entry_editor.target_lan') }}</legend>
          {# Target kind: only for entries outside a domain zone (or with a legacy override). #}
          <div class="rt-field" id="ee-row-kind">
            <label class="rt-label" for="edit-route-target-kind">{{ t('route_target_kind') }}</label>
            <select id="edit-route-target-kind" class="rt-select">
              <option value="peer">{{ t('route_target_peer') }}</option>
              <option value="gateway">{{ t('route_target_gateway') }}</option>
            </select>
          </div>
          <div class="rt-grid3">
            {# Zone-managed target: read-only, changed in "Domain-Einstellungen". #}
            <div class="rt-field" id="ee-zone-target">
              <div class="rt-label" id="ee-zone-target-label">{{ t('entry_editor.gateway') }}</div>
              <div class="rt-readonly" id="ee-zone-target-name"></div>
              <button type="button" class="rt-link-btn" id="ee-zone-settings-link">{{ t('entry_editor.change_in_settings') }}</button>
            </div>
            <div class="rt-field" id="edit-route-gateway-fields">
              <label class="rt-label" for="edit-route-gateway-peer">{{ t('route_gateway_peer') }}</label>
              <select id="edit-route-gateway-peer" class="rt-select">
                <option value="">—</option>
              </select>
            </div>
            <div class="rt-field" id="edit-route-peer-fields">
              <label class="rt-label" for="edit-route-peer">{{ t('routes.target_peer') }}</label>
              <select id="edit-route-peer" class="rt-select">
                <option value="">— {{ t('routes.direct_ip') }} —</option>
              </select>
            </div>
            <div class="rt-field" id="edit-route-ip-group">
              <label class="rt-label" for="edit-route-ip">{{ t('entry_editor.target_ip') }}</label>
              <input type="text" class="rt-input rt-mono" id="edit-route-ip" placeholder="10.8.0.2">
            </div>
            <div class="rt-field" id="ee-row-lan">
              <label class="rt-label" for="edit-route-lan-host">{{ t('route_lan_host') }}</label>
              <input type="text" class="rt-input rt-mono" id="edit-route-lan-host" placeholder="192.168.1.10">
              <small class="rt-hint" id="ee-lan-hint"></small>
            </div>
            <div class="rt-field">
              <label class="rt-label" for="edit-route-port">{{ t('entry.target_port') }}</label>
              <input type="text" inputmode="numeric" class="rt-input rt-mono rt-input-accent" id="edit-route-port" placeholder="{{ t('routes.target_port_placeholder') }}" maxlength="5">
              <small class="rt-hint">1–65535</small>
            </div>
          </div>
          <div class="rt-ee-wol" id="ee-row-wol">
            <label class="rt-check">
              <input type="checkbox" id="edit-route-wol-enabled" name="wol_enabled">
              <span>{{ t('route_wol_enabled') }}</span>
            </label>
            <div class="rt-field" id="edit-route-wol-mac-field" style="display:none">
              <label class="rt-label" for="edit-route-wol-mac">{{ t('route_wol_mac') }}</label>
              <input type="text" class="rt-input rt-mono" id="edit-route-wol-mac" placeholder="AA:BB:CC:DD:EE:FF" pattern="^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$">
            </div>
          </div>
        </fieldset>

        <fieldset class="rt-fs" id="ee-fs-outer">
          <legend>{{ t('entry_editor.from_outside') }}</legend>
          <div id="edit-l4-fields" style="display:none">
            <div class="rt-grid2">
              <div class="rt-field">
                <label class="rt-label" for="edit-l4-listen-port">{{ t('entry.listen_port') }}{{ ui.tip('routes.tip_l4_listen_port') }}</label>
                <input type="text" class="rt-input rt-mono" id="edit-l4-listen-port" maxlength="11" placeholder="{{ t('routes.l4_listen_port_placeholder') }}" data-blocked-ports="{{ (l4BlockedPorts or []) | join(',') }}">
                <small class="rt-hint" id="ee-listen-state">{{ t('entry_editor.listen_hint') }}</small>
                {% if l4BlockedPorts %}<small class="rt-hint">{{ t('routes.l4_blocked_ports_prefix') }} {{ l4BlockedPorts | join(', ') }} {{ t('routes.l4_blocked_ports_suffix') }}</small>{% endif %}
                <small id="edit-l4-listen-port-error" class="rt-hint rt-err" style="display:none"></small>
              </div>
              <div class="rt-field">
                <label class="rt-label" for="edit-l4-tls-mode">{{ t('routes.l4_tls_mode') }}{{ ui.tip('routes.tip_l4_tls_mode') }}</label>
                <select id="edit-l4-tls-mode" class="rt-select">
                  <option value="none">{{ t('routes.tls_none') }}</option>
                  <option value="passthrough">{{ t('routes.tls_passthrough') }}</option>
                  <option value="terminate">{{ t('routes.tls_terminate') }}</option>
                </select>
                <small id="edit-l4-tls-hint" class="rt-hint" data-hint-none="{{ t('routes.tls_none_hint') }}" data-hint-passthrough="{{ t('routes.tls_passthrough_hint') }}" data-hint-terminate="{{ t('routes.tls_terminate_hint') }}"></small>
              </div>
            </div>
            <div class="rt-err rt-err-row" id="ee-listen-conflict" role="alert" hidden><span id="ee-listen-conflict-text"></span><button type="button" class="btn btn-secondary rt-btn rt-btn-sm" id="ee-listen-use"></button></div>
          </div>
          <div id="ee-outer-http">
            <div class="rt-readonly rt-mono" id="ee-outer-url"></div>
            <small class="rt-hint">{{ t('entry_editor.outer_http_hint') }}</small>
          </div>
        </fieldset>

        <div id="edit-http-fields">
          <div class="rt-ee-card">
            <div class="rt-ee-row">
              <div>
                <div class="rt-ee-ttl">{{ t('routes.backend_https') }}</div>
                <div class="rt-ee-desc">{{ t('routes.backend_https_desc') }}</div>
              </div>
              <div class="toggle" id="edit-route-backend-https" aria-label="{{ t('routes.backend_https') }}"></div>
            </div>
          {# Backend certificate check (docs/feature-security-options.md §B), under
             "Backend HTTPS". Greyed out while Backend HTTPS is off and for
             gateway/pool targets (the gateway dials the target). #}
          <div id="edit-backend-tls-block" class="so-editor-block so-backend-tls"
               data-hint-gateway="{{ t('backend_tls.hint_gateway') }}" data-hint-https="{{ t('backend_tls.hint_https') }}"
               data-err-backend-ca-invalid="{{ t('backend_tls.err.ca_invalid') }}" data-err-backend-server-name-invalid="{{ t('backend_tls.err.server_name_invalid') }}"
               data-err-backend-tls-fingerprint-invalid="{{ t('backend_tls.err.fingerprint_invalid') }}">
            <label class="so-check so-check-row" for="edit-route-backend-tls-verify">
              <input type="checkbox" id="edit-route-backend-tls-verify">
              <span class="so-check-text"><span class="so-check-title">{{ t('backend_tls.verify') }}</span><span class="so-check-desc">{{ t('backend_tls.verify_desc') }}</span></span>
            </label>
            <div id="edit-backend-tls-fields" class="so-editor-fields">
              <label class="so-editor-f" for="edit-route-backend-tls-server-name"><span class="so-f-label">{{ t('backend_tls.server_name') }}</span>
                <input type="text" class="form-input so-mono" id="edit-route-backend-tls-server-name" maxlength="253" placeholder="{{ t('backend_tls.server_name_ph') }}" autocomplete="off" spellcheck="false">
                <small class="form-hint">{{ t('backend_tls.server_name_hint') }}</small>
              </label>
              <label class="so-editor-f" for="edit-route-backend-tls-ca"><span class="so-f-label">{{ t('backend_tls.ca') }}</span>
                <textarea class="form-input so-pem" id="edit-route-backend-tls-ca" rows="4" spellcheck="false" autocomplete="off" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                <small class="form-hint">{{ t('backend_tls.ca_hint') }}</small>
              </label>
            </div>
            <div id="edit-backend-tls-hint" class="so-editor-hint so-hint-warn"></div>
            {# Gateway targets with Backend HTTPS: pin the LAN certificate by its
               SHA-256 fingerprint (release B §13b). Shown only for gateway targets. #}
            <div id="edit-backend-tls-fp" class="so-editor-fields so-fp" hidden>
              <label class="so-editor-f" for="edit-route-backend-tls-fingerprint"><span class="so-f-label">{{ t('backend_tls.fp_label') }}</span>
                <input type="text" class="form-input so-mono" id="edit-route-backend-tls-fingerprint" maxlength="120" placeholder="{{ t('backend_tls.fp_ph') }}" autocomplete="off" spellcheck="false" aria-describedby="edit-backend-tls-fp-help">
              </label>
              <small class="form-hint" id="edit-backend-tls-fp-help">{{ t('backend_tls.fp_hint') }} <code class="so-fp-cmd">openssl s_client -connect &lt;LAN-IP&gt;:&lt;Port&gt; &lt;/dev/null | openssl x509 -noout -fingerprint -sha256</code></small>
              <small class="form-hint so-fp-note">{{ t('backend_tls.fp_gateway_note') }}</small>
            </div>
            <div id="edit-backend-tls-error" class="so-editor-error" role="alert" hidden></div>
          </div>
          </div>
        </div>
      </section>

      {# ═══ Zugriff ═══════════════════════════════════════ #}
      <section class="rt-ee-panel edit-route-panel" data-panel="access" id="ee-panel-access" aria-labelledby="ee-h-access" hidden>
        <h3 class="rt-ee-panel-title" id="ee-h-access">{{ t('entry_editor.sec_access') }}</h3>
        <div class="rt-ee-card">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('routes.external_label') }}</div>
              <div class="rt-ee-desc">{{ t('routes.external_hint') }}</div>
            </div>
            <div class="toggle" id="edit-route-external" aria-label="{{ t('routes.external_label') }}"></div>
          </div>
          <div id="edit-route-block-wrap" class="route-block-wrap rt-ee-http-only" style="display:none">
            <label class="rt-label" for="edit-route-block-action">{{ t('routes.block_action_label') }}</label>
            <select id="edit-route-block-action" class="rt-select">
              <option value="inherit">{{ t('routes.block_inherit') }}</option>
              <option value="not_found">{{ t('routes.block_not_found') }}</option>
              <option value="custom">{{ t('routes.block_custom') }}</option>
              <option value="redirect">{{ t('routes.block_redirect') }}</option>
              <option value="empty">{{ t('routes.block_empty') }}</option>
            </select>
            <textarea id="edit-route-block-body" class="rt-input rt-textarea rt-mono" style="display:none" maxlength="16384" placeholder="{{ t('routes.block_body_ph') }}" aria-label="{{ t('routes.block_custom') }}"></textarea>
            <input id="edit-route-block-redirect" type="url" class="rt-input" style="display:none" placeholder="{{ t('routes.block_redirect_ph') or 'https://…' }}" aria-label="{{ t('routes.block_redirect') }}">
          </div>
        </div>
        {# "Nur bei Bedarf" (docs/feature-next-package.md S3 §2) #}
        <div class="rt-ee-card od-row">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('entry.on_demand_label') }}</div>
              <div class="rt-ee-desc">{{ t('entry.on_demand_hint') }}</div>
            </div>
            <div class="toggle" id="edit-route-on-demand" aria-label="{{ t('entry.on_demand_label') }}"></div>
          </div>
          <div id="edit-route-on-demand-wol" class="od-wol rt-hint" style="display:none">{{ t('entry.on_demand_wol_hint') }}</div>
        </div>

        <div class="rt-ee-http-only" id="edit-ip-filter-block">
        {% if license.features.ip_access_control %}
        <div class="rt-ee-card">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('ip_filter.title') or 'IP Access Control' }} <span class="rt-pro">Pro</span></div>
              <div class="rt-ee-desc">{{ t('ip_filter.toggle_desc') or 'Restrict access by IP, CIDR range, or country' }}</div>
            </div>
            <div class="toggle" id="edit-route-ip-filter" aria-label="{{ t('ip_filter.title') or 'IP Access Control' }}"></div>
          </div>
          <div id="edit-ip-filter-fields" style="display:none" class="rt-ee-sub">
            <div class="toggle-group" id="edit-ip-filter-mode-group">
              <button type="button" class="toggle-btn on" data-value="whitelist">{{ t('l4p.mode_allow') }}</button>
              <button type="button" class="toggle-btn" data-value="blacklist">{{ t('l4p.mode_deny') }}</button>
            </div>
            <input type="hidden" id="edit-ip-filter-mode" value="whitelist">
            <div id="edit-ip-filter-rules-list" class="rt-ee-rules"></div>
            <div class="rt-ee-addrow">
              <input type="text" class="rt-input" id="edit-ip-filter-input" placeholder="{{ t('ip_filter.add_placeholder') or 'IP, CIDR, or country code (DE)' }}" aria-label="{{ t('ip_filter.add_placeholder') or 'IP, CIDR, or country code (DE)' }}">
              <select id="edit-ip-filter-type" class="rt-select rt-select-auto" aria-label="{{ t('entry_editor.rule_type') }}">
                <option value="ip">IP</option>
                <option value="cidr">CIDR</option>
                <option value="country">{{ t('ip_filter.country') or 'Country' }}</option>
              </select>
              <button type="button" class="btn btn-secondary rt-btn rt-btn-sm" id="edit-ip-filter-add" aria-label="{{ t('entry_editor.add_rule') }}">+</button>
            </div>
          </div>
        </div>
        {% else %}
        <div class="rt-ee-card feature-locked" title="{{ t('license.requires_pro') }}">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('ip_filter.title') or 'IP Access Control' }} <span class="rt-pro">Pro</span></div>
              <div class="rt-ee-desc">{{ t('ip_filter.toggle_desc') or 'Restrict access by IP, CIDR range, or country' }}</div>
            </div>
            <div class="toggle" id="edit-route-ip-filter" data-managed="true" aria-disabled="true" aria-label="{{ t('ip_filter.title') or 'IP Access Control' }}"></div>
          </div>
        </div>
        {% endif %}
        </div>

        <div class="rt-ee-http-only">
        {% if license.features.peer_acl %}
        <div class="rt-ee-card">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('acl.title') }} <span class="rt-pro">Pro</span></div>
              <div class="rt-ee-desc">{{ t('acl.toggle_desc') }}</div>
            </div>
            <div class="toggle" id="edit-route-acl" data-managed="true" aria-label="{{ t('acl.title') }}"></div>
          </div>
          <div id="edit-acl-fields" style="display:none" class="rt-ee-sub">
            <div class="rt-label">{{ t('acl.select_peers') }}</div>
            <div id="edit-acl-peers-list" class="rt-ee-checklist"></div>
            <div id="edit-acl-hint" class="rt-hint"></div>
          </div>
        </div>
        {% else %}
        <div class="rt-ee-card feature-locked" title="{{ t('license.requires_pro') }}">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('acl.title') }} <span class="rt-pro">Pro</span></div>
              <div class="rt-ee-desc">{{ t('acl.toggle_desc') }}</div>
            </div>
            <div class="toggle" id="edit-route-acl" data-managed="true" aria-disabled="true" aria-label="{{ t('acl.title') }}"></div>
          </div>
        </div>
        {% endif %}
        </div>

        <div class="rt-ee-http-only">
        {% if license.features.access_windows %}
        <div class="rt-ee-card form-section" id="access-windows-section" data-target-id="">
          <div class="rt-ee-ttl">
            {{ t('access.title') }} <span class="rt-pro">Pro</span>
            <span id="access-state-badge" class="rt-ee-badge"></span>
          </div>
          <div class="rt-ee-desc">{{ t('entry_editor.access_windows_desc') }}</div>
          <div id="access-rules-list"></div>
          <div id="access-rules-form"></div>
        </div>
        {% else %}
        <div class="rt-ee-card feature-locked" title="{{ t('license.requires_pro') }}">
          <div class="rt-ee-ttl">{{ t('access.title') }} <span class="rt-pro">Pro</span></div>
          <div class="rt-ee-desc">{{ t('entry_editor.access_windows_desc') }}</div>
        </div>
        {% endif %}
        </div>

        {# Section: Sichtbarkeit (portal) #}
        <div class="rt-ee-card">
          <div class="rt-ee-ttl">{{ t('routes.visible_to_users') }}</div>
          <div class="rt-ee-desc">{{ t('routes.visible_to_users_hint') }}</div>
          <div id="route-user-ids" class="rt-ee-chips"></div>
        </div>
      </section>

      {# ═══ Anmeldung (HTTPS) ══════════════════════════════ #}
      <section class="rt-ee-panel edit-route-panel rt-ee-http-panel" data-panel="auth" id="ee-panel-auth" aria-labelledby="ee-h-auth" hidden>
        <h3 class="rt-ee-panel-title" id="ee-h-auth">{{ t('entry_editor.sec_auth') }}</h3>
        <p class="rt-ee-l4note" hidden>{{ t('entry_editor.l4_note_auth') }}</p>
        <div class="rt-field">
