              <div class="rt-label">{{ t('branding.bg_image') or 'Background image (optional, overrides color)' }}</div>
              <div class="rt-ee-upload">
                <label class="btn btn-secondary rt-btn rt-btn-sm rt-file-btn">{{ t('entry_editor.upload') }}<input type="file" id="edit-branding-bg-file" accept="image/*" class="rt-file-input" aria-label="{{ t('branding.bg_image') or 'Background image' }}"></label>
                <span id="edit-branding-bg-current" class="rt-hint rt-mono"></span>
                <button type="button" class="btn btn-ghost rt-btn rt-btn-sm" id="edit-branding-bg-remove" style="display:none">{{ t('common.delete') or 'Delete' }}</button>
              </div>
            </div>
          </div>
          <div class="rt-ee-brand-preview-wrap">
            <div class="rt-label">{{ t('entry_editor.branding_preview') }}</div>
            <div class="rt-ee-brand-preview" id="ee-brand-preview" aria-hidden="true">
              <div class="rt-ee-bp-card">
                <div class="rt-ee-bp-logo" id="ee-bp-logo"></div>
                <div class="rt-ee-bp-title" id="ee-bp-title"></div>
                <div class="rt-ee-bp-text" id="ee-bp-text"></div>
                <div class="rt-ee-bp-input">{{ t('route_auth.email') }}</div>
                <div class="rt-ee-bp-input">{{ t('route_auth.password') }}</div>
                <div class="rt-ee-bp-btn" id="ee-bp-btn">{{ t('entry_editor.bp_login') }}</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {# ═══ Diagnose ══════════════════════════════════════ #}
      <section class="rt-ee-panel edit-route-panel" data-panel="diagnose" id="ee-panel-diagnose" aria-labelledby="ee-h-diagnose" hidden>
        <h3 class="rt-ee-panel-title" id="ee-h-diagnose">{{ t('entry_editor.sec_diagnose') }}</h3>
        <div class="rt-grid3 rt-ee-stats">
          <div class="rt-ee-card"><div class="rt-ee-kicker">{{ t('entry_editor.diag_status') }}</div><div class="rt-ee-stat" id="ee-diag-status"></div></div>
          <div class="rt-ee-card"><div class="rt-ee-kicker">{{ t('entry_editor.diag_time') }}</div><div class="rt-ee-stat rt-mono" id="ee-diag-time"></div></div>
          <div class="rt-ee-card"><div class="rt-ee-kicker">{{ t('entry_editor.diag_cert') }}</div><div class="rt-ee-stat" id="ee-diag-cert"></div></div>
        </div>
        <div class="rt-ee-http-only">
        <p class="rt-ee-l4note" hidden>{{ t('entry_editor.l4_note_trace') }}</p>
        {% if license.features.request_debugging %}
        <div class="rt-ee-card">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('debug.title') }} <span class="rt-pro">Pro</span></div>
              <div class="rt-ee-desc">{{ t('debug.toggle_desc') }}</div>
            </div>
            <div class="toggle" id="edit-route-debug" aria-label="{{ t('debug.title') }}"></div>
          </div>
          <div id="edit-debug-container" style="display:none" class="rt-ee-sub">
            <div class="rt-ee-row">
              <span class="rt-hint">{{ t('debug.auto_refresh') }}</span>
              <button type="button" class="btn btn-secondary rt-btn rt-btn-sm" id="edit-debug-clear">{{ t('debug.clear') }}</button>
            </div>
            <div id="edit-debug-log" class="rt-ee-log" role="log" aria-live="polite">
              <div id="edit-debug-empty" class="rt-hint rt-ee-log-empty">{{ t('debug.no_entries') }}</div>
            </div>
          </div>
        </div>
        {% else %}
        <div class="rt-ee-card feature-locked" title="{{ t('license.requires_pro') }}">
          <div class="rt-ee-row">
            <div>
              <div class="rt-ee-ttl">{{ t('debug.title') }} <span class="rt-pro">Pro</span></div>
              <div class="rt-ee-desc">{{ t('debug.toggle_desc') }}</div>
            </div>
            <div class="toggle" id="edit-route-debug" data-managed="true" aria-disabled="true" aria-label="{{ t('debug.title') }}"></div>
          </div>
        </div>
        {% endif %}
        </div>
      </section>

      </div>
    </div>

    <div class="rt-ee-foot">
      <div class="rt-ee-foot-msg">
        <div id="edit-route-error" class="form-error rt-err" role="alert" style="display:none"></div>
        <span class="rt-ee-changes" id="ee-changes" aria-live="polite"></span>
      </div>
      <button type="button" class="btn btn-ghost rt-btn" id="ee-cancel">{{ t('common.cancel') }}</button>
      <button type="button" class="btn btn-primary rt-btn" id="btn-edit-route-submit">{{ t('common.save') }}</button>
    </div>
  </div>
</div>
