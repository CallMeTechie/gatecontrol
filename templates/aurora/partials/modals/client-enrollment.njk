<div class="modal-overlay" id="modal-client-enroll" style="display:none"
     data-expired="{{ t('enrollment.expired') }}"
     data-error="{{ t('error.enrollment.create_failed') }}">
  <div class="modal">
    <div class="modal-head">
      <span class="modal-title" id="client-enroll-title">{{ t('enrollment.title') }}</span>
      <button class="modal-close" data-close-modal>&times;</button>
    </div>
    <div class="modal-body" style="text-align:center">
      <p style="font-size:13px;color:var(--text-2);margin:0 0 14px">{{ t('enrollment.intro') }}</p>
      <img id="client-enroll-qr" src="" alt="QR Code" style="max-width:280px;margin:0 auto 12px;display:block">
      <div style="font-size:12px;color:var(--text-2)">{{ t('enrollment.code_label') }}</div>
      <div id="client-enroll-code" style="font-family:var(--font-mono, monospace);font-size:20px;font-weight:600;letter-spacing:1px;margin:4px 0 10px;user-select:all"></div>
      <div id="client-enroll-expiry" style="font-size:12px;color:var(--text-2)">
        {{ t('enrollment.expires_in') }} <span id="client-enroll-countdown"></span>
      </div>
      <div id="client-enroll-error" style="display:none;font-size:13px;color:var(--red);margin-top:8px"></div>
      <p style="font-size:12px;color:var(--text-3);margin:14px 0 0">{{ t('enrollment.one_time') }}</p>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" data-close-modal>{{ t('common.close') }}</button>
      <button class="btn btn-secondary" id="client-enroll-regenerate" type="button">{{ t('enrollment.regenerate') }}</button>
    </div>
  </div>
</div>
