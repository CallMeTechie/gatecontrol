{#- Dialogs of the users list (/users) and the user profile (/users/:id):
    roles compared, create user, access wizard, edit access, edit profile,
    new password, change role, delete, invitation, owner-less accesses.
    public/js/users.js drives them on both pages; their strings come from
    the #us-i18n island (routes/index.js USERS_I18N_PREFIXES). -#}

{% macro closeBtn(label) %}<button type="button" class="modal-close" data-us-close aria-label="{{ label }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{% endmacro %}

{% macro mxCell(kind, text) %}<td><span class="us-mx-cell"><span class="us-mx-ic us-mx-{{ kind }}" aria-hidden="true">{{ '✓' if kind == 'yes' else ('◐' if kind == 'some' else '–') }}</span><span class="us-sr">{{ t('us.mx.legend_' + kind) }}</span><span class="us-mx-text">{{ text }}</span></span></td>{% endmacro %}

{# ── Roles compared (Rollen.dc.html) ─────────────────────────────── #}
<div class="modal-overlay us-dlg" id="us-dlg-roles" style="display:none" data-us-dialog>
  <div class="modal us-modal us-modal-xl" role="dialog" aria-modal="true" aria-labelledby="us-roles-title">
    <div class="modal-head">
      <div class="us-modal-headtext"><div class="page-eyebrow">{{ t('us.compare_roles') }}</div><h2 class="modal-title" id="us-roles-title">{{ t('us.mx.title') }}</h2></div>
      {{ closeBtn(t('common.close')) }}
    </div>
    <div class="modal-body us-modal-body">
      <p class="us-muted us-mx-intro">{{ t('us.mx.intro') }}</p>
      <div class="us-mx-legend">
        <span><span class="us-mx-ic us-mx-yes" aria-hidden="true">✓</span>{{ t('us.mx.legend_yes') }}</span>
        <span><span class="us-mx-ic us-mx-some" aria-hidden="true">◐</span>{{ t('us.mx.legend_some') }}</span>
        <span><span class="us-mx-ic us-mx-no" aria-hidden="true">–</span>{{ t('us.mx.legend_no') }}</span>
      </div>
      <div class="us-mx-wrap">
        <table class="us-mx">
          <thead>
            <tr>
              <th scope="col">{{ t('us.mx.area') }}</th>
              <th scope="col"><span class="us-chip us-chip-admin">{{ t('us.role.admin') }}</span><div class="us-mx-sub">{{ t('us.mx.admin_sub') }}</div></th>
              <th scope="col"><span class="us-chip us-chip-member">{{ t('us.role.member') }}</span><div class="us-mx-sub">{{ t('us.mx.member_sub') }}</div></th>
              <th scope="col"><span class="us-chip us-chip-dashed">{{ t('us.mx.self') }}</span><div class="us-mx-sub">{{ t('us.mx.self_sub') }}</div></th>
            </tr>
          </thead>
          <tbody>
            <tr><th colspan="4" scope="colgroup" class="us-mx-group">{{ t('us.mx.g_login') }}</th></tr>
            <tr><th scope="row">{{ t('us.mx.r_web') }}</th>{{ mxCell('yes', t('us.mx.c_web_admin')) }}{{ mxCell('no', t('us.mx.c_web_member')) }}{{ mxCell('some', t('us.mx.c_web_self')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_app') }}</th>{{ mxCell('yes', t('us.mx.c_code')) }}{{ mxCell('yes', t('us.mx.c_code')) }}{{ mxCell('yes', t('us.mx.c_code')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_portal') }}</th>{{ mxCell('yes', t('us.mx.c_portal_pw')) }}{{ mxCell('yes', t('us.mx.c_portal_auto')) }}{{ mxCell('yes', t('us.mx.c_portal_pw')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_pin') }}</th>{{ mxCell('yes', t('us.mx.c_pin_profile')) }}{{ mxCell('no', t('us.mx.c_pin_invite')) }}{{ mxCell('yes', t('us.mx.c_pin_both')) }}</tr>
            <tr><th colspan="4" scope="colgroup" class="us-mx-group">{{ t('us.mx.g_apps') }}</th></tr>
            <tr><th scope="row">{{ t('us.mx.r_vpn') }}</th>{{ mxCell('yes', '') }}{{ mxCell('yes', '') }}{{ mxCell('yes', '') }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_services') }}<div class="us-mx-note">{{ t('us.mx.r_services_note') }}</div></th>{{ mxCell('some', t('us.mx.c_shared')) }}{{ mxCell('some', t('us.mx.c_shared')) }}{{ mxCell('some', t('us.mx.c_like_member')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_rdp') }}</th>{{ mxCell('some', t('us.mx.c_shared_short')) }}{{ mxCell('some', t('us.mx.c_shared_short')) }}{{ mxCell('some', t('us.mx.c_shared_short')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_traffic') }}</th>{{ mxCell('yes', '') }}{{ mxCell('yes', '') }}{{ mxCell('yes', '') }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_pihole') }}<div class="us-mx-note">{{ t('us.mx.r_pihole_note') }}</div></th>{{ mxCell('yes', t('us.mx.c_pihole_admin')) }}{{ mxCell('some', t('us.mx.c_pihole_member')) }}{{ mxCell('some', t('us.mx.c_pihole_member')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_integrations') }}</th>{{ mxCell('yes', t('us.mx.c_all')) }}{{ mxCell('some', t('us.mx.c_owner')) }}{{ mxCell('some', t('us.mx.c_owner')) }}</tr>
            <tr><th colspan="4" scope="colgroup" class="us-mx-group">{{ t('us.mx.g_own') }}</th></tr>
            <tr><th scope="row">{{ t('us.mx.r_own_devices') }}</th>{{ mxCell('yes', '') }}{{ mxCell('yes', t('us.mx.c_in_portal')) }}{{ mxCell('yes', t('us.mx.c_in_portal')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_own_setup') }}</th>{{ mxCell('yes', '') }}{{ mxCell('some', t('us.mx.c_if_allowed')) }}{{ mxCell('some', t('us.mx.c_if_allowed')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_own_lock') }}</th>{{ mxCell('yes', '') }}{{ mxCell('yes', t('us.mx.c_lock_portal')) }}{{ mxCell('yes', t('us.mx.c_lock_portal')) }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_own_account') }}</th>{{ mxCell('yes', '') }}{{ mxCell('no', '') }}{{ mxCell('yes', '') }}</tr>
            <tr><th colspan="4" scope="colgroup" class="us-mx-group">{{ t('us.mx.g_admin') }}</th></tr>
            <tr><th scope="row">{{ t('us.mx.r_dashboard') }}</th>{{ mxCell('yes', '') }}{{ mxCell('no', '') }}{{ mxCell('no', '') }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_network') }}</th>{{ mxCell('yes', '') }}{{ mxCell('no', '') }}{{ mxCell('no', '') }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_shares') }}</th>{{ mxCell('yes', '') }}{{ mxCell('no', '') }}{{ mxCell('no', '') }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_users') }}</th>{{ mxCell('yes', '') }}{{ mxCell('no', '') }}{{ mxCell('no', '') }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_settings') }}</th>{{ mxCell('yes', '') }}{{ mxCell('no', '') }}{{ mxCell('no', '') }}</tr>
            <tr><th scope="row">{{ t('us.mx.r_admin_tokens') }}<div class="us-mx-note">{{ t('us.mx.r_admin_tokens_note') }}</div></th>{{ mxCell('yes', t('us.mx.c_any_rights')) }}{{ mxCell('no', t('us.mx.c_app_rights')) }}{{ mxCell('no', t('us.mx.c_app_rights')) }}</tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="modal-foot"><button type="button" class="btn btn-ghost" data-us-close>{{ t('common.close') }}</button></div>
  </div>
</div>

{# ── Create user (BenutzerAnlegen.dc.html) ───────────────────────── #}
<div class="modal-overlay us-dlg" id="us-dlg-create" style="display:none" data-us-dialog data-us-dirty>
  <div class="modal us-modal us-modal-md" role="dialog" aria-modal="true" aria-labelledby="us-create-title">
    <div class="modal-head"><h2 class="modal-title" id="us-create-title">{{ t('us.create.title') }}</h2>{{ closeBtn(t('common.close')) }}</div>
    <form class="modal-body us-modal-body us-form" id="us-create-form" autocomplete="off" novalidate>
      <fieldset class="us-fieldset">
        <legend class="us-label">{{ t('us.create.question') }}</legend>
        <div class="us-choice-grid">
          <button type="button" class="us-choice" data-role-pick="user" aria-pressed="true">
            <span class="us-choice-title"><span class="us-radio" aria-hidden="true"></span>{{ t('us.role.member') }}</span>
            <span class="us-choice-text">{{ t('us.create.member_text') }}</span>
            <span class="us-point"><span class="us-pt-yes" aria-hidden="true">✓</span>{{ t('us.create.m1') }}</span>
            <span class="us-point"><span class="us-pt-yes" aria-hidden="true">✓</span>{{ t('us.create.m2') }}</span>
            <span class="us-point"><span class="us-pt-no" aria-hidden="true">–</span>{{ t('us.create.m3') }}</span>
          </button>
          <button type="button" class="us-choice" data-role-pick="admin" aria-pressed="false">
            <span class="us-choice-title"><span class="us-radio" aria-hidden="true"></span>{{ t('us.role.admin') }}</span>
            <span class="us-choice-text">{{ t('us.create.admin_text') }}</span>
            <span class="us-point"><span class="us-pt-yes" aria-hidden="true">✓</span>{{ t('us.create.a1') }}</span>
            <span class="us-point"><span class="us-pt-yes" aria-hidden="true">✓</span>{{ t('us.create.a2') }}</span>
            <span class="us-point"><span class="us-pt-warn" aria-hidden="true">!</span>{{ t('us.create.a3') }}</span>
          </button>
        </div>
      </fieldset>
      <div class="us-grid2">
        <label class="us-field"><span class="us-label">{{ t('us.username') }}</span><input type="text" class="form-input" id="us-c-username" maxlength="100" autocomplete="off" required><span class="us-hint">{{ t('us.username_hint') }}</span></label>
        <label class="us-field"><span class="us-label">{{ t('us.display_name') }}</span><input type="text" class="form-input" id="us-c-display" maxlength="100"></label>
        <label class="us-field us-span2"><span class="us-label">{{ t('us.email') }}</span><input type="email" class="form-input" id="us-c-email" maxlength="255" placeholder="{{ t('us.email_ph') }}"></label>
      </div>
      <div class="us-box" id="us-c-admin" hidden>
        <div class="us-box-head"><b>{{ t('us.create.pw_title') }}</b><span class="us-muted">{{ t('us.create.pw_required') }}</span></div>
        <div class="us-pwrow">
          <input type="text" class="form-input us-mono" id="us-c-password" aria-label="{{ t('us.pw.label') }}" maxlength="200" autocomplete="new-password" spellcheck="false">
          <button type="button" class="btn btn-sm us-btn-chip" id="us-c-pw-regen">{{ t('us.pw.regen') }}</button>
          <button type="button" class="btn btn-sm us-btn-chip" data-copy="#us-c-password">{{ t('common.copy') }}</button>
        </div>
        <label class="us-check"><input type="checkbox" id="us-c-mustchange" checked>{{ t('us.create.must_change') }}</label>
      </div>
      <div class="us-box" id="us-c-member">
        <label class="us-check us-check-top"><input type="checkbox" id="us-c-setup" checked><span><b>{{ t('us.create.setup_now') }}</b><span class="us-hint">{{ t('us.create.setup_now_text') }}</span></span></label>
        <label class="us-check us-check-top"><input type="checkbox" id="us-c-self"><span><b>{{ t('us.create.allow_self') }}</b> <span class="us-new">{{ t('us.new') }}</span><span class="us-hint">{{ t('us.create.allow_self_text') }}</span></span></label>
      </div>
      <div class="us-error" id="us-c-error" role="alert" hidden></div>
    </form>
    <div class="modal-foot"><button type="button" class="btn btn-ghost" data-us-close>{{ t('common.cancel') }}</button><button type="submit" form="us-create-form" class="btn btn-primary" id="us-c-save">{{ t('us.create.save_setup') }}</button></div>
  </div>
</div>

{# ── Edit profile: display name, e-mail, language (profile "Bearbeiten") ── #}
<div class="modal-overlay us-dlg" id="us-dlg-profile" style="display:none" data-us-dialog data-us-dirty>
  <div class="modal us-modal us-modal-sm" role="dialog" aria-modal="true" aria-labelledby="us-pf-title">
    <div class="modal-head"><h2 class="modal-title" id="us-pf-title">{{ t('up.edit') }}</h2>{{ closeBtn(t('common.close')) }}</div>
    <form class="modal-body us-modal-body us-form" id="us-pf-form" autocomplete="off" novalidate>
      <p class="us-muted" id="us-pf-text"></p>
      <div class="us-grid2">
        <label class="us-field"><span class="us-label">{{ t('us.display_name') }}</span><input type="text" class="form-input" id="us-pf-display" maxlength="100"></label>
        <label class="us-field"><span class="us-label">{{ t('us.pf.language') }}</span>
          <select class="form-input" id="us-pf-language">
            <option value="de">{{ t('us.pf.lang_de') }}</option>
            <option value="en">{{ t('us.pf.lang_en') }}</option>
          </select>
          <span class="us-hint">{{ t('us.pf.hint') }}</span>
        </label>
        <label class="us-field us-span2"><span class="us-label">{{ t('us.email') }}</span><input type="email" class="form-input" id="us-pf-email" maxlength="255" placeholder="{{ t('us.email_ph') }}"></label>
      </div>
      <div class="us-error" id="us-pf-error" role="alert" hidden></div>
    </form>
    <div class="modal-foot"><button type="button" class="btn btn-ghost" data-us-close>{{ t('common.cancel') }}</button><button type="submit" form="us-pf-form" class="btn btn-primary" id="us-pf-save">{{ t('common.save') }}</button></div>
  </div>
</div>

{# ── Access wizard (ZugangAssistent.dc.html) ─────────────────────── #}
<div class="modal-overlay us-dlg" id="us-dlg-wizard" style="display:none" data-us-dialog>
  <div class="modal us-modal us-modal-lg" role="dialog" aria-modal="true" aria-labelledby="us-wz-title">
    <div class="modal-head us-wz-head">
      <div class="us-modal-headtext"><h2 class="modal-title" id="us-wz-title">{{ t('us.wz.title') }}</h2><div class="us-muted" id="us-wz-for"></div></div>
      {{ closeBtn(t('common.close')) }}
    </div>
    <ol class="us-steps" aria-label="{{ t('us.wz.steps') }}" id="us-wz-steps">
      {% for n in [1, 2, 3, 4] %}
      <li><button type="button" class="us-step" data-step="{{ n }}"><span class="us-step-num" aria-hidden="true">{{ n }}</span><span class="us-step-label">{{ t('us.wz.step' + n) }}</span></button></li>
      {% endfor %}
    </ol>
    <div class="modal-body us-modal-body us-wz-body">
      <div class="us-wz-page" data-page="1">
        <div class="us-label">{{ t('us.wz.kind_q') }}</div>
        <div class="us-choice-grid">
          <button type="button" class="us-choice" data-kind="device" aria-pressed="true">
            <span class="us-choice-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2"/></svg>{{ t('us.wz.kind_device') }}</span>
            <span class="us-choice-text">{{ t('us.wz.kind_device_text') }}</span>
          </button>
          <button type="button" class="us-choice" data-kind="token" aria-pressed="false">
            <span class="us-choice-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M14 5l-4 14"/></svg>{{ t('us.wz.kind_api') }}</span>
            <span class="us-choice-text">{{ t('us.wz.kind_api_text') }}</span>
          </button>
        </div>
        <div class="us-grid2">
          <label class="us-field"><span class="us-label">{{ t('us.wz.name') }}</span><input type="text" class="form-input" id="us-wz-name" maxlength="100"><span class="us-hint" id="us-wz-name-hint"></span></label>
          <label class="us-field"><span class="us-label">{{ t('us.wz.owner') }}</span><select class="form-input" id="us-wz-owner"></select><span class="us-hint">{{ t('us.wz.owner_hint') }}</span></label>
        </div>
      </div>
      <div class="us-wz-page" data-page="2" hidden>
        <div class="us-label">{{ t('us.wz.rights_q') }}</div>
        <div class="us-presets" id="us-wz-presets"></div>
        <div class="us-scopes" id="us-wz-scopes" hidden></div>
      </div>
      <div class="us-wz-page" data-page="3" hidden>
        <div class="us-grid2">
          <label class="us-field"><span class="us-label">{{ t('us.wz.expiry') }}</span>
            <select class="form-input" id="us-wz-expiry">
              <option value="">{{ t('us.wz.exp_never') }}</option>
              <option value="30">{{ t('us.wz.exp_30') }}</option>
              <option value="90">{{ t('us.wz.exp_90') }}</option>
              <option value="365">{{ t('us.wz.exp_365') }}</option>
              <option value="date">{{ t('us.wz.exp_date') }}</option>
            </select>
          </label>
          <label class="us-field"><span class="us-label">{{ t('us.wz.peer') }}</span><select class="form-input" id="us-wz-peer"></select><span class="us-hint" id="us-wz-peer-hint"></span></label>
          <label class="us-field" id="us-wz-date-wrap" hidden><span class="us-label">{{ t('us.wz.exp_date_label') }}</span><input type="date" class="form-input" id="us-wz-date"></label>
        </div>
        <div class="us-box us-switchrow" id="us-wz-binding">
          <div class="us-switchrow-text"><b>{{ t('us.wz.binding') }}</b><div class="us-hint" id="us-wz-binding-text"></div></div>
          <button type="button" class="st-switch us-switch" role="switch" aria-checked="false" id="us-wz-binding-sw" aria-label="{{ t('us.wz.binding') }}"><span class="st-knob" aria-hidden="true"></span></button>
        </div>
        <details class="us-details" id="us-wz-st">
          <summary>{{ t('us.wz.st') }}</summary>
          <div class="us-hint">{{ t('us.wz.st_text') }}</div>
          <div class="us-st" data-st-editor="wz"></div>
        </details>
        <label class="us-check" id="us-wz-classic-wrap" hidden><input type="checkbox" id="us-wz-classic">{{ t('us.wz.classic') }}</label>
      </div>
      <div class="us-wz-page" data-page="4" hidden>
        <div class="us-code" id="us-wz-code">
          <div class="us-code-qr">
            <img id="us-wz-qr" alt="{{ t('us.wz.qr') }}" width="200" height="200">
            <div class="us-code-value" id="us-wz-code-value"></div>
            <div class="us-hint us-center" id="us-wz-countdown" aria-live="polite"></div>
            <button type="button" class="btn btn-sm us-btn-chip" id="us-wz-regen">{{ t('enrollment.regenerate') }}</button>
          </div>
          <div class="us-code-side">
            <div class="us-sum-title">{{ t('us.wz.summary') }}</div>
            <dl class="us-sum" id="us-wz-summary"></dl>
            <div class="us-muted us-small" id="us-wz-help"></div>
            <pre class="us-curl" id="us-wz-curl" hidden></pre>
            <button type="button" class="btn btn-sm us-btn-chip" id="us-wz-curl-copy" data-copy="#us-wz-curl" hidden>{{ t('common.copy') }}</button>
          </div>
        </div>
        <div class="us-keybox" id="us-wz-key" hidden>
          <div class="us-warnbox">{{ t('us.wz.key_warning') }}</div>
          <div class="us-pwrow"><code class="us-key" id="us-wz-key-value"></code><button type="button" class="btn btn-sm btn-primary" data-copy="#us-wz-key-value">{{ t('common.copy') }}</button></div>
          <dl class="us-sum" id="us-wz-summary-key"></dl>
        </div>
      </div>
      <div class="us-error" id="us-wz-error" role="alert" hidden></div>
    </div>
    <div class="modal-foot us-wz-foot">
      <button type="button" class="btn btn-ghost" id="us-wz-back">{{ t('us.back') }}</button>
      <span class="us-grow"></span>
      <button type="button" class="btn btn-ghost" data-us-close id="us-wz-cancel">{{ t('common.cancel') }}</button>
      <button type="button" class="btn btn-primary" id="us-wz-next">{{ t('common.next') }}</button>
    </div>
  </div>
</div>

{# ── Edit access (ZugangBearbeiten.dc.html) ──────────────────────── #}
<div class="modal-overlay us-dlg" id="us-dlg-edit" style="display:none" data-us-dialog data-us-dirty>
  <div class="modal us-modal us-modal-md" role="dialog" aria-modal="true" aria-labelledby="us-ed-title">
    <div class="modal-head">
      <span class="us-ed-ic" id="us-ed-ic" aria-hidden="true"></span>
      <div class="us-modal-headtext"><h2 class="modal-title" id="us-ed-title"></h2><div class="us-muted" id="us-ed-sub"></div></div>
      {{ closeBtn(t('common.close')) }}
    </div>
    <form class="modal-body us-modal-body us-form" id="us-ed-form" novalidate>
      <div class="us-grid2">
        <label class="us-field"><span class="us-label">{{ t('us.wz.name') }}</span><input type="text" class="form-input" id="us-ed-name" maxlength="100" required></label>
        <label class="us-field"><span class="us-label">{{ t('us.wz.expiry') }}</span><select class="form-input" id="us-ed-expiry"></select></label>
        <label class="us-field" id="us-ed-date-wrap" hidden><span class="us-label">{{ t('us.wz.exp_date_label') }}</span><input type="date" class="form-input" id="us-ed-date"></label>
      </div>
      {# Portal: who uses this device ("Nur der Besitzer" / "Mehrere Personen"), devices only #}
      <fieldset class="us-usage" id="us-ed-usage" hidden>
        <legend class="us-label">{{ t('us.usage.title') }}</legend>
        <div class="us-usage-modes" id="us-ed-usage-modes"></div>
        <div class="us-usage-detail" id="us-ed-usage-detail"></div>
      </fieldset>
      <div>
        <div class="us-label" id="us-ed-rights-q"></div>
        <div class="us-rights" id="us-ed-rights"></div>
