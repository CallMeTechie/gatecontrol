{# New password + confirmation (invitation page, password change at login). #}
        <div class="form-group">
          <label class="form-label" for="password">{{ t('pwchange.new') }}</label>
          <div class="au-pw">
            <input class="form-input" type="password" id="password" name="password" autocomplete="new-password" required minlength="{{ minLength }}" maxlength="200" aria-describedby="pw-rule">
            <button type="button" class="au-pw-toggle" data-pw-toggle="password" aria-label="{{ t('auth.show_password') }}" title="{{ t('auth.show_password') }}" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <small class="form-hint" id="pw-rule">{{ t('pwchange.rule', { min: minLength }) }}</small>
        </div>
        <div class="form-group">
          <label class="form-label" for="password_confirm">{{ t('pwchange.confirm') }}</label>
          <input class="form-input" type="password" id="password_confirm" name="password_confirm" autocomplete="new-password" required minlength="{{ minLength }}" maxlength="200">
        </div>
