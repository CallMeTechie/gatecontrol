{# Mobile navigation (docs/feature-release-b.md §8): the four most used
   destinations of the groups plus "Mehr", which opens the grouped sidebar
   drawer (#sidebar) with everything else. #}
<nav class="bottom-nav">
  <div class="bottom-nav-inner">
    <a href="/dashboard" class="bn-item {{ 'active' if activeNav == 'dashboard' }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
      {{ t('nav.dashboard') }}
    </a>
    <a href="/routes" class="bn-item {{ 'active' if activeNav == 'routes' }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
      {{ t('nav.routes') | replace(' / Routen', '') | replace(' / Routes', '') }}
    </a>
    <a href="/peers" class="bn-item {{ 'active' if activeNav == 'peers' }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="17" cy="7" r="3"/><circle cx="7" cy="17" r="3"/><path d="M14 10l-4 4"/><circle cx="7" cy="7" r="3"/><circle cx="17" cy="17" r="3"/></svg>
      Peers
    </a>
    <a href="/security" class="bn-item {{ 'active' if activeNav in ['security', 'certificates', 'waf', 'users'] }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
      {{ t('nav.group_security') }}
    </a>
    <button type="button" class="bn-item bn-more {{ 'active' if activeNav not in ['dashboard', 'routes', 'peers', 'security', 'certificates', 'waf', 'users'] }}" id="bn-more" aria-controls="sidebar" aria-haspopup="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
      {{ t('nav.more') }}
    </button>
  </div>
</nav>
