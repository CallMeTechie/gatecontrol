<!doctype html>
<html lang="{{ language | default('de') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{{ t('portal.brand') }} · {{ appName }}</title>
{#- no-FOUC: set the theme BEFORE first paint (blocking, in <head>).
    Reads from localStorage; falls back to prefers-color-scheme. -#}
<script nonce="{{ cspNonce }}">
  (function(){
    try{
      var s = localStorage.getItem('gc-portal-theme');
      var t = s || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    }catch(e){ document.documentElement.setAttribute('data-theme','dark'); }
  })();
</script>
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/bricolage-grotesque-latin.woff2">
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/jetbrains-mono-latin.woff2">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/portal.css?v={{ appVersion }}">
{#- Every portal.* string for portal.js (one JSON island, `<` escaped). -#}
<script type="application/json" id="portal-i18n" nonce="{{ cspNonce }}">{{ portalI18n | safe }}</script>
<script type="application/json" id="portal-ctx" nonce="{{ cspNonce }}">{{ portalCtx | safe }}</script>
<script src="/js/portal.js?v={{ appVersion }}" defer></script>
{% if tabs.plugins %}<script src="/js/plugin-bridge.js?v={{ appVersion }}" defer></script>{% endif %}
</head>
<body class="pt-body">
<a class="pt-skip" href="#pt-main">{{ t('portal.skip') }}</a>

{%- set ICONS = {
  start: 'M3 11.5L12 4l9 7.5M5.5 10v10h13V10',
  dienste: 'M4 6h16M4 12h16M4 18h10',
  zuhause: 'M9 21V12h6v9M3 10l9-7 9 7v11H3z',
  fahrzeug: 'M5 16l1.5-5h11L19 16M4 16h16v3H4zM7 19v2M17 19v2',
  netzwerk: 'M3 17l5-5 4 4 8-8',
  geraete: 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2'
} %}
{#- A plugin's section in a GateControl tab (docs/plugins.md "Portal"): its own sandboxed frame. -#}
{%- macro pluginSection(sec) %}
      <section class="pt-plugin-section" id="pt-sec-{{ sec.key }}" data-area="{{ sec.key }}" aria-label="{{ sec.title }}">
        <iframe class="pt-plugin-frame" title="{{ sec.title }}" src="/portal/plugins/{{ sec.plugin }}/frame?section={{ sec.id }}" sandbox="allow-scripts allow-forms" referrerpolicy="no-referrer" loading="lazy"
          data-plugin-frame data-plugin-id="{{ sec.plugin }}" data-plugin-api="/api/v1/portal/plugins/{{ sec.plugin }}/api/" data-plugin-pages="[]"></iframe>
      </section>
{%- endmacro %}
{%- set TABS = [
  ['start', 'portal.tab.start', true],
  ['dienste', 'portal.tab.services', tabs.services],
  ['zuhause', 'portal.tab.home', tabs.home],
  ['fahrzeug', 'portal.tab.car', tabs.car],
  ['netzwerk', 'portal.tab.net', tabs.net],
  ['geraete', 'portal.tab.devices', tabs.devices]
] %}

<header class="pt-header">
  <div class="pt-brand">
    <span class="pt-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg></span>
    {{ t('portal.brand') }}
  </div>

  <nav class="pt-tabs" aria-label="{{ t('portal.tabs_label') }}">
    <div class="pt-tablist" role="tablist" aria-label="{{ t('portal.tabs_label') }}">
    {%- for tab in TABS %}{% if tab[2] %}
      <a class="pt-tab" role="tab" id="tab-{{ tab[0] }}" href="#{{ tab[0] }}" data-tab="{{ tab[0] }}" aria-controls="panel-{{ tab[0] }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ ICONS[tab[0]] }}"/></svg><span>{{ t(tab[1]) }}</span></a>
    {%- endif %}{% endfor %}
    {#- Plugin tabs (docs/plugins.md): running plugins with the portal permission. #}
    {%- for pt in pluginTabs %}
      <a class="pt-tab" role="tab" id="tab-{{ pt.key }}" href="#{{ pt.key }}" data-tab="{{ pt.key }}" aria-controls="panel-{{ pt.key }}" aria-selected="false" tabindex="-1"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ pt.icon }}"/></svg><span>{{ pt.label }}</span></a>
    {%- endfor %}
    </div>
  </nav>

  <div class="pt-head-end">
    {% if tabs.notify %}
    {#- Notification center (docs/feature-notification-center.md "Portal"):
        the bell opens the inbox (#mitteilungen); portal.js keeps the count. #}
    <a class="pt-iconbtn pt-bell" id="pt-bell" href="#mitteilungen" data-goto="mitteilungen" title="{{ t('portal.notify.inbox') }}" aria-label="{{ t('portal.notify.inbox') }}">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
      <span class="pt-bell-count" id="pt-bell-count" aria-hidden="true" hidden></span>
    </a>
    {% endif %}
    <button type="button" class="pt-iconbtn" id="themeBtn" title="{{ t('portal.theme_toggle') }}" aria-label="{{ t('portal.theme_toggle') }}">
      <svg class="ic-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="ic-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    </button>

    {% if viewer.kind == 'person' %}
    <div class="pt-user" data-viewer="person" data-via="{{ viewer.via }}">
      <span class="pt-user-text">
        <span class="pt-user-name">{{ viewer.name }}</span>
        <span class="pt-user-sub">
          {%- if viewer.via == 'link' or viewer.via == 'device' -%}
            {{ t('portal.viewer.auto_via', { device: viewer.deviceName }) if viewer.deviceName else t('portal.viewer.auto') }}
          {%- elif viewer.via == 'pin' -%}
            {{ t('portal.viewer.picked_on', { device: viewer.deviceName }) if viewer.deviceName else t('portal.viewer.picked') }}
          {%- else -%}
            {{ t('portal.viewer.signed_in') }}
          {%- endif -%}
        </span>
      </span>
      <span class="pt-avatar" aria-hidden="true">{{ viewer.initials }}</span>
    </div>
    {% elif viewer.kind == 'anonymous' %}
    <div class="pt-user is-anon" data-viewer="anonymous">
      <span class="pt-user-text">
        <span class="pt-user-name">{{ t('portal.viewer.anonymous') }}</span>
        <span class="pt-user-sub">{{ t('portal.viewer.anonymous_sub') }}</span>
      </span>
      <span class="pt-avatar" aria-hidden="true">?</span>
    </div>
    {% endif %}

    {% if sharedDevice and (portalSession or viewer.kind == 'anonymous') %}
    <form class="pt-inline" method="POST" action="/portal/switch">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="pt-btn pt-btn-sm" id="pt-switch">{{ t('portal.viewer.switch') if portalSession else t('portal.viewer.pick') }}</button>
    </form>
    {% elif viewer.kind == 'anonymous' %}
    <form class="pt-inline" method="POST" action="/portal/identify">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="pt-btn pt-btn-sm" id="pt-identify">{{ t('portal.viewer.leave_anonymous') }}</button>
    </form>
    {% endif %}

    {% if accountUrl %}
    <a class="pt-iconbtn" id="pt-account" href="{{ accountUrl }}" rel="noopener" title="{{ t('portal.account') }}" aria-label="{{ t('portal.account') }}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></a>
    {% endif %}
    {% if loggedIn %}
    <form class="pt-inline" action="/logout" method="POST">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="pt-iconbtn" title="{{ t('portal.logout') }}" aria-label="{{ t('portal.logout') }}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </form>
    {% elif viewer.kind != 'person' or viewer.via == 'device' %}
    <a href="/login?returnTo=/portal" class="pt-iconbtn" id="pt-login" title="{{ t('portal.login') }}" aria-label="{{ t('portal.login') }}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    {% endif %}
  </div>
</header>

<main class="pt-main" id="pt-main">
  {% if note == 'link_invalid' %}
  <div class="pt-note" role="status" id="pt-note">{{ t('portal.note.link_invalid') }}</div>
  {% endif %}

  {# ═══ Start ═══════════════════════════════════════════════════════════ #}
  <section class="pt-panel" id="panel-start" role="tabpanel" aria-labelledby="tab-start" tabindex="0" data-panel="start">
    <div class="pt-hero">
      <div class="pt-hero-text">
        <h1 class="pt-h1" id="pt-greeting">
          {%- if viewer.kind == 'person' %}{{ t('portal.greet.hello', { name: viewer.first }) }}{% else %}{{ t('portal.greet.guest') }}{% endif -%}
        </h1>
        <p class="pt-lead">{{ t('portal.lead') if viewer.kind == 'person' else (t('portal.lead_anonymous') if viewer.kind == 'anonymous' else t('portal.lead_guest')) }}</p>
      </div>
      <label class="pt-search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input type="search" id="pt-search" aria-label="{{ t('portal.search') }}" placeholder="{{ t('portal.search') }}" autocomplete="off">
      </label>
    </div>
    <div class="pt-results" id="pt-results" hidden aria-live="polite"></div>

    {% if tabs.device %}
    <div class="pt-strip" id="pt-strip" data-area="device">
      <span class="pt-strip-state" id="pt-strip-state"><span class="pt-dot" aria-hidden="true"></span><span id="pt-strip-state-text">{{ t('portal.strip.checking') }}</span></span>
      <span><span class="pt-muted">{{ t('portal.strip.device') }}</span> <b id="pt-strip-device">{{ deviceName }}</b></span>
      <span><span class="pt-muted">{{ t('portal.device.vpn_address') }}</span> <b class="pt-mono" id="pt-strip-ip">–</b></span>
      <span><span class="pt-muted">{{ t('portal.device.last_handshake') }}</span> <b id="pt-strip-hs">–</b></span>
      {% if tabs.traffic %}<span id="pt-strip-today-wrap" hidden><span class="pt-muted">{{ t('portal.strip.today') }}</span> <b id="pt-strip-today">–</b></span>{% endif %}
      {% if tabs.pihole %}<span id="pt-strip-pi-wrap" hidden><span class="pt-muted">{{ t('portal.strip.adblock') }}</span> <b id="pt-strip-pi">–</b></span>{% endif %}
    </div>
    {% endif %}

    <div class="pt-grid">
      {% if tabs.services %}
      <section class="pt-card pt-span" data-area="services" aria-labelledby="pt-c-services">
        <div class="pt-card-head"><h2 class="pt-h2" id="pt-c-services">{{ t('portal.tab.services') }}</h2><span class="pt-sub" id="pt-services-sub" hidden>{{ t('portal.services.recent') }}</span><a class="pt-link" href="#dienste" data-goto="dienste" id="pt-services-all">{{ t('portal.services.all_plain') }}</a></div>
        <div class="pt-tiles" id="pt-start-services"><div class="pt-empty">{{ t('portal.loading') }}</div></div>
      </section>
      {% endif %}

      {#- "Zuhause" / "Fahrzeug" hold plugin sections only (docs/plugins.md
          "Portal"): their Start cards are shown once a plugin sends tiles. #}
      {% if tabs.home %}
      <section class="pt-card" data-area="home" id="pt-start-card-zuhause" aria-labelledby="pt-c-home" hidden>
        <div class="pt-card-head"><h2 class="pt-h2" id="pt-c-home">{{ t('portal.tab.home') }}</h2><a class="pt-link" href="#zuhause" data-goto="zuhause">{{ t('portal.open') }}</a></div>
        <div class="pt-plg-tiles" id="pt-start-tiles-zuhause"></div>
      </section>
      {% endif %}

      {% if tabs.car %}
      <section class="pt-card" data-area="car" id="pt-start-card-fahrzeug" aria-labelledby="pt-c-car" hidden>
        <div class="pt-card-head"><h2 class="pt-h2" id="pt-c-car">{{ t('portal.tab.car') }}</h2><a class="pt-link" href="#fahrzeug" data-goto="fahrzeug">{{ t('portal.open') }}</a></div>
        <div class="pt-plg-tiles" id="pt-start-tiles-fahrzeug"></div>
      </section>
      {% endif %}

      {% if tabs.net %}
      <section class="pt-card" data-area="net" aria-labelledby="pt-c-net">
        <div class="pt-card-head"><h2 class="pt-h2" id="pt-c-net">{{ t('portal.net.title') }}</h2><a class="pt-link" href="#netzwerk" data-goto="netzwerk">{{ t('portal.open') }}</a></div>
        <div class="pt-card-body pt-net-mini" id="pt-start-net">
          {% if tabs.traffic %}
          <div class="pt-net-bars">
            <div class="pt-mini-label">{{ t('portal.net.week') }}</div>
            <div class="pt-bars" id="pt-start-bars" aria-hidden="true"></div>
            <div class="pt-bars-axis" id="pt-start-bars-axis" aria-hidden="true"></div>
            <div class="pt-sr" id="pt-start-bars-sr"></div>
          </div>
          {% endif %}
          {% if tabs.pihole %}
          <div class="pt-net-donut" id="pt-start-pi" hidden>
            <div class="pt-donut" id="pt-start-donut" aria-hidden="true"><span id="pt-start-donut-v">–</span></div>
            <div class="pt-mini-label">{{ t('portal.net.blocked') }}</div>
          </div>
          {% endif %}
        </div>
      </section>
      {% endif %}

      {#- Start cards of plugin tabs: shown once the plugin sends tiles. #}
      {%- for pt in pluginTabs %}
      <section class="pt-card" data-area="start-{{ pt.key }}" id="pt-start-card-{{ pt.key }}" aria-labelledby="pt-c-{{ pt.key }}" hidden>
        <div class="pt-card-head"><h2 class="pt-h2" id="pt-c-{{ pt.key }}">{{ pt.label }}</h2><a class="pt-link" href="#{{ pt.key }}" data-goto="{{ pt.key }}">{{ t('portal.open') }}</a></div>
        <div class="pt-plg-tiles" id="pt-start-tiles-{{ pt.key }}"></div>
      </section>
      {%- endfor %}

      {% if tabs.devices %}
      <section class="pt-card" data-area="devices" aria-labelledby="pt-c-devices">
        <div class="pt-card-head"><h2 class="pt-h2" id="pt-c-devices">{{ t('portal.tab.devices') }}</h2><a class="pt-link" href="#geraete" data-goto="geraete">{{ t('portal.devices.manage') }}</a></div>
        <ul class="pt-devlist pt-devlist-mini" id="pt-start-devices"><li class="pt-empty">{{ t('portal.loading') }}</li></ul>
      </section>
      {% endif %}
    </div>
  </section>

  {# ═══ Dienste ═════════════════════════════════════════════════════════ #}
  {% if tabs.services %}
  <section class="pt-panel" id="panel-dienste" role="tabpanel" aria-labelledby="tab-dienste" tabindex="0" data-panel="dienste" hidden>
    <h1 class="pt-h1 pt-h1-sm">{{ t('portal.tab.services') }}</h1>
    <p class="pt-lead">{{ t('portal.services.lead') if viewer.kind == 'person' else t('portal.services.lead_all') }}</p>
    <div class="pt-svc-grid" id="pt-services"><div class="pt-empty">{{ t('portal.loading') }}</div></div>
    <div id="pt-rdp-wrap" hidden>
      <h2 class="pt-h2 pt-h2-gap">{{ t('portal.services.rdp') }}</h2>
      <div class="pt-rdp-list" id="pt-rdp"></div>
    </div>
  </section>
  {% endif %}

  {# ═══ Zuhause ═════════════════════════════════════════════════════════ #}
  {% if tabs.home %}
  <section class="pt-panel" id="panel-zuhause" role="tabpanel" aria-labelledby="tab-zuhause" tabindex="0" data-panel="zuhause" hidden>
    <h1 class="pt-h1 pt-h1-sm">{{ t('portal.tab.home') }}</h1>
    <p class="pt-lead">{{ t('portal.home.lead') }}</p>
    <div class="pt-grid pt-grid-wide">
      {%- for sec in pluginSections.home %}{{ pluginSection(sec) }}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# ═══ Fahrzeug ════════════════════════════════════════════════════════ #}
  {% if tabs.car %}
  <section class="pt-panel" id="panel-fahrzeug" role="tabpanel" aria-labelledby="tab-fahrzeug" tabindex="0" data-panel="fahrzeug" hidden>
    <h1 class="pt-h1 pt-h1-sm">{{ t('portal.tab.car') }}</h1>
    {%- for sec in pluginSections.car %}{{ pluginSection(sec) }}{% endfor %}
  </section>
  {% endif %}

  {# ═══ Netzwerk ════════════════════════════════════════════════════════ #}
  {% if tabs.net %}
  <section class="pt-panel" id="panel-netzwerk" role="tabpanel" aria-labelledby="tab-netzwerk" tabindex="0" data-panel="netzwerk" hidden>
    <h1 class="pt-h1 pt-h1-sm">{{ t('portal.net.title') }}</h1>
    <div class="pt-grid pt-grid-wide">
      {% if tabs.traffic %}
      <section class="pt-card pt-pad pt-span" data-area="traffic" aria-labelledby="pt-c-traffic">
        <div class="pt-card-row">
          <h2 class="pt-h2" id="pt-c-traffic">{{ t('portal.traffic.title') }}</h2>
          <span class="pt-legend"><i class="is-rx" aria-hidden="true"></i>{{ t('portal.traffic.legend_rx') }}<i class="is-tx" aria-hidden="true"></i>{{ t('portal.traffic.legend_tx') }}</span>
          <div class="pt-seg" role="group" aria-label="{{ t('portal.traffic.range') }}" id="pt-traffic-seg">
            <button type="button" data-range="24h" aria-pressed="false">{{ t('portal.traffic.range_24h') }}</button>
            <button type="button" data-range="7d" aria-pressed="true">{{ t('portal.traffic.range_7d') }}</button>
            <button type="button" data-range="30d" aria-pressed="false">{{ t('portal.traffic.range_30d') }}</button>
          </div>
        </div>
        <div class="pt-chart" id="pt-chart" aria-hidden="true"></div>
        <div class="pt-sr" id="pt-chart-sr" aria-live="polite"></div>
        <div class="pt-kv-row">
          <span><span class="pt-muted">{{ t('portal.traffic.total') }}</span> <b id="pt-t-total">–</b></span>
          <span><span class="pt-muted">{{ t('portal.traffic.avg_day') }}</span> <b id="pt-t-avg">–</b></span>
          <span><span class="pt-muted">{{ t('portal.traffic.peak') }}</span> <b id="pt-t-peak">–</b></span>
        </div>
      </section>
      {% endif %}

      {% if tabs.device %}
      <section class="pt-card pt-pad" data-area="device" aria-labelledby="pt-c-device">
        <h2 class="pt-h2 pt-h2-gap" id="pt-c-device">{{ t('portal.device.this') }}</h2>
        <dl class="pt-dl" id="pt-device">
          <dt>{{ t('portal.device.status') }}</dt><dd id="pt-d-status">–</dd>
          <dt>{{ t('portal.device.vpn_address') }}</dt><dd class="pt-mono" id="pt-d-ip">–</dd>
          <dt>{{ t('portal.device.dns') }}</dt><dd class="pt-mono" id="pt-d-dns">–</dd>
          <dt>{{ t('portal.device.last_handshake') }}</dt><dd id="pt-d-hs">–</dd>
          <dt>{{ t('portal.device.transfer') }}</dt><dd id="pt-d-xfer">–</dd>
        </dl>
      </section>
      {% endif %}

      {% if tabs.pihole %}
      <section class="pt-card pt-pad" data-area="pihole" id="pt-pi-card" aria-labelledby="pt-c-pi">
        <div class="pt-card-row">
          <h2 class="pt-h2" id="pt-c-pi">{{ t('portal.pihole.title') }}</h2>
          <div class="pt-seg" role="group" aria-label="{{ t('portal.pihole.scope') }}" id="pt-pi-seg">
            <button type="button" data-scope="device" aria-pressed="true">{{ t('portal.pihole.scope_device') }}</button>
            <button type="button" data-scope="owner" aria-pressed="false">{{ t('portal.pihole.scope_owner') }}</button>
            <button type="button" data-scope="household" aria-pressed="false">{{ t('portal.pihole.scope_household') }}</button>
          </div>
        </div>
        <div class="pt-pi-body" id="pt-pi-body">
          <div class="pt-donut pt-donut-lg" id="pt-pi-donut" aria-hidden="true"><span id="pt-pi-pct">–</span></div>
          <dl class="pt-dl pt-dl-auto">
            <dt>{{ t('portal.pihole.total') }}</dt><dd id="pt-pi-total">–</dd>
            <dt>{{ t('portal.pihole.blocked') }}</dt><dd id="pt-pi-blocked">–</dd>
            <dt id="pt-pi-allowed-l">{{ t('portal.pihole.allowed') }}</dt><dd id="pt-pi-allowed">–</dd>
            <dt id="pt-pi-extra-l" hidden></dt><dd id="pt-pi-extra" hidden></dd>
          </dl>
        </div>
        <p class="pt-foot" id="pt-pi-foot">{{ t('portal.pihole.foot') }}</p>
        <div class="pt-msg" id="pt-pi-msg" role="status" hidden></div>
      </section>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ═══ Meine Geräte ════════════════════════════════════════════════════ #}
  {% if tabs.devices %}
  <section class="pt-panel" id="panel-geraete" role="tabpanel" aria-labelledby="tab-geraete" tabindex="0" data-panel="geraete" hidden>
    <div class="pt-hero">
      <div class="pt-hero-text">
        <h1 class="pt-h1 pt-h1-sm">{{ t('portal.tab.devices') }}</h1>
        <p class="pt-lead">{{ t('portal.devices.lead') }}</p>
      </div>
      <button type="button" class="pt-btn pt-btn-primary" id="pt-enroll" hidden>{{ t('portal.devices.new') }}</button>
    </div>
    <section class="pt-card pt-narrow" aria-label="{{ t('portal.tab.devices') }}">
      <ul class="pt-devlist" id="pt-devices"><li class="pt-empty">{{ t('portal.loading') }}</li></ul>
    </section>
    <p class="pt-foot" id="pt-devices-foot"></p>
    {% if tabs.notify %}
    <a class="pt-card pt-narrow pt-navcard" href="#benachrichtigungen" data-goto="benachrichtigungen" id="pt-devices-notify">
      <span class="pt-navcard-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></span>
      <span class="pt-grow"><b>{{ t('portal.notify.title') }}</b><span class="pt-small pt-muted pt-block">{{ t('portal.notify.navcard') }}</span></span>
      <span class="pt-navcard-go" aria-hidden="true">›</span>
    </a>
    {% endif %}
  </section>
  {% endif %}

  {#- ═══ Mitteilungen + Meine Benachrichtigungen (notification center) ═══
      Pages without a tab of their own: the bell, the card in "Meine Geräte"
      and links lead here; URL-addressable (#mitteilungen,
      #benachrichtigungen) like the tabs. Data: /api/v1/portal/me/notify/*. #}
  {% if tabs.notify %}
  <section class="pt-panel" id="panel-mitteilungen" role="region" aria-labelledby="pt-h-inbox" tabindex="0" data-panel="mitteilungen" data-extra hidden>
    <div class="pt-hero">
      <div class="pt-hero-text">
        <h1 class="pt-h1 pt-h1-sm" id="pt-h-inbox">{{ t('portal.notify.inbox') }}</h1>
        <p class="pt-lead">{{ t('portal.notify.inbox_lead') }}</p>
      </div>
      <div class="pt-hero-actions">
        <button type="button" class="pt-btn" id="pt-inbox-readall" disabled>{{ t('portal.notify.read_all') }}</button>
        <a class="pt-btn" href="#benachrichtigungen" data-goto="benachrichtigungen" id="pt-inbox-prefs">{{ t('portal.notify.settings') }}</a>
      </div>
    </div>
    <section class="pt-card pt-narrow" aria-labelledby="pt-h-inbox">
      <ul class="pt-inbox" id="pt-inbox" aria-live="polite"><li class="pt-empty">{{ t('portal.loading') }}</li></ul>
      <div class="pt-inbox-more" id="pt-inbox-more-wrap" hidden><button type="button" class="pt-btn pt-btn-sm" id="pt-inbox-more">{{ t('portal.notify.older') }}</button></div>
    </section>
  </section>

  <section class="pt-panel" id="panel-benachrichtigungen" role="region" aria-labelledby="pt-h-prefs" tabindex="0" data-panel="benachrichtigungen" data-extra hidden>
    <h1 class="pt-h1 pt-h1-sm" id="pt-h-prefs">{{ t('portal.notify.title') }}</h1>
    <p class="pt-lead">{{ t('portal.notify.lead') }}</p>
    <div class="pt-msg" id="pt-np-msg" role="status" hidden></div>
    <div class="pt-np-grid" id="pt-np-grid">
      <section class="pt-card pt-pad" aria-labelledby="pt-h-topics">
        <h2 class="pt-h2" id="pt-h-topics">{{ t('portal.notify.topics') }}</h2>
        <p class="pt-card-lead">{{ t('portal.notify.topics_lead') }}</p>
        <ul class="pt-topics" id="pt-np-topics"><li class="pt-empty">{{ t('portal.loading') }}</li></ul>
      </section>
      <div class="pt-np-side">
        <section class="pt-card pt-pad" aria-labelledby="pt-h-receive">
          <h2 class="pt-h2 pt-h2-gap" id="pt-h-receive">{{ t('portal.notify.receive') }}</h2>
          <ul class="pt-recv" id="pt-np-devices"><li class="pt-empty">{{ t('portal.loading') }}</li></ul>
        </section>
        <section class="pt-card pt-pad" aria-labelledby="pt-h-quiet">
          <div class="pt-card-row pt-row-tight">
            <h2 class="pt-h2" id="pt-h-quiet">{{ t('portal.notify.quiet') }}</h2>
            <label class="pt-switch-wrap"><span class="pt-sr">{{ t('portal.notify.quiet_on') }}</span><input type="checkbox" role="switch" class="pt-switch" id="pt-np-quiet-on"></label>
          </div>
          <div class="pt-quiet" id="pt-np-quiet-fields">
            <label class="pt-time">{{ t('portal.notify.quiet_from') }} <input type="time" id="pt-np-from" value="22:00" required></label>
            <label class="pt-time">{{ t('portal.notify.quiet_to') }} <input type="time" id="pt-np-to" value="07:00" required></label>
          </div>
          <p class="pt-small pt-muted pt-np-tz" id="pt-np-tz"></p>
          <label class="pt-switch-row">
            <span class="pt-grow"><b>{{ t('portal.notify.critical') }}</b><span class="pt-small pt-muted pt-block" id="pt-np-critical-hint">{{ t('portal.notify.critical_hint') }}</span></span>
            <input type="checkbox" role="switch" class="pt-switch" id="pt-np-critical" aria-describedby="pt-np-critical-hint">
          </label>
          <p class="pt-foot">{{ t('portal.notify.quiet_foot') }}</p>
        </section>
        <section class="pt-card pt-pad" aria-labelledby="pt-h-recent">
          <div class="pt-card-row pt-row-tight">
            <h2 class="pt-h2" id="pt-h-recent">{{ t('portal.notify.recent') }}</h2>
            <button type="button" class="pt-linkbtn pt-push" id="pt-np-readall" hidden>{{ t('portal.notify.read_all') }}</button>
          </div>
          <ul class="pt-inbox pt-inbox-mini" id="pt-np-recent"><li class="pt-empty">{{ t('portal.loading') }}</li></ul>
          <a class="pt-link pt-link-left" href="#mitteilungen" data-goto="mitteilungen">{{ t('portal.notify.all') }}</a>
        </section>
      </div>
    </div>
  </section>
  {% endif %}
  {#- Plugin tab panels: the plugin's content in a sandboxed frame (opaque
      origin; public/js/plugin-bridge.js forwards its API calls). #}
  {%- for pt in pluginTabs %}
  <section class="pt-panel" id="panel-{{ pt.key }}" role="tabpanel" aria-labelledby="tab-{{ pt.key }}" tabindex="0" data-panel="{{ pt.key }}" hidden>
    <h1 class="pt-h1 pt-h1-sm">{{ pt.label }}</h1>
    <iframe class="pt-plugin-frame" title="{{ pt.label }}" src="/portal/plugins/{{ pt.id }}/frame" sandbox="allow-scripts allow-forms" referrerpolicy="no-referrer" loading="lazy"
      data-plugin-frame data-plugin-id="{{ pt.id }}" data-plugin-api="/api/v1/portal/plugins/{{ pt.id }}/api/" data-plugin-pages="[]"></iframe>
  </section>
  {%- endfor %}
</main>

<footer class="pt-footer"><span>{{ appName }}</span></footer>
</body>
</html>
